                                        </Canvas>

                                        <!-- DIGIT 2 -->
                                        <Canvas Width="28" Height="50">
                                            <Rectangle x:Name="RetroDigit2A" Canvas.Left="4" Canvas.Top="0" Width="20" Height="5" Fill="#19231B" RadiusX="2" RadiusY="2"/>
                                            <Rectangle x:Name="RetroDigit2B" Canvas.Left="23" Canvas.Top="4" Width="5" Height="19" Fill="#19231B" RadiusX="2" RadiusY="2"/>
                                            <Rectangle x:Name="RetroDigit2C" Canvas.Left="23" Canvas.Top="25" Width="5" Height="19" Fill="#19231B" RadiusX="2" RadiusY="2"/>
                                            <Rectangle x:Name="RetroDigit2D" Canvas.Left="4" Canvas.Top="44" Width="20" Height="5" Fill="#19231B" RadiusX="2" RadiusY="2"/>
                                            <Rectangle x:Name="RetroDigit2E" Canvas.Left="0" Canvas.Top="25" Width="5" Height="19" Fill="#19231B" RadiusX="2" RadiusY="2"/>
