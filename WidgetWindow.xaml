                                        <Path Data="M 72,12 L 80,4 M 73,4 L 80,4 L 80,11" Stroke="#19231B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
