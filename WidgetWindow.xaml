                            <Path Data="M 250,195 Q 280,180 310,195 Q 340,180 370,195 L 385,190 L 385,215 L 250,215 Z" Fill="#06B6D4" Opacity="0.55"/>
                            <Path Data="M 265,202 Q 295,188 325,202 Q 355,188 385,202 L 385,215 L 265,215 Z" Fill="#0284C7" Opacity="0.75"/>
                        </Canvas>

                        <!-- 8. Mùa Đông: Thạch nhũ băng giá, Đại tinh thể tuyết 3D & Bụi tuyết kim cương -->
                        <Canvas x:Name="SeasonalWinterArt" Visibility="Collapsed">
                            <!-- Quầng lạnh băng giá -->
                            <Ellipse Width="180" Height="180" Canvas.Left="230" Canvas.Top="-70" Fill="#1A3B82F6"/>
                            <Ellipse Width="105" Height="105" Canvas.Left="270" Canvas.Top="-25" Fill="#2560A5FA"/>

