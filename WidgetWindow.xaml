                                        <Rectangle Canvas.Left="12" Canvas.Top="14" Width="44" Height="22" Fill="#19231B" RadiusX="6" RadiusY="6"/>
                                        <Ellipse Canvas.Left="20" Canvas.Top="4" Width="22" Height="22" Fill="#19231B"/>
                                        <Ellipse Canvas.Left="8" Canvas.Top="12" Width="18" Height="18" Fill="#19231B"/>
