                            <Path Data="M 330,92 L 325,87 M 330,92 L 335,87 M 330,128 L 325,133 M 330,128 L 335,133 M 315,101 L 312,96 M 315,101 L 313,107 M 345,119 L 347,113 M 345,119 L 348,124 M 315,119 L 313,113 M 315,119 L 312,124 M 345,101 L 347,107 M 345,101 L 348,96" Stroke="#E0F2FE" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- Bụi sao băng tuyết kim cương 4 cánh -->
                            <Path Data="M 265,48 L 267,53 L 272,55 L 267,57 L 265,62 L 263,57 L 258,55 L 263,53 Z" Fill="#FFFFFF" Opacity="0.9"/>
                            <Path Data="M 292,138 L 293,142 L 297,143 L 293,144 L 292,148 L 291,144 L 287,143 L 291,142 Z" Fill="#FFFFFF" Opacity="0.8"/>
                        </Canvas>
                    </Grid>

                    <!-- LỚP NỘI DUNG CHÍNH (CONTENT GRID) -->
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Padding="16,14">
                        <!-- HÀNG 1: HEADER LỄ HỘI / MÙA & ĐỒNG HỒ SỐ -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="SeasonalEmojiText" Text="🧧" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SeasonalTagText" Text="Tết Cổ Truyền" FontSize="12.5" FontWeight="Bold" Foreground="#FDA4AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="SeasonalGreetingText" Text="Chúc Mừng Năm Mới • Vạn Sự Như Ý" FontSize="10" FontWeight="SemiBold" Foreground="#FDE047" TextTrimming="CharacterEllipsis" MaxWidth="195"/>
                            </StackPanel>

                            <!-- ĐỒNG HỒ & CÁC NÚT ĐIỀU KHIỂN HOVER -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
                                <TextBlock x:Name="SeasonalClockText" Text="--:--" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                    <Button x:Name="SeasonalThemePickerButton" Click="SeasonalThemePickerButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,2" ToolTipService.ToolTip="Đổi chủ đề Mùa / Lễ Hội">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf5a0;" FontSize="9.5" Foreground="#F59E0B"/>
                                    </Button>
                                    <Button x:Name="SeasonalAddWidgetButton" Click="AddWidgetButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,2" ToolTipService.ToolTip="Mở thêm Widget khác">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;" FontSize="9.5" Foreground="#38BDF8"/>
                                    </Button>
                                    <Button x:Name="SeasonalPinButton" Click="PinButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,2" ToolTipService.ToolTip="Ghim Always on Top">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="9.5" Foreground="#38BDF8"/>
                                    </Button>
                                    <Button x:Name="SeasonalRefreshButton" Click="WidgetRefreshButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,2" ToolTipService.ToolTip="Làm mới thời tiết">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="9.5" Foreground="#CBD5E1"/>
                                    </Button>
                                    <Button x:Name="SeasonalToggleStyleButton" Click="ToggleStyleButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,2" ToolTipService.ToolTip="Đổi kiểu widget">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf065;" FontSize="9.5" Foreground="#CBD5E1"/>
                                    </Button>
                                    <Button x:Name="SeasonalCloseButton" Click="CloseWidgetButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,2" ToolTipService.ToolTip="Đóng widget">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="9.5" Foreground="#94A3B8"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- HÀNG 2: THÂN THỜI TIẾT (ICON LỚN + NHIỆT ĐỘ + ĐỊA ĐIỂM + ÂM LỊCH) -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center" Margin="0,4,0,8">
                            <!-- Icon thời tiết -->
                            <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Image x:Name="SeasonalWeatherIcon" Width="44" Height="44" Stretch="Uniform"/>
                                <FontIcon x:Name="SeasonalFallbackIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="28" Foreground="#FDE047" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Nhiệt độ và Tình trạng -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="SeasonalTempText" Text="--°" FontSize="34" FontWeight="Bold" Foreground="White" Margin="0,-4,0,-2"/>
                                    <TextBlock x:Name="SeasonalRangeText" Text="--° / --°" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                </StackPanel>
                                <TextBlock x:Name="SeasonalConditionText" Text="Nắng đẹp" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Địa điểm & Âm lịch -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                                <Button x:Name="SeasonalCityPickerButton" Click="CityPickerButton_Click" Background="#25000000" BorderThickness="1" BorderBrush="#35FFFFFF" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" ToolTipService.ToolTip="Bấm để đổi thành phố hoặc mở thêm Widget">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="9" Foreground="#38BDF8"/>
                                        <TextBlock x:Name="SeasonalCityText" Text="Hà Nội" FontSize="11.5" FontWeight="Bold" Foreground="White" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0d7;" FontSize="8" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="SeasonalDateText" Text="23/08" FontSize="10.5" Foreground="#CBD5E1" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="SeasonalLunarText" Text="Mùng 1 Tết" FontSize="10" FontWeight="SemiBold" Foreground="#FEF08A" HorizontalAlignment="Right" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- HÀNG 3: 3 MINI CAPSULE PILLS (AQI, GIÓ, ĐỘ ẨM) -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <!-- Capsule 1: AQI -->
                            <Border Grid.Column="0" Background="#30000000" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06c;" FontSize="9.5" Foreground="#10B981"/>
                                    <TextBlock x:Name="SeasonalAqiText" Text="AQI 35" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Capsule 2: Gió -->
                            <Border Grid.Column="1" Background="#30000000" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="9.5" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="SeasonalWindText" Text="12 km/h" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Capsule 3: Độ ẩm -->
                            <Border Grid.Column="2" Background="#30000000" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="9.5" Foreground="#60A5FA"/>
                                    <TextBlock x:Name="SeasonalHumidityText" Text="65%" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- ==================== STYLE 6: BENTO POP / VIVID COLOR (v3.4.1) ==================== -->
                <Grid x:Name="BentoVividView" Visibility="Collapsed" Padding="8">
                    <Grid ColumnDefinitions="*,*">
                        <!-- SKY BLUE TILE -->
                        <Border Grid.Column="0" CornerRadius="22" Background="#38BDF8" Margin="0,0,4,0" Padding="14,12">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                                    <Grid Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Image x:Name="BentoVividWeatherIcon" Width="22" Height="22" Stretch="Uniform"/>
                                        <FontIcon x:Name="BentoVividFallbackIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" x:Name="BentoVividConditionText" Text="Few clouds" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <TextBlock Grid.Row="1" x:Name="BentoVividTempText" Text="28&#x00B0;" FontSize="46" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,-4,0,-2"/>

                                <Button Grid.Row="2" Click="CityPickerButton_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" ToolTipService.ToolTip="Select city">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Name="BentoVividCityText" Text="New York City" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" MaxWidth="135" TextTrimming="CharacterEllipsis"/>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0d7;" FontSize="8" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- RIGHT COLUMN: 3 BENTO TILES -->
                        <Grid Grid.Column="1" Margin="4,0,0,0" RowDefinitions="Auto,*" RowSpacing="8">
                            <!-- TOP ROW: DATE &amp; SUNSET -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8" Height="68">
                                <!-- DATE TILE (AMBER) -->
                                <Border Grid.Column="0" CornerRadius="18" Background="#F97316" Padding="10,6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                        <TextBlock x:Name="BentoVividDayOfWeekText" Text="Sun" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E1B18" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="BentoVividDayNumText" Text="15" FontSize="26" FontWeight="Bold" Foreground="#1E1B18" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- SUNSET TILE (DARK) -->
                                <Border Grid.Column="1" CornerRadius="18" Background="#141518" Padding="6,6">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                                        <Canvas Width="32" Height="18" HorizontalAlignment="Center">
                                            <Line X1="2" Y1="17" X2="30" Y2="17" Stroke="#FB923C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="M 9,17 A 7,7 0 0 1 23,17" Fill="#FB923C"/>
                                            <Path Data="M 16,1 L 16,7 M 13,4 L 16,7 L 19,4" Stroke="#FB923C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                        <TextBlock x:Name="BentoVividSunsetText" Text="22:04" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BOTTOM ROW: ANALOG WORLD CLOCK (CORAL RED) -->
                            <Border Grid.Row="1" CornerRadius="18" Background="#EF4444" Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- WATCH DIAL -->
                                    <Canvas Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="52" Height="52" Fill="#FFFFFF" Stroke="#FCA5A5" StrokeThickness="1.2"/>
                                        <Ellipse Canvas.Left="24" Canvas.Top="24" Width="4" Height="4" Fill="#DC2626"/>
                                        <Line X1="26" Y1="26" X2="26" Y2="13" Stroke="#DC2626" StrokeThickness="2" StrokeStartLineCap="Round">
                                            <Line.RenderTransform>
                                                <RotateTransform x:Name="BentoVividHourTransform" CenterX="26" CenterY="26" Angle="0"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <Line X1="26" Y1="26" X2="26" Y2="9" Stroke="#DC2626" StrokeThickness="1.3" StrokeStartLineCap="Round">
                                            <Line.RenderTransform>
                                                <RotateTransform x:Name="BentoVividMinuteTransform" CenterX="26" CenterY="26" Angle="0"/>
                                            </Line.RenderTransform>
                                        </Line>
                                    </Canvas>

                                    <!-- INFO -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="1">
                                        <TextBlock x:Name="BentoVividClockCityText" Text="NYC" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BentoVividClockSubText" Text="Sun, Dec 15" FontSize="10.5" FontWeight="Medium" Foreground="#FEE2E2" Opacity="0.9"/>
