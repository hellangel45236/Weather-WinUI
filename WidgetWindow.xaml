                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ==================== STYLE 7: BENTO PILOT / TACTICAL SLATE (v3.4.1) ==================== -->
                <Grid x:Name="BentoTacticalView" Visibility="Collapsed" Padding="8">
                    <Grid ColumnDefinitions="*,*">
                        <!-- SLATE BLUE WEATHER TILE -->
                        <Border Grid.Column="0" CornerRadius="22" Background="#7E99AB" Margin="0,0,4,0" Padding="14,12">
                            <Grid RowDefinitions="Auto,*,Auto">
