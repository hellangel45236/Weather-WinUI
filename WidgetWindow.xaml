                        <TextBlock x:Name="CompactCondText" Text="Nắng" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                    </StackPanel>

                    <!-- Nút thao tác nhanh (Làm mới, Chuyển style, Ghim, Đóng) -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="CompactRefreshButton"
                                Click="WidgetRefreshButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="5"
                                Padding="4,3"
