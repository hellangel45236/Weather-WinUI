                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="10" Foreground="#38BDF8"/>
                            <TextBlock x:Name="CompactCityText" Text="HCM" FontSize="11" FontWeight="Bold" Foreground="White" MaxWidth="75" TextTrimming="CharacterEllipsis"/>
