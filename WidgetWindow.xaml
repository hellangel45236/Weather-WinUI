<Window
    x:Class="WeatherApp.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:winuiex="using:WinUIEx"
    xmlns:models="using:WeatherApp.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Weather Mini Station Widget"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <winuiex:TransparentTintBackdrop />
    </Window.SystemBackdrop>

    <!-- NỀN TRONG SUỐT HOÀN TOÀN, CHỈ HIỆN CARD BO GÓC NỔI BẬT KHÔNG VIỀN TRẮNG -->
    <Grid Background="Transparent">
        <Border x:Name="WidgetRoot"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                PointerPressed="WidgetRoot_PointerPressed"
                PointerMoved="WidgetRoot_PointerMoved"
                PointerReleased="WidgetRoot_PointerReleased"
                PointerCaptureLost="WidgetRoot_PointerCaptureLost"
                PointerEntered="WidgetRoot_PointerEntered"
                PointerExited="WidgetRoot_PointerExited"
                DoubleTapped="WidgetRoot_DoubleTapped">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F20F172A" Offset="0"/>
                    <GradientStop Color="#F21E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- ==================== GIAO DIỆN CHÍNH: BRYAN C DYNAMIC WEATHER CARD (DRIBBBLE) ==================== -->
                <Grid x:Name="BryanCDynamicView" Visibility="Visible">
                    <!-- LỚP ĐỒ HỌA THỜI TIẾT ĐỘNG (WEATHER ARTWORK) -->
                    <Grid x:Name="BryanCArtLayer" IsHitTestVisible="False">
                        <!-- 1. Vòng hào quang mặt trời (Trời nắng / Clear Sunny) -->
                        <Canvas x:Name="BryanCSunArcs" Visibility="Collapsed">
                            <Ellipse Width="240" Height="240" Canvas.Left="190" Canvas.Top="-110" Stroke="#20FFFFFF" StrokeThickness="26" Fill="#0AFFFFFF"/>
                            <Ellipse Width="150" Height="150" Canvas.Left="235" Canvas.Top="-65" Stroke="#25FFFFFF" StrokeThickness="18" Fill="#12FFFFFF"/>
                            <Ellipse Width="70" Height="70" Canvas.Left="275" Canvas.Top="-25" Fill="#28FFFFFF"/>
                        </Canvas>

                        <!-- 2. Vầng trăng đêm thanh tịnh (Đêm quang mây / Clear Night) -->
                        <Canvas x:Name="BryanCMoonArc" Visibility="Collapsed">
                            <Ellipse Width="120" Height="120" Canvas.Left="225" Canvas.Top="-35" Fill="#25FBBF24"/>
                            <Ellipse Width="105" Height="105" Canvas.Left="215" Canvas.Top="-45" Fill="#1E1B3B6F"/>
                        </Canvas>

                        <!-- 3. Vệt mưa rơi nghiêng tự nhiên (Trời mưa / Rain) -->
                        <Canvas x:Name="BryanCRainStreaks" Visibility="Collapsed" Opacity="0.5">
                            <Line X1="220" Y1="10" X2="195" Y2="85" Stroke="#50FFFFFF" StrokeThickness="1.5" StrokeDashArray="12,14"/>
                            <Line X1="250" Y1="5" X2="225" Y2="80" Stroke="#50FFFFFF" StrokeThickness="1.5" StrokeDashArray="10,12"/>
                            <Line X1="280" Y1="15" X2="255" Y2="90" Stroke="#50FFFFFF" StrokeThickness="1.5" StrokeDashArray="14,16"/>
                            <Line X1="170" Y1="20" X2="145" Y2="95" Stroke="#40FFFFFF" StrokeThickness="1.2" StrokeDashArray="8,10"/>
                            <Line X1="310" Y1="10" X2="285" Y2="85" Stroke="#40FFFFFF" StrokeThickness="1.2" StrokeDashArray="10,12"/>
                        </Canvas>

                        <!-- 4. Lớp mây bồng bềnh (Nhiều mây / Cloudy) -->
                        <Canvas x:Name="BryanCCloudWaves" Visibility="Collapsed" Opacity="0.32">
                            <Ellipse Width="190" Height="110" Canvas.Left="170" Canvas.Top="-40" Fill="#30FFFFFF"/>
                            <Ellipse Width="150" Height="90" Canvas.Left="220" Canvas.Top="0" Fill="#22FFFFFF"/>
                            <Ellipse Width="120" Height="70" Canvas.Left="140" Canvas.Top="-20" Fill="#1AFFFFFF"/>
                        </Canvas>

                        <!-- 5. Hạt tuyết rơi lung linh (Tuyết rơi / Snow) -->
                        <Canvas x:Name="BryanCSnowDots" Visibility="Collapsed" Opacity="0.85">
                            <Ellipse Width="5" Height="5" Canvas.Left="190" Canvas.Top="25" Fill="White"/>
                            <Ellipse Width="7" Height="7" Canvas.Left="240" Canvas.Top="45" Fill="White"/>
                            <Ellipse Width="4" Height="4" Canvas.Left="280" Canvas.Top="20" Fill="White"/>
                            <Ellipse Width="6" Height="6" Canvas.Left="220" Canvas.Top="80" Fill="White"/>
                            <Ellipse Width="5" Height="5" Canvas.Left="290" Canvas.Top="75" Fill="White"/>
                            <Ellipse Width="8" Height="8" Canvas.Left="160" Canvas.Top="60" Fill="White" Opacity="0.7"/>
                            <Ellipse Width="4" Height="4" Canvas.Left="265" Canvas.Top="100" Fill="White"/>
                        </Canvas>

                        <!-- 6. Dải sương mờ ảo (Sương mù / Fog) -->
                        <Canvas x:Name="BryanCMistBands" Visibility="Collapsed" Opacity="0.35">
                            <Rectangle Width="160" Height="14" Canvas.Left="160" Canvas.Top="25" RadiusX="7" RadiusY="7" Fill="#35FFFFFF"/>
                            <Rectangle Width="130" Height="14" Canvas.Left="190" Canvas.Top="50" RadiusX="7" RadiusY="7" Fill="#25FFFFFF"/>
                            <Rectangle Width="150" Height="14" Canvas.Left="170" Canvas.Top="75" RadiusX="7" RadiusY="7" Fill="#30FFFFFF"/>
                        </Canvas>
                    </Grid>

                    <!-- LỚP NỘI DUNG CHÍNH (CONTENT GRID) -->
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- HÀNG 1: Tình trạng thời tiết (Trái) & Đồng hồ số + Ngày (Phải) -->
                        <Grid Grid.Row="0" Margin="16,14,16,0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                    <Image x:Name="BryanCConditionIcon" Width="28" Height="28" Stretch="Uniform"/>
                                    <FontIcon x:Name="BryanCFallbackIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="18" Foreground="White" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="BryanCConditionText" Text="Nắng đẹp" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="BryanCClockText" Text="--:--" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="BryanCDateText" Text="THỨ 2 • 23/08" FontSize="10.5" FontWeight="SemiBold" Foreground="#D5FFFFFF" HorizontalAlignment="Right" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- HÀNG 2: Nhiệt độ khổng lồ + Min/Max (Trái) & Tên địa điểm (Phải) -->
                        <Grid Grid.Row="1" Margin="16,2,16,6" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="BryanCTempText" Text="--°" FontSize="48" FontWeight="SemiBold" Foreground="White" Margin="0,-6,0,-2"/>
                                <TextBlock x:Name="BryanCRangeText" Text="--° / --°" FontSize="12" FontWeight="Normal" Foreground="#D0FFFFFF"/>
                            </StackPanel>

                            <TextBlock x:Name="BryanCCityText" Text="Đang tải..." FontSize="13.5" FontWeight="SemiBold" Foreground="#EEFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- HÀNG 3: DỰ BÁO 4 NGÀY TIẾP THEO (DOCKED BOTTOM DOCK) -->
                        <Border Grid.Row="2" Background="#2E000000" CornerRadius="0,0,18,18" Height="42" Padding="12,0">
                            <Grid ColumnDefinitions="*,*,*,*">
                                <!-- Ngày 0 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock x:Name="BryanCDay0" Text="T3" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Image x:Name="BryanCIcon0" Width="18" Height="18" Stretch="Uniform"/>
                                        <FontIcon x:Name="BryanCFallback0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11" Foreground="#F59E0B" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Ngày 1 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock x:Name="BryanCDay1" Text="T4" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Image x:Name="BryanCIcon1" Width="18" Height="18" Stretch="Uniform"/>
                                        <FontIcon x:Name="BryanCFallback1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#38BDF8" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Ngày 2 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock x:Name="BryanCDay2" Text="T5" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Image x:Name="BryanCIcon2" Width="18" Height="18" Stretch="Uniform"/>
                                        <FontIcon x:Name="BryanCFallback2" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c2;" FontSize="11" Foreground="#CBD5E1" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Ngày 3 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock x:Name="BryanCDay3" Text="T6" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Image x:Name="BryanCIcon3" Width="18" Height="18" Stretch="Uniform"/>
                                        <FontIcon x:Name="BryanCFallback3" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11" Foreground="#F59E0B" Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- THANH NÚT THAO TÁC LINH HOẠT (ẨN MỜ, SÁNG RÕ KHI RÊ CHUỘT) -->
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0" Opacity="0.25" x:Name="BryanCActionsOverlay" PointerEntered="BryanCActionsOverlay_PointerEntered" PointerExited="BryanCActionsOverlay_PointerExited">
                            <Button x:Name="BryanCCityPickerButton" Click="CityPickerButton_Click" Background="Transparent" BorderThickness="0" Padding="4,3" CornerRadius="5" ToolTipService.ToolTip="Đổi địa điểm">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="9" Foreground="White"/>
                            </Button>
                            <Button x:Name="BryanCAddWidgetButton" Click="AddWidgetButton_Click" Background="Transparent" BorderThickness="0" Padding="4,3" CornerRadius="5" ToolTipService.ToolTip="Mở thêm Widget khác">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;" FontSize="9" Foreground="White"/>
                            </Button>
                            <Button x:Name="BryanCStyleButton" Click="ToggleStyleButton_Click" Background="Transparent" BorderThickness="0" Padding="4,3" CornerRadius="5" ToolTipService.ToolTip="Đổi kiểu Widget (Dribbble Dynamic / GlassCard / Compact / Island)">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf066;" FontSize="9" Foreground="White"/>
                            </Button>
                            <Button x:Name="BryanCRefreshButton" Click="WidgetRefreshButton_Click" Background="Transparent" BorderThickness="0" Padding="4,3" CornerRadius="5" ToolTipService.ToolTip="Làm mới thời tiết">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="9" Foreground="White"/>
                            </Button>
                            <Button x:Name="BryanCPinButton" Click="PinButton_Click" Background="Transparent" BorderThickness="0" Padding="4,3" CornerRadius="5" ToolTipService.ToolTip="Ghim cửa sổ trên cùng">
                                <FontIcon x:Name="BryanCPinIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="9" Foreground="White"/>
                            </Button>
                            <Button x:Name="BryanCCloseButton" Click="CloseWidgetButton_Click" Background="Transparent" BorderThickness="0" Padding="4,3" CornerRadius="5" ToolTipService.ToolTip="Đóng Widget">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="9" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== GIAO DIỆN 1: KIỂU GLASS CARD (ĐẦY ĐỦ THÔNG TIN) ==================== -->
                <Grid x:Name="GlassCardView" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" Padding="14,12" Visibility="Collapsed">
                    <!-- HÀNG 1: HEADER (ĐỊA ĐIỂM + ĐỒNG HỒ, NÚT STYLE, LÀM MỚI, GHIM ALWAYS-ON-TOP, ĐÓNG) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Nút chọn / đổi thành phố -->
                            <Button x:Name="CityPickerButton"
                                    Click="CityPickerButton_Click"
                                    Background="#1AFFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="6,3"
                                    ToolTipService.ToolTip="Bấm để đổi thành phố hoặc mở thêm Widget">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="WidgetCityText" Text="Đang định vị..." FontSize="12" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0d7;" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Button>

                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock x:Name="WidgetClockText" Text="--:--" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <!-- Nút tạo thêm Widget mới -->
                            <Button x:Name="AddWidgetButton"
                                    Click="AddWidgetButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="5,4"
                                    ToolTipService.ToolTip="Mở thêm một Widget mới cho thành phố khác">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;" FontSize="10" Foreground="#38BDF8"/>
                            </Button>

                            <!-- Nút chuyển sang dạng Compact Bar / Mini Island -->
                            <Button x:Name="ToggleStyleButton"
                                    Click="ToggleStyleButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="5,4"
                                    ToolTipService.ToolTip="Chuyển đổi kiểu hiển thị (GlassCard / Compact / Mini Island)">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf066;" FontSize="10" Foreground="#94A3B8"/>
                            </Button>

                            <!-- Nút làm mới dữ liệu độc lập -->
                            <Button x:Name="WidgetRefreshButton"
                                    Click="WidgetRefreshButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="5,4"
                                    ToolTipService.ToolTip="Cập nhật thời tiết mới nhất cho thành phố này">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="10" Foreground="#94A3B8"/>
                            </Button>

                            <!-- NÚT GHIM ALWAYS ON TOP (ĐINH GHIM) -->
                            <Button x:Name="PinButton"
                                    Click="PinButton_Click"
                                    Background="#2E0078D4"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="5,4"
                                    ToolTipService.ToolTip="Đang ghim cửa sổ trên cùng (Bấm để bỏ ghim)">
                                <FontIcon x:Name="PinIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#38BDF8"/>
                            </Button>

                            <!-- Nút đóng widget này -->
                            <Button x:Name="CloseWidgetButton"
                                    Click="CloseWidgetButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="5,4"
                                    ToolTipService.ToolTip="Đóng widget này">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="10" Foreground="#94A3B8"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- HÀNG 2: THÔNG TIN THỜI TIẾT HIỆN TẠI & ICON SVG VECTOR ĐỘNG -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="WidgetTempText" Text="--°C" FontSize="36" FontWeight="ExtraBold" Foreground="White"/>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="WidgetConditionText" Text="Đang cập nhật..." FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                    <TextBlock x:Name="WidgetFeelsLikeText" Text="Cảm giác như --°" FontSize="11" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="WidgetWeatherIcon" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <FontIcon x:Name="WidgetFallbackIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="32" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- HÀNG 3: CÁC CHỈ SỐ PHỤ GỌN GÀNG (Độ ẩm, Gió, UV, Mưa, AQI) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                        <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="8" Padding="5,4">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="9" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="WidgetHumidityLabel" Text="Độ ẩm" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <TextBlock x:Name="WidgetHumidityText" Text="--%" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" Padding="5,4">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="9" Foreground="#34D399"/>
                                    <TextBlock x:Name="WidgetWindLabel" Text="Gió" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <TextBlock x:Name="WidgetWindText" Text="-- km/h" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="8" Padding="5,4">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="9" Foreground="#FBBF24"/>
                                    <TextBlock Text="UV" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <TextBlock x:Name="WidgetUvText" Text="--" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#14FFFFFF" CornerRadius="8" Padding="5,4">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="9" Foreground="#60A5FA"/>
                                    <TextBlock x:Name="WidgetRainLabel" Text="Mưa" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <TextBlock x:Name="WidgetRainProbText" Text="--%" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#14FFFFFF" CornerRadius="8" Padding="5,4">
                            <StackPanel HorizontalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="9" Foreground="#A78BFA"/>
                                    <TextBlock Text="AQI" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <TextBlock x:Name="WidgetAqiText" Text="--" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- HÀNG 4: DỰ BÁO NHANH 5 GIỜ TIẾP THEO -->
                    <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="10" Padding="8,5">
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                            <!-- Giờ 0 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="HTime0" Text="--:--" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                <Grid Width="22" Height="22" HorizontalAlignment="Center">
                                    <Image x:Name="HIcon0" Width="22" Height="22" Stretch="Uniform"/>
                                    <FontIcon x:Name="HFallback0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="13" Foreground="#F59E0B" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="HTemp0" Text="--°" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Giờ 1 -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="HTime1" Text="--:--" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                <Grid Width="22" Height="22" HorizontalAlignment="Center">
                                    <Image x:Name="HIcon1" Width="22" Height="22" Stretch="Uniform"/>
                                    <FontIcon x:Name="HFallback1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="13" Foreground="#F59E0B" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="HTemp1" Text="--°" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Giờ 2 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="HTime2" Text="--:--" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                <Grid Width="22" Height="22" HorizontalAlignment="Center">
