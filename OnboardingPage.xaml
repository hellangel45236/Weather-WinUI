<Page
    x:Class="WeatherApp.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== KHU VỰC CUỘN NỘI DUNG THIẾT LẬP ==================== -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,12,20,20">
            <Grid HorizontalAlignment="Center" MaxWidth="780" Margin="0,4,0,24">

                <!-- ==================== GIAI ĐOẠN 1: CẤU HÌNH KHỞI ĐỘNG LẦN ĐẦU ==================== -->
                <StackPanel x:Name="SetupPanel" Spacing="16">

                    <!-- Tiêu đề & Logo chào mừng -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,6">
                        <Border Width="60" Height="60" CornerRadius="14" HorizontalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="60" Height="60" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Chào Mừng Đến Với Thời Tiết WinUI" FontSize="23" FontWeight="ExtraBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Hãy thiết lập nhanh các thông số để ứng dụng phục vụ bạn tốt nhất" FontSize="13" Opacity="0.75" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- BƯỚC 1: TÊN CỦA BẠN -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf007;" Foreground="#6366F1" FontSize="15"/>
                                <TextBlock Text="1. Tên của bạn" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="Ứng dụng sẽ dùng tên này để chào bạn và gửi thông báo hàng ngày:" FontSize="12.5" Opacity="0.75"/>
                            <TextBox x:Name="UserNameBox" PlaceholderText="Nhập tên của bạn (Ví dụ: Tuấn, Linh, Alex...)" MaxLength="40" Height="38" FontSize="13.5"/>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 2: VỊ TRÍ & ĐỊNH VỊ -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" Foreground="#0078D4" FontSize="15"/>
                                <TextBlock Text="2. Vị trí &amp; Định vị thời tiết" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="Chọn cách bạn muốn ứng dụng cập nhật thời tiết:" FontSize="12.5" Opacity="0.75"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <!-- Nút GPS -->
                                <Button x:Name="GpsLocationButton"
                                        Click="GpsLocationButton_Click"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Height="44"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        CornerRadius="9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf124;" FontSize="13"/>
                                        <TextBlock Text="Tự động định vị GPS" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nhập địa điểm thủ công -->
                                <AutoSuggestBox x:Name="CitySearchBox"
                                                Grid.Column="1"
                                                PlaceholderText="Hoặc gõ tên thành phố (Hà Nội, TP.HCM...)"
                                                QueryIcon="Find"
                                                TextChanged="CitySearchBox_TextChanged"
                                                QuerySubmitted="CitySearchBox_QuerySubmitted"
                                                SuggestionChosen="CitySearchBox_SuggestionChosen"
                                                Height="44"
                                                VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Thông báo vị trí đã chọn -->
                            <Border x:Name="SelectedLocationBadge"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf058;" Foreground="#10B981" FontSize="14"/>
                                    <TextBlock x:Name="SelectedLocationText" Text="Đang chọn: TP. Hồ Chí Minh (Mặc định)" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Gợi ý chọn nhanh 1 chạm (1-Tap Quick Select Chips) -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <TextBlock Text="Chọn nhanh:" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button Content="📍 TP. Hồ Chí Minh" Click="QuickCity_Click" Tag="HCM" Style="{ThemeResource DefaultButtonStyle}" CornerRadius="12" Padding="10,3" FontSize="11.5"/>
                                <Button Content="📍 Hà Nội" Click="QuickCity_Click" Tag="HN" Style="{ThemeResource DefaultButtonStyle}" CornerRadius="12" Padding="10,3" FontSize="11.5"/>
                                <Button Content="📍 Đà Nẵng" Click="QuickCity_Click" Tag="DN" Style="{ThemeResource DefaultButtonStyle}" CornerRadius="12" Padding="10,3" FontSize="11.5"/>
                                <Button Content="📍 Cần Thơ" Click="QuickCity_Click" Tag="CT" Style="{ThemeResource DefaultButtonStyle}" CornerRadius="12" Padding="10,3" FontSize="11.5"/>
                                <Button Content="📍 Hải Phòng" Click="QuickCity_Click" Tag="HP" Style="{ThemeResource DefaultButtonStyle}" CornerRadius="12" Padding="10,3" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 3: ĐƠN VỊ ĐO LƯỜNG -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" Foreground="#FF8C00" FontSize="15"/>
                                <TextBlock Text="3. Đơn vị đo lường" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Nhiệt độ -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Nhiệt độ:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="UnitCelsiusRadio" Content="Độ C (°C - Celsius)" IsChecked="True" GroupName="TempUnit"/>
                                    <RadioButton x:Name="UnitFahrenheitRadio" Content="Độ F (°F - Fahrenheit)" GroupName="TempUnit"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tốc độ gió -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Tốc độ gió:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="WindKmhRadio" Content="km/h" IsChecked="True" GroupName="WindUnit"/>
                                    <RadioButton x:Name="WindMsRadio" Content="m/s" GroupName="WindUnit"/>
                                    <RadioButton x:Name="WindMphRadio" Content="mph" GroupName="WindUnit"/>
                                </StackPanel>
                            </Grid>

                            <!-- Áp suất khí quyển -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Áp suất:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="PressureHpaRadio" Content="hPa (Hectopascal)" IsChecked="True" GroupName="PressureUnit"/>
                                    <RadioButton x:Name="PressureMmHgRadio" Content="mmHg (Milimet thủy ngân)" GroupName="PressureUnit"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 4: THỜI GIAN & MÚI GIỜ -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" Foreground="#8E8CD8" FontSize="15"/>
                                <TextBlock Text="4. Định dạng giờ &amp; Múi giờ" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Định dạng giờ 24h / 12h -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Định dạng giờ:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="Time24hRadio" Content="24 Giờ (Ví dụ: 14:30)" IsChecked="True" GroupName="TimeFormatGroup"/>
                                    <RadioButton x:Name="Time12hRadio" Content="12 Giờ AM/PM (Ví dụ: 02:30 PM)" GroupName="TimeFormatGroup"/>
                                </StackPanel>
                            </Grid>

                            <!-- Định dạng ngày tháng -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Định dạng ngày:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="DateDmyRadio" Content="dd/MM/yyyy (Việt Nam)" IsChecked="True" GroupName="DateFormatGroup"/>
                                    <RadioButton x:Name="DateMdyRadio" Content="MM/dd/yyyy" GroupName="DateFormatGroup"/>
                                    <RadioButton x:Name="DateYmdRadio" Content="yyyy-MM-dd" GroupName="DateFormatGroup"/>
                                </StackPanel>
                            </Grid>

                            <!-- Ngày bắt đầu tuần -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Bắt đầu tuần từ:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <RadioButton x:Name="StartMondayRadio" Content="Thứ Hai (Mặc định)" IsChecked="True" GroupName="FirstDayOfWeekGroup"/>
                                    <RadioButton x:Name="StartSundayRadio" Content="Chủ Nhật (Quốc tế)" GroupName="FirstDayOfWeekGroup"/>
                                </StackPanel>
                            </Grid>

                            <!-- Múi giờ (Sửa triệt để lỗi hiển thị đè lên chữ Múi giờ) -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Múi giờ:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="TimezoneComboBox" SelectedIndex="0" Width="280">
                                    <ComboBoxItem Content="🌐 Tự động theo hệ thống (Khuyên dùng)" Tag="Auto"/>
                                    <ComboBoxItem Content="GMT+7 (Việt Nam, Bangkok, Jakarta)" Tag="GMT+7"/>
                                    <ComboBoxItem Content="GMT+8 (Singapore, Bắc Kinh)" Tag="GMT+8"/>
                                    <ComboBoxItem Content="GMT+9 (Tokyo, Seoul)" Tag="GMT+9"/>
                                    <ComboBoxItem Content="GMT+0 (London, UTC)" Tag="GMT+0"/>
                                    <ComboBoxItem Content="GMT-5 (New York, EST)" Tag="GMT-5"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 5: CHẾ ĐỘ GIAO DIỆN (THEME) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1fc;" Foreground="#EC4899" FontSize="15"/>
                                <TextBlock Text="5. Chế độ giao diện (Dark / Light Mode)" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <!-- Sáng -->
                                <Button x:Name="ThemeLightButton" Click="ThemeOption_Click" Tag="Light"
                                        Grid.Column="0" HorizontalAlignment="Stretch" Padding="12,14" CornerRadius="9"
                                        Style="{ThemeResource DefaultButtonStyle}">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="☀️ Giao diện Sáng" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sáng sủa, sắc nét" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Tối -->
                                <Button x:Name="ThemeDarkButton" Click="ThemeOption_Click" Tag="Dark"
                                        Grid.Column="1" HorizontalAlignment="Stretch" Padding="12,14" CornerRadius="9"
                                        Style="{ThemeResource DefaultButtonStyle}">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="🌙 Giao diện Tối" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Êm dịu mắt, huyền bí" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Hệ thống -->
                                <Button x:Name="ThemeSystemButton" Click="ThemeOption_Click" Tag="System"
                                        Grid.Column="2" HorizontalAlignment="Stretch" Padding="12,14" CornerRadius="9"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                        Style="{ThemeResource DefaultButtonStyle}">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf108;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="💻 Theo Windows" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tự động đồng bộ" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- BƯỚC 6: LỊCH TRÌNH ĐI LÀM / ĐI HỌC (v2.0) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1b9;" Foreground="#38BDF8" FontSize="15"/>
                                    <TextBlock Text="6. Nhắc nhở thời tiết giờ Đi làm &amp; Tan ca" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" x:Name="OnboardingCommuteToggle" IsOn="True" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Ứng dụng sẽ chủ động kiểm tra thời tiết và gửi thông báo chuẩn bị ô/áo mưa trước giờ xuất phát:" FontSize="12.5" Opacity="0.75"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <!-- Giờ đi sáng -->
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Giờ đi sáng:" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TimePicker x:Name="OnboardingMorningTimePicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <!-- Giờ tan ca -->
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Giờ về / tan ca:" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TimePicker x:Name="OnboardingEveningTimePicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="140,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Báo trước:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="OnboardingLeadTimeComboBox" SelectedIndex="1" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Trước 15 phút" Tag="15"/>
                                    <ComboBoxItem Content="Trước 30 phút (Khuyên dùng)" Tag="30"/>
                                    <ComboBoxItem Content="Trước 45 phút" Tag="45"/>
                                    <ComboBoxItem Content="Trước 1 tiếng" Tag="60"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- NÚT LƯU LẠI VÀ CHUYỂN TIẾP TRONG CUỘN -->
                    <Button x:Name="SaveAndContinueButton"
                            Click="SaveAndContinueButton_Click"
                            HorizontalAlignment="Stretch"
                            Height="48"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="10"
                            Margin="0,4,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00c;" FontSize="14"/>
                            <TextBlock Text="Lưu Cài Đặt &amp; Bắt Đầu Sử Dụng" FontSize="15" FontWeight="Bold"/>
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf061;" FontSize="13"/>
                        </StackPanel>
                    </Button>

                </StackPanel>


                <!-- ==================== GIAI ĐOẠN 2: CHÀO MỪNG & HƯỚNG DẪN TÍNH NĂNG ==================== -->
                <StackPanel x:Name="WelcomePanel" Visibility="Collapsed" Spacing="20">

                    <!-- Header Chúc mừng -->
                    <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,10">
                        <Border Width="72" Height="72" CornerRadius="16" HorizontalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="72" Height="72" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="WelcomeTitleText" Text="🎉 Chào Mừng Bạn Đến Với Thời Tiết WinUI!" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="WelcomeSubtitleText" Text="Thiết lập đã được lưu. Dưới đây là các tính năng độc đáo dành cho bạn:" FontSize="13.5" Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- DANH SÁCH 4 TÍNH NĂNG NỔI BẬT (FIRST-TIME GUIDELINES) -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">

                        <!-- Tính năng 1: Hiệu ứng động thời gian thực -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1A0078D4">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="14" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Hiệu Ứng Trực Quan" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Mưa rơi tí tách, chớp giật sấm sét sống động hoặc vầng nắng vàng ấm phản chiếu đúng tình hình thực tế ngoài trời của bạn." FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Tính năng 2: Phản ánh thời tiết tương tác -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1AF59E0B">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf075;" FontSize="14" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Tương Tác Thực Tế" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Nếu dự báo có độ trễ, bạn có thể bấm phản hồi ngay dưới thẻ thời tiết để ứng dụng cập nhật giao diện theo đúng trạng thái ngoài trời." FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Tính năng 3: Desktop Widget Mini -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1A10B981">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Desktop Widget Mini" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Khung tiện ích mini trong suốt lơ lửng trên màn hình Desktop, kéo thả tự do bằng chuột và có nút đinh ghim Always-on-top tiện lợi." FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Tính năng 4: Không khí AQI & Lời khuyên -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#1A8E8CD8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0eb;" FontSize="14" Foreground="#8E8CD8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AQI &amp; Lời Khuyên" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Theo dõi chỉ số bụi mịn PM2.5, chất lượng không khí AQI và nhận gợi ý thông minh về trang phục, đi lại, bảo vệ sức khỏe mỗi ngày." FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- NÚT BẮT ĐẦU TRẢI NGHIỆM -->
                    <Button x:Name="StartAppButton"
                            Click="StartAppButton_Click"
                            HorizontalAlignment="Stretch"
                            Height="48"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="10"
                            Margin="0,8,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf135;" FontSize="15"/>
                            <TextBlock Text="Bắt Đầu Trải Nghiệm Ứng Dụng Ngay!" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ==================== THANH CỐ ĐỊNH CHÂN TRANG (STICKY BOTTOM ACTION BAR) ==================== -->
        <!-- Đảm bảo nút Lưu và Sử Dụng luôn hiển thị 100% trên mọi độ phân giải màn hình (< FullHD, 1366x768, 1280x720) -->
        <Border Grid.Row="1" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid MaxWidth="780" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Trạng thái địa điểm đã chọn -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf058;" Foreground="#10B981" FontSize="15"/>
                    <TextBlock x:Name="FooterLocationSummaryText" Text="Đang chọn: TP. Hồ Chí Minh" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Nút Lưu Cài Đặt & Sử Dụng Ngay -->
                <Button Grid.Column="1" 
                        x:Name="StickySaveAndUseButton"
                        Click="SaveAndContinueButton_Click"
                        Height="44"
                        Padding="22,0"
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00c;" FontSize="13"/>
                        <TextBlock Text="Lưu Cài Đặt &amp; Bắt Đầu Sử Dụng" FontSize="14" FontWeight="Bold"/>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf061;" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Page>
