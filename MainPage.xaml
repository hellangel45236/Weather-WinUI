                        <ComboBoxItem Content="v2.1.0 (Hôm Nay Mặc Gì OOTD, Chia Sẻ Thẻ Full HD &amp; Tinh Chỉnh Widget)" Tag="2.1"/>
                        <ComboBoxItem Content="v2.0.0 (Nhắc Nhở Lịch, Mục Tiêu Ngày, Đa Widget &amp; Giờ Đi Làm)" Tag="2.0"/>
                        <ComboBoxItem Content="v1.9.0 (Ghi Chú Kế Hoạch, Cảnh Báo Xung Đột, Mini Island)" Tag="1.9"/>
                        <ComboBoxItem Content="v1.8.0 (Lịch Tháng Đa Niên, Âm Lịch &amp; Ngày Lễ VN)" Tag="1.8"/>
                        <ComboBoxItem Content="v1.7.0 (Chất Lượng Không Khí &amp; Bụi Mịn, Mặt Trời, Lịch Âm)" Tag="1.7"/>
                        <ComboBoxItem Content="v1.6.0 (Tương thích Win 10 &amp; Sửa Crash)" Tag="1.6"/>
                        <ComboBoxItem Content="v1.5.0 (Biểu đồ nhiệt độ &amp; Đa phiên bản)" Tag="1.5"/>
                        <ComboBoxItem Content="v1.4.0 (Fix Crash &amp; Settings)" Tag="1.4"/>
                        <ComboBoxItem Content="v1.3.0 (Báo cáo &amp; Lời khuyên)" Tag="1.3"/>
                        <ComboBoxItem Content="v1.2.0 (Trendline &amp; Chia sẻ ảnh)" Tag="1.2"/>
                        <ComboBoxItem Content="v1.1.0 (Toast, Tray &amp; Widget)" Tag="1.1"/>
