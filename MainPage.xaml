                                            </Border>
                                            <TextBlock Text="Sửa Lỗi Chí Mạng: Cài Đặt Bị Reset &amp; Widget Bị Ép Về Độ Mờ 20%" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="Xử lý triệt để race condition khi khởi tạo giao diện XAML: trước đây sự kiện ValueChanged của thanh trượt Slider tự kích hoạt trước khi nạp xong dữ liệu khiến độ mờ Widget luôn bị ghi đè về 20%. Nâng cấp cơ chế đồng bộ cờ _isSettingsSyncing, bổ sung cơ chế sao lưu tự động settings.json.bak, chống xung đột khóa file và lưu trữ nguyên tử an toàn tuyệt đối." FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. Tính năng Cảnh báo Ngập úng & Triều cường đô thị -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#2538BDF8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" Foreground="#38BDF8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="#38BDF8" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="TÍNH NĂNG MỚI" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
