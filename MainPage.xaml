        </Grid>

        <!-- =================================================================================== -->
        <!-- CHẾ ĐỘ THƯ GIÃN TOÀN CẢNH: ZEN IMMERSIVE VIEW (VERSION 3.1.0)                         -->
        <!-- =================================================================================== -->
        <Grid x:Name="ZenImmersiveOverlay"
              Visibility="{x:Bind ViewModel.IsZenModeOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              PointerMoved="ZenOverlay_PointerMoved"
              Canvas.ZIndex="9999"
              Background="#FF06080E"
              Margin="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Hình nền thành phố mờ ảo (Fluent 2 Mode) -->
            <Border x:Name="ZenCityBackgroundBorder"
                    Visibility="{x:Bind ViewModel.IsFluent2Design, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Opacity="0.28">
                <Border.Background>
                    <ImageBrush x:Name="ZenCityImageBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Lớp Gradient môi trường thích ứng (Fluent 2 Mode) -->
            <Border x:Name="ZenGradientOverlay"
                    Visibility="{x:Bind ViewModel.IsFluent2Design, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Opacity="0.72">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#050811" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Pure OLED Black Backdrop (Nothing StandBy Mode) -->
            <Border Visibility="{x:Bind ViewModel.IsZenClockNothingStandBy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FF000000" IsHitTestVisible="False"/>

            <!-- Canvas hiệu ứng hạt thời tiết động -->
            <Canvas x:Name="ZenWeatherCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Ánh chớp dông bão -->
            <Border x:Name="ZenLightningOverlay" Background="#99EEF2FF" Opacity="0" IsHitTestVisible="False"/>

            <!-- Khung bố cục chính của Zen Mode 2.0 -->
            <Grid RowDefinitions="Auto,*,Auto" Padding="36,24">
                <!-- ==================== HÀNG 0: AUTO-HIDE ZEN TOOLBAR + POMODORO FOCUS ==================== -->
                <Grid x:Name="ZenTopChrome" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Bên trái: Huy hiệu Zen Mode 2.0 + Chủ đề Mùa / Nothing StandBy -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="7" Height="7" Fill="#D71921" VerticalAlignment="Center"/>
                                <TextBlock Text="ZEN 2.0 // STANDBY SANCTUARY" FontSize="10.5" FontWeight="Bold" Foreground="White" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                            </StackPanel>
                        </Border>
                        <Border Visibility="{x:Bind ViewModel.IsFluent2Design, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{x:Bind ViewModel.CurrentSeasonalSkin.BadgeBackgroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.CurrentSeasonalSkin.BorderStrokeHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                BorderThickness="1" CornerRadius="14" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.CurrentSeasonalSkin.BadgeEmoji, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentSeasonalSkin.DisplayName, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                           Foreground="{x:Bind ViewModel.CurrentSeasonalSkin.BadgeForegroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Giữa: Đồng hồ Tập trung Pomodoro Focus Pill (25:00 / 05:00) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center"
                            Background="#22FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="16" Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#D71921" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.PomodoroModeBadge, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="White" FontFamily="Cascadia Mono, Consolas"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.PomodoroTimeDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource NdotFontFamily}" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Command="{x:Bind ViewModel.TogglePomodoroRunCommand}" Background="#28FFFFFF" BorderThickness="0" CornerRadius="8" Padding="7,4" ToolTipService.ToolTip="Bắt đầu / Tạm dừng Pomodoro">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.PomodoroActionGlyph, Mode=OneWay}" FontSize="10" Foreground="White"/>
                            </Button>
                            <Button Command="{x:Bind ViewModel.SwitchPomodoroSessionCommand}" Background="#18FFFFFF" BorderThickness="0" CornerRadius="8" Padding="7,4" ToolTipService.ToolTip="Chuyển đổi 25p Tập trung / 5p Nghỉ">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0ec;" FontSize="10" Foreground="#CBD5E1"/>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ResetPomodoroCommand}" Background="#18FFFFFF" BorderThickness="0" CornerRadius="8" Padding="7,4" ToolTipService.ToolTip="Đặt lại đồng hồ Pomodoro">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="10" Foreground="#CBD5E1"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Bên phải: Chọn kiểu đồng hồ + Nút cấu hình + Nút thoát -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ZenClockStyleLabel, Mode=OneWay}"
                                Background="#26FFFFFF" BorderThickness="1" BorderBrush="#38FFFFFF" CornerRadius="12" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" FontSize="12" Foreground="#38BDF8"/>
                                <TextBlock Text="{x:Bind ViewModel.ZenClockStyle, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf107;" FontSize="10" Foreground="#CBD5E1"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Width="250" Padding="4">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind ViewModel.Loc.ZenClockStyleLabel, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="4,2,4,4"/>
                                            <Button Command="{x:Bind ViewModel.SetZenClockStyleCommand}" CommandParameter="NothingStandBy"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="10" Height="10" Fill="#D71921"/>
                                                    <TextBlock Text="{x:Bind ViewModel.Loc.ZenClockNothingStandBy, Mode=OneWay}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.SetZenClockStyleCommand}" CommandParameter="Modern"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" FontSize="12" Foreground="#38BDF8"/>
                                                    <TextBlock Text="{x:Bind ViewModel.Loc.ZenClockModern, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.SetZenClockStyleCommand}" CommandParameter="Flip"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f2;" FontSize="12" Foreground="#F59E0B"/>
                                                    <TextBlock Text="{x:Bind ViewModel.Loc.ZenClockFlip, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.SetZenClockStyleCommand}" CommandParameter="Stacked"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf036;" FontSize="12" Foreground="#EC4899"/>
                                                    <TextBlock Text="{x:Bind ViewModel.Loc.ZenClockStacked, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{x:Bind ViewModel.SetZenClockStyleCommand}" CommandParameter="Analog"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf192;" FontSize="12" Foreground="#10B981"/>
                                                    <TextBlock Text="{x:Bind ViewModel.Loc.ZenClockAnalog, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Nút Tùy Biến Thông Tin Hiển Thị -->
                        <Button ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ZenSettingsTitle, Mode=OneWay}"
                                Background="#26FFFFFF" BorderThickness="1" BorderBrush="#38FFFFFF" CornerRadius="12" Padding="10,6">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf013;" FontSize="12" Foreground="White"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Width="280" Padding="4">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{x:Bind ViewModel.Loc.ZenSettingsTitle, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" Margin="4,2,4,4"/>
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.ZenShowSecondsLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ZenShowSeconds, Mode=OneWay}" Toggled="ZenToggleSeconds_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.ZenShowWeatherInfoLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ZenShowWeatherInfo, Mode=OneWay}" Toggled="ZenToggleWeatherInfo_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.ZenShowHourlyForecastLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ZenShowHourlyForecast, Mode=OneWay}" Toggled="ZenToggleHourly_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.ZenShowAirQualityLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ZenShowAirQuality, Mode=OneWay}" Toggled="ZenToggleAirQuality_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.ZenShowRelaxQuoteLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ZenShowRelaxQuote, Mode=OneWay}" Toggled="ZenToggleQuote_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.ZenShowAmbientSoundLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ZenShowAmbientSound, Mode=OneWay}" Toggled="ZenToggleAmbient_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Nút đóng Zen Mode -->
                        <Button Command="{x:Bind ViewModel.CloseZenModeCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ZenExitTooltip, Mode=OneWay}"
                                Background="#26FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#38FFFFFF"
                                CornerRadius="12"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="11" Foreground="White"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.CompareClose, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                <Border Background="#33FFFFFF" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="ESC" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ==================== HÀNG 1: TRỌNG TÂM ĐỒNG HỒ & THỜI TIẾT ==================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12">

                        <!-- ==================== KIỂU 0: NOTHING OS STANDBY DUAL-MATRIX (v3.6.1) ==================== -->
                        <Grid Visibility="{x:Bind ViewModel.IsZenClockNothingStandBy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              ColumnDefinitions="Auto,Auto" ColumnSpacing="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Left Matrix: Oversized Ndot77 Clock & Station Telemetry -->
                            <Border Grid.Column="0" Background="#0C0C0E" BorderBrush="#26262B" BorderThickness="1.5" CornerRadius="28" Padding="36,28" MinWidth="460">
                                <StackPanel Spacing="14" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="#D71921"/>
                                            <TextBlock Text="NOTHING STANDBY // MATRIX" FontSize="11" FontWeight="Bold" Foreground="#888890" FontFamily="Cascadia Mono, Consolas"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentDateDisplay, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="Cascadia Mono, Consolas"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,6">
                                        <TextBlock Text="{x:Bind ViewModel.ZenHourDisplay, Mode=OneWay}"
                                                   FontFamily="{StaticResource NdotFontFamily}" FontSize="118" FontWeight="Bold" Foreground="White"/>
                                        <StackPanel VerticalAlignment="Center" Spacing="18" Margin="4,0">
                                            <Ellipse Width="12" Height="12" Fill="#D71921"/>
                                            <Ellipse Width="12" Height="12" Fill="#D71921"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.ZenMinuteDisplay, Mode=OneWay}"
                                                   FontFamily="{StaticResource NdotFontFamily}" FontSize="118" FontWeight="Bold" Foreground="White"/>
                                        <Border Visibility="{x:Bind ViewModel.ZenShowSeconds, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#1F1F24" BorderBrush="#D71921" BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Bottom" Margin="8,0,0,22">
                                            <TextBlock Text="{x:Bind ViewModel.ZenSecondDisplay, Mode=OneWay}"
                                                       FontFamily="{StaticResource NdotFontFamily}" FontSize="22" FontWeight="Bold" Foreground="#D71921"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Background="#141418" BorderBrush="#242429" BorderThickness="1" CornerRadius="14" Padding="14,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontFamily="{StaticResource NdotFontFamily}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.NowcastHeadline, Mode=OneWay}" FontSize="10.5" Foreground="#A1A1AA" FontFamily="Cascadia Mono, Consolas"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#22D71921" BorderBrush="#D71921" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.NowcastBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#D71921" FontFamily="Cascadia Mono, Consolas"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Right Matrix: Nothing Circular Weather Dial & Glyph Telemetry -->
                            <Border Grid.Column="1" Background="#0C0C0E" BorderBrush="#26262B" BorderThickness="1.5" CornerRadius="28" Padding="32,28" Width="320">
                                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="190" Height="190" HorizontalAlignment="Center">
                                        <Ellipse Width="190" Height="190" Stroke="#2A2A30" StrokeThickness="2" StrokeDashArray="3,3" Fill="#111115"/>
                                        <Ellipse Width="156" Height="156" Stroke="#1E1E24" StrokeThickness="1"/>
                                        <Ellipse Width="12" Height="12" Fill="#D71921" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}"
                                                       FontFamily="{StaticResource NdotFontFamily}" FontSize="52" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#D71921" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="136" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.FeelsLikeText, Mode=OneWay}"
                                                       FontSize="10.5" Foreground="#888890" HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <Border Grid.Column="0" Background="#141418" BorderBrush="#242429" BorderThickness="1" CornerRadius="10" Padding="8,6">
                                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock Text="AQI" FontSize="9.5" Foreground="#71717A" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}" FontFamily="{StaticResource NdotFontFamily}" FontSize="14" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#141418" BorderBrush="#242429" BorderThickness="1" CornerRadius="10" Padding="8,6">
                                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock Text="WIND" FontSize="9.5" Foreground="#71717A" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontFamily="{StaticResource NdotFontFamily}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#141418" BorderBrush="#242429" BorderThickness="1" CornerRadius="10" Padding="8,6">
                                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock Text="HUM" FontSize="9.5" Foreground="#71717A" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontFamily="{StaticResource NdotFontFamily}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ==================== FLUENT 2 SPATIAL GLASS SANCTUARY ==================== -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsZenClockNothingStandBy, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">

                            <!-- KIỂU 1: MODERN GLOW CLOCK -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsZenClockModern, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ZenHourDisplay, Mode=OneWay}"
                                           FontSize="108" FontWeight="SemiBold" Foreground="White" CharacterSpacing="-20"/>
                                <TextBlock Text=":" FontSize="100" FontWeight="Light" Foreground="#7DD3FC" Margin="2,-8,2,0"/>
                                <TextBlock Text="{x:Bind ViewModel.ZenMinuteDisplay, Mode=OneWay}"
                                           FontSize="108" FontWeight="SemiBold" Foreground="White" CharacterSpacing="-20"/>
                                <StackPanel Visibility="{x:Bind ViewModel.ZenShowSeconds, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            VerticalAlignment="Bottom" Margin="10,0,0,24" Spacing="2">
                                    <Border Background="#2038BDF8" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{x:Bind ViewModel.ZenSecondDisplay, Mode=OneWay}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.ZenPeriodDisplay, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.ZenPeriodDisplay, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                               FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- KIỂU 2: RETRO FLIP CLOCK -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsZenClockFlip, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <Border Width="106" Height="116" CornerRadius="16" Background="#260F172A" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Border Height="1.5" Background="#80000000" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="{x:Bind ViewModel.ZenHourDisplay, Mode=OneWay}"
                                                   FontSize="74" FontWeight="ExtraBold" Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="14" Margin="2,0">
                                    <Ellipse Width="9" Height="9" Fill="#38BDF8"/>
                                    <Ellipse Width="9" Height="9" Fill="#38BDF8"/>
                                </StackPanel>
                                <Border Width="106" Height="116" CornerRadius="16" Background="#260F172A" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Border Height="1.5" Background="#80000000" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="{x:Bind ViewModel.ZenMinuteDisplay, Mode=OneWay}"
                                                   FontSize="74" FontWeight="ExtraBold" Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- KIỂU 3: STACKED TYPOGRAPHY CLOCK -->
                            <Grid Visibility="{x:Bind ViewModel.IsZenClockStacked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Spacing="-18">
                                    <TextBlock Text="{x:Bind ViewModel.ZenHourDisplay, Mode=OneWay}"
                                               FontSize="112" FontWeight="Black" Foreground="White"
                                               HorizontalAlignment="Center" CharacterSpacing="-30"/>
                                    <TextBlock Text="{x:Bind ViewModel.ZenMinuteDisplay, Mode=OneWay}"
                                               FontSize="112" FontWeight="Black" Foreground="#38BDF8"
                                               HorizontalAlignment="Center" CharacterSpacing="-30"/>
                                </StackPanel>
                            </Grid>

                            <!-- KIỂU 4: PRECISION ANALOG DIAL CLOCK -->
                            <Grid Visibility="{x:Bind ViewModel.IsZenClockAnalog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="230" Height="230" Stroke="#35FFFFFF" StrokeThickness="2" Fill="#1E0F172A"/>
                                <Ellipse Width="210" Height="210" Stroke="#15FFFFFF" StrokeThickness="1" Fill="#12FFFFFF"/>
                                <TextBlock Text="12" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <TextBlock Text="6" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                <TextBlock Text="3" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="9" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Grid Width="230" Height="230" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{x:Bind ViewModel.ZenAnalogHourAngle, Mode=OneWay}"/>
                                    </Grid.RenderTransform>
                                    <Border Width="6" Height="52" CornerRadius="3" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,63,0,0"/>
                                </Grid>
                                <Grid Width="230" Height="230" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{x:Bind ViewModel.ZenAnalogMinuteAngle, Mode=OneWay}"/>
                                    </Grid.RenderTransform>
                                    <Border Width="3.5" Height="78" CornerRadius="2" Background="{x:Bind ViewModel.CurrentSeasonalSkin.ZenClockHandHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,37,0,0"/>
                                </Grid>
                                <Grid Visibility="{x:Bind ViewModel.ZenShowSeconds, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Width="230" Height="230" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{x:Bind ViewModel.ZenAnalogSecondAngle, Mode=OneWay}"/>
                                    </Grid.RenderTransform>
                                    <Border Width="1.5" Height="92" CornerRadius="1" Background="{x:Bind ViewModel.CurrentSeasonalSkin.ZenAccentHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,23,0,0"/>
                                </Grid>
                                <Ellipse Width="12" Height="12" Fill="{x:Bind ViewModel.CurrentSeasonalSkin.ZenAccentHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Borderless Spatial Typography: Date, City & Weather -->
                            <TextBlock Text="{x:Bind ViewModel.CurrentDateDisplay, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" Opacity="0.88"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.ZenShowWeatherInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="58" FontWeight="ExtraBold" Foreground="White"/>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.FeelsLikeText, Mode=OneWay}" FontSize="13" Foreground="#CBD5E1" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Borderless Spatial Telemetry Strip -->
                            <StackPanel Visibility="{x:Bind ViewModel.ZenShowAirQuality, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Opacity="0.9">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="12" Foreground="#10B981"/>
                                    <TextBlock Text="AQI" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="•" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="12" Foreground="#F59E0B"/>
                                    <TextBlock Text="UV" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UvIndexText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="•" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="12" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="•" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="12" Foreground="#60A5FA"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Floating 6-Hour Forecast Strip -->
                            <ItemsControl Visibility="{x:Bind ViewModel.ZenShowHourlyForecast, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ItemsSource="{x:Bind ViewModel.ZenHourlyForecast, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HourlyForecastItem">
                                        <Border Background="#18FFFFFF" CornerRadius="14" Padding="14,8" MinWidth="74">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind TimeDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="#FDE047" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind TempDisplay}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Borderless Relaxation Quote -->
                            <TextBlock Visibility="{x:Bind ViewModel.ZenShowRelaxQuote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{x:Bind ViewModel.SeasonalZenQuote, Mode=OneWay}" FontSize="13" FontStyle="Italic" Foreground="#E2E8F0" Opacity="0.82" MaxWidth="540" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== HÀNG 2: AUTO-HIDE BOTTOM AMBIENT BAR ==================== -->
                <Border x:Name="ZenBottomChrome" Grid.Row="2"
                        Visibility="{x:Bind ViewModel.ZenShowAmbientSound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#22FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,6" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf028;" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.Loc.AmbientSoundHeader, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsAmbientSoundPlaying, Mode=OneWay}" Toggled="ZenAmbientToggle_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        <Border Width="1" Height="14" Background="#33FFFFFF" Margin="2,0"/>
                        <TextBlock Text="Tự ẩn giao diện sau 2.5s • Rê chuột để hiện • F11 / ESC để thoát" FontSize="10.5" Opacity="0.68" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Page>
