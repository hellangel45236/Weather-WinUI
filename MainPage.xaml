<Page
    x:Class="WeatherApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WeatherApp"
    xmlns:models="using:WeatherApp.Models"
    xmlns:helpers="using:WeatherApp.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,12,24,24">

        <!-- ==================== HÀNG 0: THANH ĐIỀU KHIỂN TRÊN CÙNG ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
            <!-- Logo & Tiêu đề -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="40" Height="40" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.WelcomeGreetingText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="AppSubtitleText" Text="Dự báo thời tiết &amp; Lời khuyên thông minh" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </StackPanel>

            <!-- Tìm kiếm địa điểm -->
            <Grid Grid.Column="1" MaxWidth="520" Margin="12,0" HorizontalAlignment="Stretch">
                <AutoSuggestBox x:Name="LocationSearchBox"
                                PlaceholderText="Tìm kiếm thành phố (Hà Nội, TP.HCM, Kiên Giang, Đà Lạt...)"
                                QueryIcon="Find"
                                TextMemberPath="DisplayText"
                                TextChanged="LocationSearchBox_TextChanged"
                                QuerySubmitted="LocationSearchBox_QuerySubmitted"
                                SuggestionChosen="LocationSearchBox_SuggestionChosen"
                                VerticalAlignment="Center">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:GeocodingItem">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,6">
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind DisplayText}" FontSize="11" Opacity="0.65"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <!-- Các nút chức năng & Chế độ giao diện (Dark/Light) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Nút Làm mới -->
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="Cập nhật thời tiết mới nhất">
                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="13"/>
                </Button>

                <!-- Chuyển đổi đơn vị °C / °F -->
                <Button Command="{x:Bind ViewModel.ToggleUnitCommand}"
                        ToolTipService.ToolTip="Chuyển đổi giữa °C và °F">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.UnitButtonText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Bộ chọn giao diện Sáng / Tối / Hệ thống -->
                <ComboBox x:Name="ThemeComboBox"
                          SelectedIndex="2"
                          SelectionChanged="ThemeComboBox_SelectionChanged"
                          Width="105"
                          ToolTipService.ToolTip="Chọn chế độ giao diện">
                    <ComboBoxItem Content="☀️ Sáng" Tag="light"/>
                    <ComboBoxItem Content="🌙 Tối" Tag="dark"/>
                    <ComboBoxItem Content="💻 Hệ thống" Tag="system"/>
                </ComboBox>

                <!-- Nút Bật & Quản lý Desktop Widget Đa Năng (v2.0) -->
                <DropDownButton x:Name="DesktopWidgetButton"
                                Style="{ThemeResource DefaultButtonStyle}"
                                ToolTipService.ToolTip="Bật hoặc quản lý các Widget tiện ích đa thành phố trên Desktop">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock x:Name="BtnTextWidget" Text="Widget" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="📍 Mở Widget cho vị trí hiện tại" Click="OpenCurrentCityWidget_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="➕ Tạo Widget mới cho thành phố khác..." Click="OpenCustomCityWidget_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="❌ Đóng tất cả Widget đang mở" Click="CloseAllWidgets_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

            </StackPanel>
        </Grid>

        <!-- ==================== HÀNG 1: THANH ĐỊA ĐIỂM NHANH & YÊU THÍCH (THÔNG MINH, KHÔNG TRÙNG LẶP) ==================== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- 1. Nút Vị trí GPS thực tế -->
                <Button Command="{x:Bind ViewModel.LoadCurrentLocationWeatherCommand}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,5"
                        ToolTipService.ToolTip="Bấm để lấy lại thời tiết tại vị trí GPS thực tế của bạn">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="11" Foreground="#38BDF8"/>
                        <TextBlock Text="Vị trí GPS" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Dải phân cách tinh tế -->
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" Opacity="0.5"/>

                <!-- 2. Danh sách chip địa điểm thông minh (Favorites + Thành phố phổ biến, không trùng lặp) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.QuickChips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:QuickLocationChipItem">
                            <Button Click="QuickLocationChip_Click"
                                    Tag="{x:Bind}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="11,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="10.5" Foreground="{x:Bind IconColor}"/>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== HÀNG 2: THÔNG BÁO HỆ THỐNG / CHIA SẺ ==================== -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
            <InfoBar x:Name="ShareSuccessInfoBar"
                     Severity="Success"
                     Title="📸 Đã chụp &amp; sao chép ảnh thời tiết vào Clipboard!"
                     Message="Bạn có thể nhấn Ctrl + V để dán ảnh thời tiết cực đẹp này gửi cho bạn bè qua Zalo, Messenger, Telegram..."
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Không thể cập nhật"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"/>
        </StackPanel>

        <!-- ==================== HÀNG 3: THANH TIẾN TRÌNH TẢI ==================== -->
        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                     Margin="0,0,0,12"/>

        <!-- ==================== HÀNG 4: THANH ĐIỀU HƯỚNG FLUENT NAVIGATION VIEW (VERSION 3.0.1 BETA) ==================== -->
        <NavigationView x:Name="MainNavView"
                        Grid.Row="4"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="MainNavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tổng Quan" Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Triều Cường &amp; Ngập Lụt" Tag="flood">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" Foreground="#0284C7"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Bản Đồ &amp; Radar" Tag="radar">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" Foreground="#10B981"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Đời Sống &amp; OOTD" Tag="lifestyle">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" Foreground="#EC4899"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lịch Âm Dương" Tag="calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" Foreground="#8B5CF6"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Widget Studio" Tag="widget">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" Foreground="#38BDF8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cài Đặt &amp; Giao Diện" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf013;" Foreground="#94A3B8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- NỘI DUNG CHÍNH ĐA PHÂN HỆ -->
            <Grid Margin="12,0,0,0">
                <!-- ==================== TAB 1: TỔNG QUAN (OVERVIEW) ==================== -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsOverviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,0,16,24">
                    <!-- THẺ HERO HIỂN THỊ THỜI TIẾT HIỆN TẠI VỚI HIỆU ỨNG ĐỘNG, ẢNH NỀN THÀNH PHỐ & ĐỒNG HỒ -->
                    <Border x:Name="HeroCardBorder" CornerRadius="16" Padding="0" BorderThickness="0" Background="#1E293B">
                        <Grid CornerRadius="16">
                            <!-- ẢNH NỀN THÀNH PHỐ THỜI GIAN THỰC QUA IMAGEBRUSH (TỰ ĐỘNG THEO NỘI DUNG, KHÔNG LÀM PHÌNH CARD) -->
                            <Border x:Name="CityHeroBackgroundBorder" CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush x:Name="CityHeroImageBrush" Stretch="UniformToFill" Opacity="0.38"/>
                                </Border.Background>
                            </Border>

                            <!-- LỚP PHỦ MÀU GRADIENT THEO THỜI TIẾT ĐỂ BẢO ĐẢM TƯƠNG PHẢN CHỮ HOÀN HẢO -->
                            <Border CornerRadius="16" Opacity="0.80">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{x:Bind ViewModel.CurrentWeather.HeroGradientStart, Mode=OneWay, Converter={StaticResource HexToColorConverter}}" Offset="0"/>
                                        <GradientStop Color="{x:Bind ViewModel.CurrentWeather.HeroGradientEnd, Mode=OneWay, Converter={StaticResource HexToColorConverter}}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- LỚP HIỆU ỨNG ĐỘNG (Mưa rơi, vầng nắng, sao đêm, tuyết rơi) -->
                            <Canvas x:Name="WeatherEffectsCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                            <!-- LỚP CHỚP SẤM SÉT (Khi có dông bão) -->
                            <Border x:Name="LightningFlashOverlay" Background="#99EEF2FF" Opacity="0" CornerRadius="16" IsHitTestVisible="False"/>

                            <!-- NỘI DUNG CHÍNH CỦA THẺ HERO -->
                            <StackPanel Spacing="12" Padding="22,16">

                                <!-- HÀNG 1: THÔNG TIN VỊ TRÍ & CÁC NÚT TIỆN ÍCH -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <!-- Bên trái: Vị trí & Nút yêu thích -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" Foreground="#38BDF8" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        
                                        <!-- Nút Lưu / Bỏ Yêu Thích địa điểm hiện tại -->
                                        <Button Command="{x:Bind ViewModel.ToggleFavoriteCurrentLocationCommand}"
                                                Background="#26FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Padding="8,4"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteButtonToolTip, Mode=OneWay}"
                                                VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.FavoriteIconGlyph, Mode=OneWay}" Foreground="#F43F5E" FontSize="13"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Bên phải: Các nút tiện ích nhỏ gọn (Làm mới, Chia sẻ, Thư giãn) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Nút bấm làm mới -->
                                        <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                                Background="#26FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Padding="8,4"
                                                ToolTipService.ToolTip="Bấm để làm mới dữ liệu thời tiết ngay">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UpdatedTimeText, Mode=OneWay}" FontSize="11.5" Foreground="White" Opacity="0.9"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Nút chụp & chia sẻ ảnh thời tiết -->
                                        <Button Click="ShareWeatherCardButton_Click"
                                                Background="#26FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Padding="8,4"
                                                ToolTipService.ToolTip="Chụp và sao chép ảnh thời tiết tuyệt đẹp vào Clipboard (Ctrl+V)">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf030;" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="Chia sẻ" FontSize="11.5" Foreground="White" Opacity="0.9"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Nút Bật/Tắt Âm Thanh Thiên Nhiên Thư Giãn -->
                                        <Button Command="{x:Bind ViewModel.ToggleAmbientSoundCommand}"
                                                Background="#26FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Padding="8,4"
                                                ToolTipService.ToolTip="Bật hoặc tắt âm thanh tự nhiên thư giãn (tiếng mưa/gió trắng)">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf025;" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="Thư giãn" FontSize="11.5" Foreground="White" Opacity="0.9"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- HÀNG 2: THANH THÔNG TIN THỜI GIAN, LỊCH ÂM & ĐỊNH DẠNG 12/24H (DÀN NGANG KÍNH MỜ THANH LỊCH) -->
                                <Border Background="#20FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="•" Foreground="White" Opacity="0.4" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentDateDisplay, Mode=OneWay}" FontSize="12" Foreground="White" Opacity="0.9" VerticalAlignment="Center"/>
                                            <TextBlock Text="•" Foreground="White" Opacity="0.4" VerticalAlignment="Center"/>
                                            <!-- Lịch Âm & Tiết Khí truyền thống Việt Nam -->
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LunarDateText, Mode=OneWay}" FontSize="11.5" Foreground="#FEF08A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Nút đổi định dạng 12h / 24h -->
                                        <Button Command="{x:Bind ViewModel.ToggleTimeFormatCommand}"
                                                Background="#25FFFFFF"
                                                Foreground="White"
                                                CornerRadius="6"
                                                Padding="6,2"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                ToolTipService.ToolTip="Nhấp để đổi giữa định dạng 24 Giờ và 12 Giờ (AM/PM)"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.TimeFormatLabel, Mode=OneWay}"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- TÓM TẮT THÔNG MINH ĐẦU NGÀY (AI GLANCE SUMMARY - MỚI v1.7) -->
                                <Border Background="#1AFFFFFF" CornerRadius="10" Padding="12,7" Margin="0,2,0,2">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0eb;" FontSize="12" Foreground="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.SmartSummaryText, Mode=OneWay}" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- HÀNG 3: NHIỆT ĐỘ, MÔ TẢ & ICON ĐỘNG THỜI TIẾT TỪ FOLDER -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center" Margin="0,4">
                                    <!-- Nhiệt độ lớn (nhấp chuột để đổi °C / °F nhanh) -->
                                    <Button Grid.Column="0"
                                            Command="{x:Bind ViewModel.ToggleUnitCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Nhấp vào nhiệt độ để chuyển đổi nhanh giữa °C và °F">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="54" FontWeight="ExtraBold" Foreground="White"/>
                                    </Button>

                                    <!-- Tình trạng thời tiết & Cảm giác thực tế (Có TextWrapping để không bị cắt chữ Cao nhất) -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.FeelsLikeText, Mode=OneWay}" FontSize="13" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="•" Foreground="White" Opacity="0.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.MinMaxText, Mode=OneWay}" FontSize="13" Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Huy hiệu Cảnh báo thời tiết & AQI nếu có -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <!-- Huy hiệu trạng thái thời tiết động (Dông sét, Nắng gắt UV, Mưa to) -->
                                            <Border Visibility="{x:Bind ViewModel.CurrentWeather.HasWeatherAlertBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{x:Bind ViewModel.CurrentWeather.WeatherAlertBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="8"
                                                    Padding="8,2">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WeatherAlertBadgeText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Huy hiệu Chất lượng không khí (AQI) -->
                                            <Border Visibility="{x:Bind ViewModel.CurrentWeather.HasAqi, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{x:Bind ViewModel.CurrentWeather.AqiColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="8"
                                                    Padding="8,2"
                                                    ToolTipService.ToolTip="Chất lượng không khí (US-AQI)">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="9.5" Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="AQI" FontSize="9.5" FontWeight="Bold" Foreground="White" Opacity="0.9"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- BIỂU TƯỢNG THỜI TIẾT VECTOR ĐỘNG (Trong suốt, không viền đen, lơ lửng tự nhiên) -->
                                    <Grid Grid.Column="2" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="WeatherIconFloatTransform" Y="0"/>
                                        </Grid.RenderTransform>

                                        <!-- Ảnh vector SVG trong suốt tuyệt đối, sắc nét -->
                                        <Image x:Name="WeatherSvgImage"
                                               Width="96"
                                               Height="96"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                        <!-- Biểu tượng FontAwesome dự phòng tức thì nếu chưa nạp xong SVG -->
                                        <FontIcon x:Name="FallbackWeatherIcon"
                                                  FontFamily="{StaticResource FontAwesomeSolid}"
                                                  Glyph="{x:Bind ViewModel.CurrentWeather.IconGlyph, Mode=OneWay}"
                                                  FontSize="52"
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>

                                <!-- ==================== MỤC TƯƠNG TÁC: HỎI THỜI TIẾT THỰC TẾ CÓ CHÍNH XÁC KHÔNG ==================== -->
                                <Border Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <Grid>
                                        <!-- Trạng thái 1: Chưa phản hồi và chưa mở tùy chọn sửa -->
                                        <Grid Visibility="{x:Bind ViewModel.FeedbackSubmitted, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <!-- Khi chưa bấm "Chưa đúng" -->
                                            <Grid Visibility="{x:Bind ViewModel.ShowInaccurateOptions, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf059;" Foreground="White" FontSize="14"/>
                                                    <TextBlock Text="Thời tiết thực tế có chính xác không?" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button Command="{x:Bind ViewModel.SubmitFeedbackCommand}" CommandParameter="accurate"
                                                            Background="#33FFFFFF" Foreground="White" CornerRadius="8" Padding="12,5"
                                                            ToolTipService.ToolTip="Xác nhận thời tiết đang đúng với thực tế">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf164;" FontSize="12"/>
                                                            <TextBlock Text="Chính xác" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.SubmitFeedbackCommand}" CommandParameter="inaccurate"
                                                            Background="#33FFFFFF" Foreground="White" CornerRadius="8" Padding="12,5"
                                                            ToolTipService.ToolTip="Báo cáo thời tiết thực tế khác với dự báo">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf165;" FontSize="12"/>
                                                            <TextBlock Text="Chưa đúng" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Khi đã bấm "Chưa đúng" -> Hiện 11 lựa chọn thời tiết thực tế sinh động để người dùng báo cáo -->
                                            <Grid Visibility="{x:Bind ViewModel.ShowInaccurateOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RowDefinitions="Auto,Auto">
                                                <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Thực tế ngoài trời tại bạn đang như thế nào?" FontSize="12.5" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.ResetFeedbackCommand}" Background="#25FFFFFF" Foreground="White" CornerRadius="6" Padding="8,3" FontSize="11" ToolTipService.ToolTip="Đóng danh sách báo cáo">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="9"/>
                                                            <TextBlock Text="Đóng"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2,0,4">
                                                        <!-- 1. Nắng đẹp -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Trời nắng đẹp" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Trời quang, nắng đẹp rực rỡ">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11" Foreground="#FDE047"/>
                                                                <TextBlock Text="Nắng đẹp" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 2. Nắng gắt UV -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Nắng gắt chói chang UV" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Trời nắng gắt, chỉ số UV cao">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11" Foreground="#FB923C"/>
                                                                <TextBlock Text="Nắng gắt UV" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 3. Nắng nhẹ -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Nắng nhẹ ít mây" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Trời nắng nhẹ dịu mát, ít mây">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" FontSize="11" Foreground="#38BDF8"/>
                                                                <TextBlock Text="Nắng nhẹ" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 4. Nhiều mây -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Nhiều mây u ám" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Bầu trời nhiều mây che khuất mặt trời">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c2;" FontSize="11" Foreground="#CBD5E1"/>
                                                                <TextBlock Text="Nhiều mây" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 5. Mưa phùn -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Mưa phùn nhỏ" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Mưa phùn lất phất hoặc mưa nhỏ hạt">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#7DD3FC"/>
                                                                <TextBlock Text="Mưa phùn" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 6. Đang mưa -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Đang có mưa vừa" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Đang có mưa đều hạt">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#60A5FA"/>
                                                                <TextBlock Text="Đang mưa" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 7. Mưa rất to -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Mưa rất to xối xả" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Mưa to xối xả diện rộng">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#3B82F6"/>
                                                                <TextBlock Text="Mưa rất to" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 8. Dông sét -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Dông sét sấm bão" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Có sấm sét dông giật mạnh">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf76c;" FontSize="11" Foreground="#F87171"/>
                                                                <TextBlock Text="Dông sét" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 9. Sương mù -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Sương mù dày" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Sương mù hoặc bụi mù mịt hạn chế tầm nhìn">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="11" Foreground="#E2E8F0"/>
                                                                <TextBlock Text="Sương mù" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 10. Gió to -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Gió to lốc mạnh" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Gió thổi rất mạnh, lốc giật">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="11" Foreground="#FB7185"/>
                                                                <TextBlock Text="Gió to" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- 11. Rét buốt -->
                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Rét buốt lạnh giá" Background="#40FFFFFF" Foreground="White" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Thời tiết rét buốt, nhiệt độ hạ thấp đột ngột">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2dc;" FontSize="11" Foreground="#93C5FD"/>
                                                                <TextBlock Text="Rét buốt" FontSize="11.5"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>

                                        <!-- Trạng thái 2: Đã gửi phản hồi thành công -->
                                        <Grid Visibility="{x:Bind ViewModel.FeedbackSubmitted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.FeedbackResponseText, Mode=OneWay}" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ResetFeedbackCommand}" Background="#33FFFFFF" Foreground="White" CornerRadius="8" Padding="10,3" FontSize="11" ToolTipService.ToolTip="Bấm để chọn lại">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="10"/>
                                                    <TextBlock Text="Đổi lại"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ==================== KHUNG LỜI KHUYÊN THÔNG MINH XỔ XUỐNG NGAY TRONG HERO CARD ==================== -->
                                <Border Background="#22000000" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Icon bóng đèn phát sáng -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#FFF59E0B" Margin="0,0,10,0">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0eb;" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Điểm tin lời khuyên chính -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Lời khuyên &amp; Gợi ý thông minh" FontSize="11" FontWeight="Bold" Foreground="#FDE047"/>
                                                <TextBlock Text="{x:Bind ViewModel.TopAdviceSummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Nút bật/tắt xổ xuống ngay trong Hero Card -->
                                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ToggleAdviceExpandedCommand}"
                                                    Background="#35FFFFFF" Foreground="White" CornerRadius="8" Padding="12,6" Margin="8,0,0,0"
                                                    ToolTipService.ToolTip="Bấm để xem hoặc thu gọn chi tiết 5 mục lời khuyên">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ViewModel.AdviceExpandButtonText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.AdviceExpandIconGlyph, Mode=OneWay}" FontSize="10"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- KHUNG XỔ XUỐNG CHI TIẾT 5 LỜI KHUYÊN NGAY TRONG HERO CARD -->
                                        <StackPanel Visibility="{x:Bind ViewModel.IsAdviceExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Spacing="10" Margin="0,4,0,0">
                                            <Border Height="1" Background="#35FFFFFF" Margin="0,2,0,2"/>

                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AdviceList, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="8"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:WeatherAdvice">
                                                        <Border Background="#33000000" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <!-- Icon danh mục -->
                                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                                        Background="#35FFFFFF" VerticalAlignment="Top" Margin="0,2,12,0">
                                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                                              FontSize="14" Foreground="#FDE047"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Chi tiết nội dung: Category, Badge, Title, Description -->
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Grid.Column="0" Text="{x:Bind Category}" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" CharacterSpacing="50"/>
                                                                        <Border Grid.Column="1" Background="{x:Bind BadgeBackground, Converter={StaticResource HexToBrushConverter}}" CornerRadius="5" Padding="6,2">
                                                                            <TextBlock Text="{x:Bind BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="#F1F5F9" Opacity="0.92" TextWrapping="Wrap" LineHeight="18"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>


                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- LƯỚI CHỈ SỐ CHI TIẾT THỜI TIẾT (8 CHỈ SỐ THIẾT YẾU ĐƯỢC ĐƯA LÊN TRÊN ĐỂ THẤY NGAY) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Chi Tiết Thời Tiết Hôm Nay" FontSize="16" FontWeight="Bold"/>

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="12" ColumnSpacing="12">

                                <!-- 1. Độ ẩm -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" Foreground="#0078D4" FontSize="14"/>
                                            <TextBlock Text="Độ ẩm" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Tốc độ gió -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" Foreground="#107C41" FontSize="14"/>
                                            <TextBlock Text="Gió" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindDirectionText, Mode=OneWay}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Chỉ số UV -->
                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#FF8C00" FontSize="14"/>
                                            <TextBlock Text="Chỉ số UV" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UvIndexText, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UvIndexDescription, Mode=OneWay}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Xác suất mưa -->
                                <Border Grid.Row="0" Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" Foreground="#0099BC" FontSize="14"/>
                                            <TextBlock Text="Khả năng mưa" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.RainProbabilityText, Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- 5. Áp suất khí quyển -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf14e;" Foreground="#8E8CD8" FontSize="14"/>
                                            <TextBlock Text="Áp suất" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.PressureText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- 6. Lượng mưa -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" Foreground="#00B294" FontSize="14"/>
                                            <TextBlock Text="Lượng mưa" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.PrecipitationText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- 7. Vòng Cung Mặt Trời & Mặt Trăng (Sun & Moon Arc Tracker - Mới v1.7) -->
                                <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14,10">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#FFB900" FontSize="13"/>
                                                <TextBlock Text="Mặt Trời &amp; Lặn" FontSize="11.5" Opacity="0.7"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.SunStatusText, Mode=OneWay}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                        </Grid>
                                        <!-- Canvas vẽ quỹ đạo vòm trời hình cung và vị trí mặt trời/mặt trăng hiện tại -->
                                        <Canvas x:Name="SunArcCanvas" Height="36" Margin="2,2" HorizontalAlignment="Stretch"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentWeather.SunriseText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.85"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.SunsetText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.85"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 8. Chất lượng không khí (AQI & Bụi mịn PM2.5) -->
                                <Border Grid.Row="1" Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" Foreground="#10B981" FontSize="14"/>
                                            <TextBlock Text="Không khí (AQI)" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Background="{x:Bind ViewModel.CurrentWeather.AqiColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.AqiDescription, Mode=OneWay}" 
                                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind ViewModel.CurrentWeather.AqiDescription, Mode=OneWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </StackPanel>
                    </Border>

                        <!-- THANH TUA NHANH THỜI GIAN 24 GIỜ (INTERACTIVE 24H TIME-SCRUBBER - V3.0 BETA) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18,14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" Foreground="#38BDF8" FontSize="14"/>
                                        <TextBlock Text="Tua Nhanh Dự Báo 24 Giờ" FontSize="14" FontWeight="Bold"/>
                                        <Border Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                            <TextBlock Text="{x:Bind ViewModel.ScrubbedTimeLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Click="ResetScrubberButton_Click"
                                            Visibility="{x:Bind ViewModel.IsTimeScrubbingActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            ToolTipService.ToolTip="Bấm để quay về xem thời tiết thời gian thực">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="10" Foreground="#10B981"/>
                                            <TextBlock Text="Về hiện tại" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Slider x:Name="TimeScrubberSlider"
                                        Minimum="0"
                                        Maximum="23"
                                        StepFrequency="1"
                                        TickFrequency="2"
                                        TickPlacement="BottomRight"
                                        Value="{x:Bind ViewModel.ScrubbedSliderValue, Mode=TwoWay}"
                                        ValueChanged="TimeScrubberSlider_ValueChanged"/>

                                <Grid Visibility="{x:Bind ViewModel.IsTimeScrubbingActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                      CornerRadius="10"
                                      Padding="12,8"
                                      ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.ScrubbedIconGlyph, Mode=OneWay}" FontSize="16" Foreground="#F59E0B"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScrubbedTempText, Mode=OneWay}" FontSize="16" FontWeight="ExtraBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScrubbedConditionText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Opacity="0.9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="11" Foreground="#0284C7"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScrubbedRainText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    <!-- DỰ BÁO 24 GIỜ (HOURLY FORECAST) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Dự Báo Theo Giờ (24h)" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Danh sách cuộn ngang kèm đường cong nhiệt độ 24h (Trendline Spline) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <StackPanel Orientation="Vertical" Spacing="2">
                                    <!-- ĐƯỜNG CONG NHIỆT ĐỘ 24H (SPLINE TRENDLINE) -->
                                    <Canvas x:Name="HourlyTrendlineCanvas" Height="74" HorizontalAlignment="Left"/>

                                    <!-- CÁC THẺ GIỜ DỰ BÁO -->
                                    <ItemsControl x:Name="HourlyItemsControl" ItemsSource="{x:Bind ViewModel.HourlyForecast, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:HourlyForecastItem">
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="10,12"
                                                        Width="82">
                                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                                        <TextBlock Text="{x:Bind TimeDisplay}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                                                        <!-- Icon SVG đa sắc màu từ bộ weather-icons-main -->
                                                        <Image Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center">
                                                            <Image.Source>
                                                                <SvgImageSource UriSource="{x:Bind SvgIconPath}" RasterizePixelWidth="56" RasterizePixelHeight="56"/>
                                                            </Image.Source>
                                                        </Image>
                                                        <TextBlock Text="{x:Bind TempDisplay}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                                                    Visibility="{x:Bind HasRainChance, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="9" Foreground="#0099BC"/>
                                                            <TextBlock Text="{x:Bind RainProbabilityText}" FontSize="10" Foreground="#0099BC"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- DỰ BÁO 7 NGÀY TỚI (DAILY FORECAST) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Dự Báo 7 Ngày Tới" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Danh sách theo ngày với icon FontAwesome -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DailyForecast, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DailyForecastItem">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="75,68,*,Auto,110,Auto">
                                                <!-- Tên ngày & ngày tháng -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DayName}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{x:Bind DateDisplay}" FontSize="11" Opacity="0.6"/>
                                                </StackPanel>

                                                <!-- Icon SVG đa sắc màu & Tỷ lệ mưa -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Image Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center">
                                                        <Image.Source>
                                                            <SvgImageSource UriSource="{x:Bind SvgIconPath}" RasterizePixelWidth="48" RasterizePixelHeight="48"/>
                                                        </Image.Source>
                                                    </Image>
                                                    <TextBlock Text="{x:Bind RainProbabilityText}" FontSize="11" Foreground="#0099BC" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Mô tả thời tiết -->
                                                <TextBlock Grid.Column="2" Text="{x:Bind ConditionText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0"/>

                                                <!-- Nhiệt độ Thấp nhất -->
                                                <TextBlock Grid.Column="3" Text="{x:Bind TempMinDisplay}" FontSize="12.5" Opacity="0.7" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                <!-- Thanh Đo Nhiệt Độ Tuần (Weekly Range Bar - Mới v1.7) -->
                                                <Grid Grid.Column="4" Width="96" Height="14" VerticalAlignment="Center" Margin="8,0">
                                                    <!-- Nền track thanh đo mờ -->
                                                    <Border Height="5" CornerRadius="2.5" Background="#26888888" VerticalAlignment="Center"/>
                                                    <!-- Dải gradient nhiệt độ ngày -->
                                                    <Border Height="5" CornerRadius="2.5" Width="{x:Bind BarWidth}" Margin="{x:Bind BarMarginThickness}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#38BDF8" Offset="0"/>
                                                                <GradientStop Color="#F59E0B" Offset="0.6"/>
                                                                <GradientStop Color="#EF4444" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Chấm tròn định vị nhiệt độ hiện tại (chỉ hiện cho Ngày hôm nay) -->
                                                    <Ellipse Width="8" Height="8" Fill="White" Stroke="#1E293B" StrokeThickness="1.5"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                                             Margin="{x:Bind CurrentTempDotMargin}"
                                                             Visibility="{x:Bind ShowCurrentIndicator, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>

                                                <!-- Nhiệt độ Cao nhất -->
                                                <TextBlock Grid.Column="5" Text="{x:Bind TempMaxDisplay}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
                <!-- ==================== TAB 2: TRIỀU CƯỜNG & NGẬP LỤT (FLOOD HUB) ==================== -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,0,16,24">
                        <!-- THẺ ĐỒ THỊ SÓNG BÁN NHẬT TRIỀU 24 GIỜ (V3.0 BETA) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20"
                                Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasTideData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#200284C7">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" Foreground="#0284C7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Đồ Thị Sóng Bán Nhật Triều 24 Giờ (Sông Sài Gòn &amp; Nhà Bè)" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="Mô phỏng mực nước thực tế theo chu kỳ thiên văn 2 đỉnh 2 đáy trong ngày" FontSize="11" Opacity="0.65"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#200284C7" BorderBrush="#400284C7" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.NextPeakCountdown, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Border>
                                </Grid>

                                <Border Height="190" Background="#0C000000" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Canvas x:Name="TidalSineWaveCanvas" Height="190" HorizontalAlignment="Stretch" SizeChanged="TidalSineWaveCanvas_SizeChanged"/>
                                </Border>

                                <Grid ColumnDefinitions="*,*,*,*">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="&lt;1.40m: An toàn" FontSize="11" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center"/>
                                        <TextBlock Text="1.40m: BĐ I" FontSize="11" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="#EA580C" VerticalAlignment="Center"/>
                                        <TextBlock Text="1.55m: BĐ II" FontSize="11" Opacity="0.75"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="≥1.60m: BĐ III (Ngập)" FontSize="11" Opacity="0.75"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- TÌM KIẾM TUYẾN ĐƯỜNG NGẬP NHANH (V3.0 BETA) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18,14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Tra Cứu Tuyến Đường Ngập Úng &amp; Thoát Nước" FontSize="14" FontWeight="Bold"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox x:Name="FloodSearchTextBox"
                                             PlaceholderText="Gõ tên đường (Huỳnh Tấn Phát, Nguyễn Hữu Cảnh, Thái Hà...)"
                                             TextChanged="FloodSearchTextBox_TextChanged"
                                             CornerRadius="10"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Bind ViewModel.AvailableFloodDistricts, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFloodDistrict, Mode=TwoWay}"
                                              SelectionChanged="FloodDistrictComboBox_SelectionChanged"
                                              CornerRadius="10"
                                              Width="160"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    <!-- ==================== TÍNH NĂNG MỚI v2.2.3: CẢNH BÁO NGẬP ÚNG & TRIỀU CƯỜNG ĐÔ THỊ ==================== -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <!-- Tiêu đề, Thành phố & Huy hiệu Cảnh báo mức độ rủi ro -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeBg, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                                  Glyph="{x:Bind ViewModel.UrbanFloodWarning.RiskIconGlyph, Mode=OneWay}"
                                                  FontSize="16"
                                                  Foreground="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Cảnh Báo Ngập Úng &amp; Triều Cường" FontSize="16" FontWeight="Bold"/>
                                            <Border Background="#1A0284C7" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="v2.2.3" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="9.5" Foreground="#38BDF8"/>
                                            <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.CityDisplayName, Mode=OneWay}"
                                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                            <TextBlock Text="• Giám sát hạ tầng &amp; lưu thông" FontSize="11" Opacity="0.6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Huy hiệu Trạng thái Rủi ro -->
                                <Border Grid.Column="1"
                                        Background="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeBg, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                                  Glyph="{x:Bind ViewModel.UrbanFloodWarning.RiskIconGlyph, Mode=OneWay}"
                                                  FontSize="11"
                                                  Foreground="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.RiskTitle, Mode=OneWay}"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Khung thông điệp tổng quan & Headline -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="14,10">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.Headline, Mode=OneWay}"
                                               FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.Summary, Mode=OneWay}"
                                               FontSize="11.5" Opacity="0.85" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                            </Border>

                            <!-- Lưới 2 thẻ chi tiết: Triều Cường & Thoát Nước Mưa -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <!-- Thẻ 1: Triều Cường (Hiện khi HasTideData == True) -->
                                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10"
                                        Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasTideData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" FontSize="11" Foreground="#0284C7"/>
                                                <TextBlock Text="Triều Cường Sông Sài Gòn" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{x:Bind ViewModel.UrbanFloodWarning.TideAlertColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TideAlertBadge, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.UrbanFloodWarning.CurrentTideLevelDisplay, Mode=OneWay}"
                                                       FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UrbanFloodWarning.TideStatusText, Mode=OneWay}"
                                                       FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4"/>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Đỉnh Triều Sáng" FontSize="9.5" Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TidePeakMorning, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Đỉnh Triều Chiều" FontSize="9.5" Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TidePeakEvening, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TidePhaseText, Mode=OneWay}"
                                                   FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ 1 thay thế cho Hà Nội & các thành phố không có triều: Lưu Vực Sông & Cống Thoát Nước -->
                                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10"
                                        Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasTideData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="11" Foreground="#0284C7"/>
                                            <TextBlock Text="Hạ Tầng Lưu Vực Sông" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                                        </StackPanel>

                                        <TextBlock Text="Lưu vực sông Tô Lịch, Nhuệ, Kim Ngưu" FontSize="13.5" FontWeight="Bold"/>
                                        <TextBlock Text="Đoạn kênh cống tiêu thoát chính cho nội đô" FontSize="11" Opacity="0.7"/>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4"/>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Trạm bơm Yên Sở &amp; Cửa điều tiết:" FontSize="9.5" Opacity="0.6"/>
                                            <TextBlock Text="Sẵn sàng bơm cưỡng bức khi mưa lớn" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ 2: Cường Độ Mưa & Tình Trạng Thoát Nước -->
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#38BDF8"/>
                                            <TextBlock Text="Cường Độ Mưa &amp; Thoát Nước" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.UrbanFloodWarning.RainIntensityDisplay, Mode=OneWay}"
                                                       FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UrbanFloodWarning.RainDrainageStatus, Mode=OneWay}"
                                                       FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4"/>

                                        <TextBlock Text="Đánh giá năng lực hệ thống:" FontSize="9.5" Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.RainDrainageStatus, Mode=OneWay}"
                                                   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Khuyến nghị phương tiện di chuyển (Xe máy & Ô tô) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <!-- Xe máy -->
                                <Border Grid.Column="0" Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="10" Padding="11,8">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf21c;" FontSize="11" Foreground="#F59E0B"/>
                                            <TextBlock Text="Lưu ý Xe Máy" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.MotorbikeAdvice, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.9" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ô tô -->
                                <Border Grid.Column="1" Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="10" Padding="11,8">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1b9;" FontSize="11" Foreground="#60A5FA"/>
                                            <TextBlock Text="Lưu ý Xe Ô Tô" FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.CarAdvice, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.9" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Danh sách các tuyến đường ngập trọng điểm -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasHotspotRoads, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf018;" FontSize="11" Foreground="#EC4899"/>
                                        <TextBlock Text="Tuyến Đường Trọng Điểm Cần Lưu Ý" FontSize="12" FontWeight="Bold" Opacity="0.85"/>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.HotspotRoadsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bộ lọc theo Quận/Huyện -->
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Bind ViewModel.AvailableFloodDistricts, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFloodDistrict, Mode=TwoWay}"
                                              SelectionChanged="FloodDistrictComboBox_SelectionChanged"
                                              Width="140" FontSize="11" Padding="8,3"/>
                                </Grid>

                                <!-- Danh sách tuyến đường -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayedFloodRoads, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FloodHotspotRoad">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{x:Bind SeverityColor, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderThickness="1,0,0,0"
                                                    CornerRadius="8"
                                                    Padding="12,7"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind StreetName}" FontSize="12" FontWeight="SemiBold"/>
                                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{x:Bind District}" FontSize="10" Opacity="0.75"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Note}" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                        <Border Background="{x:Bind SeverityBg, Converter={StaticResource HexToBrushConverter}}"
                                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{x:Bind EstimatedDepth}" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="{x:Bind SeverityColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Cause}" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Nút Thu gọn / Xem tất cả -->
                                <Button Command="{x:Bind ViewModel.ToggleFloodRoadsExpandedCommand}"
                                        HorizontalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.FloodRoadsExpandButtonText, Mode=OneWay}"/>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.FloodRoadsExpandIconGlyph, Mode=OneWay}" FontSize="9.5"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
                <!-- ==================== TAB 3: BẢN ĐỒ & RADAR (RADAR HUB - V3.0 BETA) ==================== -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsRadarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,0,16,24">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#2010B981">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" Foreground="#10B981" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Mô Phỏng Radar Doppler &amp; Bản Đồ Mây Mưa Tự Động" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="Quét radar đối lưu thời gian thực trong phạm vi bán kính 200km" FontSize="11" Opacity="0.65"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                        <TextBlock Text="Đang Quét 360° Realtime" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                </Grid>

                                <Border Height="320" Background="#150F172A" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Canvas x:Name="RadarSimulationCanvas" Height="320" HorizontalAlignment="Stretch" SizeChanged="RadarSimulationCanvas_SizeChanged"/>
                                </Border>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="Cường độ phản hồi dBZ:" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="8" CornerRadius="4" Margin="14,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#10B981" Offset="0"/>
                                                <GradientStop Color="#38BDF8" Offset="0.3"/>
                                                <GradientStop Color="#F59E0B" Offset="0.7"/>
                                                <GradientStop Color="#EF4444" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Mưa nhỏ" FontSize="10" Opacity="0.7"/>
                                        <TextBlock Text="→" FontSize="10" Opacity="0.5"/>
                                        <TextBlock Text="Mưa to / Dông bão" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Cấp Gió Beaufort" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindDirectionText, Mode=OneWay}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Áp Suất Khí Quyển" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.PressureText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Trạng thái ổn định" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Chỉ Số Cực Đoan" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="Bình Thường" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock Text="Không có áp thấp nhiệt đới" FontSize="11" Opacity="0.75"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <!-- ==================== TAB 4: ĐỜI SỐNG & OOTD (LIFESTYLE HUB) ==================== -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsLifestyleVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,0,16,24">
                    <!-- ==================== TÍNH NĂNG MỚI v2.1: GỢI Ý TRANG PHỤC HÔM NAY MẶC GÌ (OOTD ADVISOR) ==================== -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <!-- Tiêu đề & Chọn dịp (Công sở, Đi học, Dạo phố) -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="8" Background="#2638BDF8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="15" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Hôm Nay Mặc Gì?" FontSize="16" FontWeight="Bold"/>
                                            <Border Background="#1A10B981" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="OOTD v2.1" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.ThermalComfortNotice, Mode=OneWay}"
                                                   FontSize="11.5" Opacity="0.75" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Bộ chọn Dịp (Công sở / Đi học / Dạo phố) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="OccasionWorkButton" Click="OccasionButton_Click" Tag="Work"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White"
                                            BorderThickness="0" CornerRadius="8" Padding="9,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0b1;" FontSize="10.5"/>
                                            <TextBlock Text="Công sở" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionSchoolButton" Click="OccasionButton_Click" Tag="School"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderThickness="0" CornerRadius="8" Padding="9,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf19d;" FontSize="10.5"/>
                                            <TextBlock Text="Đi học" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionCasualButton" Click="OccasionButton_Click" Tag="Casual"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderThickness="0" CornerRadius="8" Padding="9,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf70c;" FontSize="10.5"/>
                                            <TextBlock Text="Dạo phố" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Headline nổi bật của bộ trang phục -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,*">
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf058;" FontSize="13" Foreground="#10B981" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentOutfitAdvice.Headline, Mode=OneWay}"
                                               FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Lưới 4 ô trang phục (Áo & Thân trên, Quần & Thân dưới, Áo khoác / Lớp ngoài, Giày dép) -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <!-- 1. Áo & Thân trên -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="11" Foreground="#38BDF8"/>
                                            <TextBlock Text="Áo &amp; Thân trên" FontSize="10.5" FontWeight="Bold" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.TopClothing, Mode=OneWay}"
                                                   FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Quần & Thân dưới -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf005;" FontSize="11" Foreground="#818CF8"/>
                                            <TextBlock Text="Quần &amp; Thân dưới" FontSize="10.5" FontWeight="Bold" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.BottomClothing, Mode=OneWay}"
                                                   FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Áo khoác & Che chắn -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="11" Foreground="#F59E0B"/>
                                            <TextBlock Text="Áo khoác &amp; Che chắn" FontSize="10.5" FontWeight="Bold" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Outerwear, Mode=OneWay}"
                                                   FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Giày dép -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf549;" FontSize="11" Foreground="#34D399"/>
                                            <TextBlock Text="Giày &amp; Dép" FontSize="10.5" FontWeight="Bold" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Footwear, Mode=OneWay}"
                                                   FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Checklist Phụ kiện & Vật dụng cần mang (Accessories Checklist) -->
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf468;" FontSize="11" Foreground="#60A5FA"/>
                                    <TextBlock Text="Vật Dụng &amp; Phụ Kiện Nên Mang Theo" FontSize="11.5" FontWeight="Bold" Opacity="0.8"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentOutfitAdvice.Accessories, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OutfitAccessoryItem">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderThickness="1" CornerRadius="8" Padding="9,5"
                                                    ToolTipService.ToolTip="{x:Bind Reason}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="11"
                                                              Foreground="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Cảnh báo di chuyển xe máy (Motorbike Commute Advice) -->
                            <Border Background="#15F59E0B" BorderBrush="#35F59E0B" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,*">
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}"
                                              Glyph="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarningIcon, Mode=OneWay}"
                                              FontSize="13" Foreground="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarningColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                              Margin="0,1,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarning, Mode=OneWay}"
                                               FontSize="11.5" Foreground="#FEF08A" TextWrapping="Wrap" LineHeight="17"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CHỈ SỐ HOẠT ĐỘNG NGOÀI TRỜI & ĐỜI SỐNG (LIFESTYLE INDICES - MỚI v1.7) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1ae;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="Chỉ Số Hoạt Động &amp; Đời Sống" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Khuyến nghị theo thời tiết" FontSize="11.5" Opacity="0.6" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Danh sách 4 chỉ số sinh hoạt -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LifestyleIndices, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LifestyleIndexItem">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="{x:Bind RatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                        Opacity="0.95" VerticalAlignment="Center">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                              FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13.5" FontWeight="Bold"/>
                                                    <TextBlock Text="{x:Bind Advice}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{x:Bind RatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Rating}" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- BÁO CÁO CHẤT LƯỢNG KHÔNG KHÍ & BỤI MỊN (AIR QUALITY & POLLUTION TRACKER - THUẦN XAML NATIVE) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Tiêu đề & Phân loại AQI -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="Chất Lượng Không Khí &amp; Bụi Mịn" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{x:Bind ViewModel.CurrentWeather.AqiColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="12" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf05a;" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiDescription, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Thẻ tóm tắt chỉ số AQI chính & Lời khuyên sức khỏe -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16,14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                    <!-- Vòng tròn điểm số AQI nổi bật -->
                                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                                            Background="{x:Bind ViewModel.CurrentWeather.AqiColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}"
                                                       FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="US AQI" FontSize="9" FontWeight="Bold" Foreground="White" Opacity="0.85" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Lời khuyên sức khỏe tương ứng -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiDescription, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiAdvice, Mode=OneWay}"
                                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap" LineHeight="17"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Thang đo phân cấp ô nhiễm trực quan (Visual Air Quality Spectrum Bar) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                                    <Border Grid.Column="0" Height="6" CornerRadius="3" Background="#10B981" ToolTipService.ToolTip="0 - 50: Tốt (Trong lành)"/>
                                    <Border Grid.Column="1" Height="6" CornerRadius="3" Background="#F59E0B" ToolTipService.ToolTip="51 - 100: Trung bình"/>
                                    <Border Grid.Column="2" Height="6" CornerRadius="3" Background="#EA580C" ToolTipService.ToolTip="101 - 150: Kém (Nhóm nhạy cảm)"/>
                                    <Border Grid.Column="3" Height="6" CornerRadius="3" Background="#DC2626" ToolTipService.ToolTip="151 - 200: Xấu (Có hại sức khỏe)"/>
                                    <Border Grid.Column="4" Height="6" CornerRadius="3" Background="#9333EA" ToolTipService.ToolTip="201 - 300: Rất xấu"/>
                                    <Border Grid.Column="5" Height="6" CornerRadius="3" Background="#7F1D1D" ToolTipService.ToolTip="300+: Nguy hại nghiêm trọng"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="0 - 50" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="51 - 100" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="101 - 150" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="151 - 200" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="201 - 300" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="300+" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Lưới 4 chỉ số ô nhiễm chi tiết (PM2.5, PM10, O3, NO2) -->
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                                <!-- 1. Bụi mịn PM2.5 -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Bụi mịn PM2.5" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.Pm25Text, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.Pm25Status, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 2. Bụi thô PM10 -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Bụi thô PM10" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.Pm10Text, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.Pm10Status, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 3. Khí Ozone (O₃) -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Khí Ozone (O₃)" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.OzoneText, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.OzoneStatus, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 4. Khí Nitrogen Dioxide (NO₂) -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Khí Nitơ (NO₂)" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.No2Text, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.No2Status, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- ==================== TAB 5: LỊCH ÂM DƯƠNG (CALENDAR HUB) ==================== -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsCalendarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,0,16,24">
                    <!-- ==================== 1. LỊCH THÁNG VẠN NIÊN & THỜI TIẾT (MONTHLY CALENDAR & FORECAST - MỚI v1.8) ==================== -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <!-- Tiêu đề & Thanh điều hướng Tháng / Năm đa năng -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="Lịch Tháng &amp; Dự Báo" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Opacity="0.85">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="10.5" Foreground="#38BDF8"/>
                                        <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Nút điều hướng tháng & Bộ chọn nhanh Tháng/Năm -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableMonths}"
                                              SelectedIndex="{x:Bind ViewModel.SelectedMonthIndex, Mode=TwoWay}"
                                              SelectionChanged="CalendarMonthComboBox_SelectionChanged"
                                              Width="96" Height="30" FontSize="11.5" CornerRadius="6"
                                              ToolTipService.ToolTip="Chọn tháng"/>

                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableYears}"
                                              SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}"
                                              SelectionChanged="CalendarYearComboBox_SelectionChanged"
                                              Width="76" Height="30" FontSize="11.5" CornerRadius="6"
                                              ToolTipService.ToolTip="Chọn năm"/>

                                    <Button Command="{x:Bind ViewModel.GoToTodayCommand}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderThickness="0" CornerRadius="6" Height="30" Padding="8,0"
                                            ToolTipService.ToolTip="Về tháng hiện tại">
                                        <TextBlock Text="Hôm nay" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>

                                    <!-- Nút Tháng trước -->
                                    <Button Command="{x:Bind ViewModel.PrevMonthCommand}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderThickness="0" CornerRadius="6" Width="30" Height="30" Padding="0"
                                            ToolTipService.ToolTip="Tháng trước">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf053;" FontSize="10"/>
                                    </Button>

                                    <!-- Nút Tháng sau -->
                                    <Button Command="{x:Bind ViewModel.NextMonthCommand}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderThickness="0" CornerRadius="6" Width="30" Height="30" Padding="0"
                                            ToolTipService.ToolTip="Tháng sau">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf054;" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Hàng tiêu đề các Thứ trong tuần (T2 -> CN hoặc CN -> T7 theo Cài đặt) -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CalendarDayHeaders, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   Opacity="0.75" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Lưới 42 ô ngày (6 tuần x 7 ngày) -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CalendarDays, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CalendarDayItem">
                                        <Button Click="CalendarDayCell_Click"
                                                Tag="{x:Bind}"
                                                Padding="2,3"
                                                Margin="1.5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                MinHeight="54"
                                                Background="{x:Bind IsToday, Mode=OneWay, Converter={StaticResource BoolToTodayBrushConverter}}"
                                                BorderBrush="{x:Bind IsToday, Mode=OneWay, Converter={StaticResource BoolToTodayBorderBrushConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Hàng hiển thị số ngày Dương và Âm lịch -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                                        <!-- Ngày Dương -->
                                                        <TextBlock Text="{x:Bind SolarDay}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Opacity="{x:Bind IsCurrentMonth, Mode=OneWay, Converter={StaticResource BoolToMonthOpacityConverter}}"/>
                                                        <!-- Ngày Âm -->
                                                        <TextBlock Text="{x:Bind LunarDisplay}"
                                                                   FontSize="9"
                                                                   FontWeight="{x:Bind IsSpecialLunarDay, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                                                                   Foreground="{x:Bind IsSpecialLunarDay, Mode=OneWay, Converter={StaticResource BoolToSpecialLunarBrushConverter}}"
                                                                   Opacity="0.85" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Nhãn Ngày Lễ Việt Nam nếu có -->
                                                    <Border Visibility="{x:Bind HasHoliday, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="#DC2626" CornerRadius="4" Padding="3,1" Margin="0,1" HorizontalAlignment="Center">
                                                        <TextBlock Text="{x:Bind HolidayName}" FontSize="8" FontWeight="Bold" Foreground="White"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="50" TextAlignment="Center"/>
                                                    </Border>

                                                    <!-- Dự báo thời tiết (Icon + Dải nhiệt độ) -->
                                                    <StackPanel Visibility="{x:Bind HasWeatherForecast, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3" Margin="0,1,0,0">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind WeatherIconGlyph, Mode=OneWay}"
                                                                  FontSize="9"
                                                                  Foreground="{x:Bind IsSunny, Mode=OneWay, Converter={StaticResource BoolToSunColorConverter}}"/>
                                                        <TextBlock Text="{x:Bind TempRangeText, Mode=OneWay}" FontSize="8.5" FontWeight="SemiBold" Opacity="0.9"/>
                                                    </StackPanel>

                                                    <!-- Chỉ báo Mục tiêu ngày, Sự kiện cá nhân & Cảnh báo xung đột thời tiết v2.0 -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2.5" Margin="0,1,0,0">
                                                        <TextBlock Visibility="{x:Bind HasGoal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Text="{x:Bind GoalIcon, Mode=OneWay}" FontSize="8" VerticalAlignment="Center"
                                                                   ToolTipService.ToolTip="{x:Bind GoalText, Mode=OneWay}"/>
                                                        <Ellipse Visibility="{x:Bind HasUserEvents, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                 Width="5" Height="5" Fill="#8B5CF6" ToolTipService.ToolTip="Có sự kiện / kế hoạch ghi chú"/>
                                                        <FontIcon Visibility="{x:Bind HasWeatherConflictWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf071;" FontSize="8" Foreground="#F59E0B"
                                                                  ToolTipService.ToolTip="Cảnh báo: Thời tiết xung đột với kế hoạch ngoài trời!"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Chú thích chân lịch (Legend) -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#F59E0B"/>
                                        <TextBlock Text="Mùng 1 &amp; Rằm" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#DC2626"/>
                                        <TextBlock Text="Ngày Lễ" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="8.5"/>
                                        <TextBlock Text="Mục tiêu" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#8B5CF6"/>
                                        <TextBlock Text="Ghi chú" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf071;" FontSize="9" Foreground="#F59E0B"/>
                                        <TextBlock Text="Cảnh báo thời tiết" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="💡 Bấm vào ô ngày để xem chi tiết &amp; thêm kế hoạch" FontSize="10" Opacity="0.6"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- ==================== TAB 6: WIDGET STUDIO (SHOWCASE & GHIM DESKTOP - V3.0.1 BETA) ==================== -->
                <ScrollViewer Visibility="{x:Bind ViewModel.IsWidgetVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" Padding="0,0,16,24">
                        <!-- HEADER TIÊU ĐỀ STUDIO -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#2038BDF8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" Foreground="#38BDF8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Studio Thiết Kế Desktop Widget (Bộ Sưu Tập Trực Quan)" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Chọn kiểu dáng trực quan, tinh chỉnh độ mờ Acrylic và ghim ra màn hình Desktop" FontSize="11.5" Opacity="0.65"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="8" Padding="12,5">
                                        <TextBlock Text="WinUI 3 Glass Studio" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BỘ SƯU TẬP 4 KIỂU DÁNG WIDGET TRỰC QUAN (VISUAL GALLERY MOCKUPS) -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <!-- 1. BRYAN C DYNAMIC CARD -->
                            <Border x:Name="CardWidgetBryanC" Grid.Row="0" Grid.Column="0"
                                    PointerPressed="CardWidgetBryanC_PointerPressed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="✨ Bryan C Dynamic" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeWidgetBryanC" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="Đang chọn" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Mockup Box -->
                                    <Border Height="140" CornerRadius="12" BorderBrush="#30FFFFFF" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F20F172A" Offset="0"/>
                                                <GradientStop Color="#F21E293B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Padding="14,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="13"/>
                                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="11" Opacity="0.8" Foreground="White"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Dự Báo 4 Ngày" FontSize="9.5" Opacity="0.6" Foreground="White" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border VerticalAlignment="Bottom" Background="#2E000000" CornerRadius="8" Padding="6,4">
                                                <Grid ColumnDefinitions="*,*,*,*">
                                                    <TextBlock Grid.Column="0" Text="T2 • 28°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="T3 • 29°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="T4 • 27°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="T5 • 30°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Tự động biến đổi nền bầu trời, hình học mặt trời &amp; vầng trăng theo điều kiện thực tế" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. GLASS CARD (THẺ KÍNH MỜ ACRYLIC) -->
                            <Border x:Name="CardWidgetGlassCard" Grid.Row="0" Grid.Column="1"
                                    PointerPressed="CardWidgetGlassCard_PointerPressed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🪟 Fluent Glass Card" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeWidgetGlassCard" Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <TextBlock Text="Đang chọn" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Mockup Box -->
                                    <Border Height="140" CornerRadius="12" Background="#351E293B" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="14,10">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="38" Height="38" CornerRadius="10" Background="#2038BDF8">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" Foreground="#38BDF8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="6" Padding="4,2">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="6" Padding="4,2">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
