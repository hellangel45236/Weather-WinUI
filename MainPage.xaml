                        <StackPanel x:Name="ChangelogContent_v18" Visibility="Collapsed"/>
                        <StackPanel x:Name="ChangelogContent_v17" Visibility="Collapsed"/>
                        <StackPanel x:Name="ChangelogContent_v16" Visibility="Collapsed"/>
                        <StackPanel x:Name="ChangelogContent_v15" Visibility="Collapsed"/>
                        <StackPanel x:Name="ChangelogContent_v14" Visibility="Collapsed"/>
                        <StackPanel x:Name="ChangelogContent_v13" Visibility="Collapsed"/>
