<Page
    x:Class="WeatherApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WeatherApp"
    xmlns:models="using:WeatherApp.Models"
    xmlns:helpers="using:WeatherApp.Helpers"
    xmlns:tabs="using:WeatherApp.Views.Tabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,12,24,24">

        <!-- ==================== HÀNG 0: THANH ĐIỀU KHIỂN TRÊN CÙNG ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
            <!-- Logo & Tiêu đề -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="40" Height="40" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.WelcomeGreetingText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="AppSubtitleText" Text="{x:Bind ViewModel.Loc.AppSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </StackPanel>

            <!-- Tìm kiếm địa điểm -->
            <Grid Grid.Column="1" MaxWidth="520" Margin="12,0" HorizontalAlignment="Stretch">
                <AutoSuggestBox x:Name="LocationSearchBox"
                                PlaceholderText="{x:Bind ViewModel.Loc.SearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                TextMemberPath="DisplayText"
                                TextChanged="LocationSearchBox_TextChanged"
                                QuerySubmitted="LocationSearchBox_QuerySubmitted"
                                SuggestionChosen="LocationSearchBox_SuggestionChosen"
                                VerticalAlignment="Center">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:GeocodingItem">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,6">
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind DisplayText}" FontSize="11" Opacity="0.65"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <!-- Các nút chức năng & Chế độ giao diện (Dark/Light) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Nút Làm mới -->
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.RefreshTooltip, Mode=OneWay}">
                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="13"/>
                </Button>

                <!-- Chuyển đổi đơn vị °C / °F -->
                <Button Command="{x:Bind ViewModel.ToggleUnitCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.UnitTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.UnitButtonText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Bộ chọn giao diện Sáng / Tối / Hệ thống -->
                <ComboBox x:Name="ThemeComboBox"
                          SelectedIndex="2"
                          SelectionChanged="ThemeComboBox_SelectionChanged"
                          Width="105"
                          ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ThemeTooltip, Mode=OneWay}">
                    <ComboBoxItem Content="☀️ Sáng" Tag="light"/>
                    <ComboBoxItem Content="🌙 Tối" Tag="dark"/>
                    <ComboBoxItem Content="💻 Hệ thống" Tag="system"/>
                </ComboBox>

                <!-- Nút Bật & Quản lý Desktop Widget Đa Năng (v2.0) -->
                <DropDownButton x:Name="DesktopWidgetButton"
                                Style="{ThemeResource DefaultButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.WidgetTooltip, Mode=OneWay}">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock x:Name="BtnTextWidget" Text="{x:Bind ViewModel.Loc.WidgetBtnText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="{x:Bind ViewModel.Loc.WidgetOpenCurrent, Mode=OneWay}" Click="OpenCurrentCityWidget_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.Loc.WidgetOpenCustom, Mode=OneWay}" Click="OpenCustomCityWidget_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.Loc.WidgetCloseAll, Mode=OneWay}" Click="CloseAllWidgets_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

            </StackPanel>
        </Grid>

        <!-- ==================== HÀNG 1: THANH ĐỊA ĐIỂM NHANH & YÊU THÍCH (THÔNG MINH, KHÔNG TRÙNG LẶP) ==================== -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- 1. Nút Vị trí GPS thực tế -->
                <Button Command="{x:Bind ViewModel.LoadCurrentLocationWeatherCommand}"
                        Background="{x:Bind ViewModel.GpsButtonBackground, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                        BorderBrush="{x:Bind ViewModel.GpsButtonBorderBrush, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,5"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.GpsTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="11" Foreground="#38BDF8"/>
                        <TextBlock Text="{x:Bind ViewModel.Loc.GpsLocation, Mode=OneWay}" FontSize="12" FontWeight="{x:Bind ViewModel.GpsButtonFontWeight, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <!-- Dải phân cách tinh tế -->
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" Opacity="0.5"/>

                <!-- 2. Danh sách chip địa điểm thông minh (Favorites + Thành phố phổ biến, không trùng lặp) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.QuickChips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:QuickLocationChipItem">
                            <Button Click="QuickLocationChip_Click"
                                    Tag="{x:Bind}"
                                    Background="{x:Bind ChipBackgroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                    BorderBrush="{x:Bind ChipBorderHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="11,5">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="10.5" Foreground="{x:Bind IconColor, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="{x:Bind ChipFontWeight, Mode=OneWay}" Foreground="{x:Bind ChipForegroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                    <Ellipse Width="5" Height="5" Fill="#38BDF8" Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== HÀNG 2: THÔNG BÁO HỆ THỐNG / CHIA SẺ ==================== -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
            <InfoBar x:Name="ShareSuccessInfoBar"
                     Severity="Success"
                     Title="📸 Đã chụp &amp; sao chép ảnh thời tiết vào Clipboard!"
                     Message="Bạn có thể nhấn Ctrl + V để dán ảnh thời tiết cực đẹp này gửi cho bạn bè qua Zalo, Messenger, Telegram..."
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Không thể cập nhật"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"/>
        </StackPanel>

        <!-- ==================== HÀNG 3: THANH TIẾN TRÌNH TẢI ==================== -->
        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                     Margin="0,0,0,12"/>

        <!-- ==================== HÀNG 4: THANH ĐIỀU HƯỚNG FLUENT NAVIGATION VIEW (VERSION 3.0.0) ==================== -->
        <NavigationView x:Name="MainNavView"
                        Grid.Row="4"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="MainNavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavOverview, Mode=OneWay}" Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavFlood, Mode=OneWay}" Tag="flood">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" Foreground="#0284C7"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavRadar, Mode=OneWay}" Tag="radar">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" Foreground="#10B981"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavLifestyle, Mode=OneWay}" Tag="lifestyle">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" Foreground="#EC4899"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavCalendar, Mode=OneWay}" Tag="calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" Foreground="#8B5CF6"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavWidget, Mode=OneWay}" Tag="widget">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" Foreground="#38BDF8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavSettings, Mode=OneWay}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf013;" Foreground="#94A3B8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- NỘI DUNG CHÍNH ĐA PHÂN HỆ -->
            <Grid Margin="12,0,0,0">
                <!-- ==================== TAB 1: TỔNG QUAN (OVERVIEW) ==================== -->
                <!-- ==================== TAB 1: TỔNG QUAN (OVERVIEW - Non-Lazy) ==================== -->
                <tabs:OverviewTab x:Name="TabOverview"
                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsOverviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ShareRequested="OverviewTab_ShareRequested"/>

                <!-- ==================== TAB 2: TRIỀU CƯỜNG & NGẬP LỤT (URBAN FLOOD - Lazy) ==================== -->
                <tabs:UrbanFloodTab x:Name="TabFlood"
                                    x:DeferLoadStrategy="Lazy"
                                    ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 3: RADAR THỜI TIẾT DOPPLER 360 (RADAR - Lazy) ==================== -->
                <tabs:RadarTab x:Name="TabRadar"
                               x:DeferLoadStrategy="Lazy"
                               ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsRadarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 4: ĐỜI SỐNG & OOTD (LIFESTYLE - Lazy) ==================== -->
                <tabs:LifestyleTab x:Name="TabLifestyle"
                                   x:DeferLoadStrategy="Lazy"
                                   ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsLifestyleVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 5: LỊCH ÂM DƯƠNG & SỰ KIỆN (CALENDAR - Lazy) ==================== -->
                <tabs:CalendarTab x:Name="TabCalendar"
                                  x:DeferLoadStrategy="Lazy"
                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsCalendarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 6: WIDGET STUDIO & GHIM DESKTOP (WIDGET - Lazy) ==================== -->
                <tabs:WidgetStudioTab x:Name="TabWidgetStudio"
                                      x:DeferLoadStrategy="Lazy"
                                      ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsWidgetVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 7: TRUNG TÂM CÀI ĐẶT & GIAO DIỆN (SETTINGS - Lazy) ==================== -->
                <tabs:SettingsTab x:Name="TabSettings"
                                  x:DeferLoadStrategy="Lazy"
                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsSettingsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  OpenChangelogRequested="SettingsTab_OpenChangelogRequested"
                                  ReopenOnboardingRequested="SettingsTab_ReopenOnboardingRequested"/>
            </Grid>
        </NavigationView>

        <!-- Dummy hidden SettingsDialog for code-behind compatibility -->
        <ContentDialog x:Name="SettingsDialog" Visibility="Collapsed" PrimaryButtonClick="SettingsDialog_PrimaryButtonClick" />
        <!-- ==================== KHUNG RENDER XUẤT ẢNH FULL HD GỐC (1:1 KHÔNG BỊ THU NHỎ BỞI VIEWBOX) ==================== -->
        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Grid x:Name="OffscreenExportHost" Canvas.Left="-5000" Canvas.Top="-5000">
                <!-- Container chứa layout Full HD -->
                            <Grid x:Name="SharePreviewContainer" Width="1920" Height="1080">
                                <!-- 1. KHỔ NGANG FHD (1920 × 1080) -->
                                <Grid x:Name="LandscapeCardContainer" Width="1920" Height="1080" Visibility="Visible">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,1920,1080"/>
                                    </Grid.Clip>
                                    <Border CornerRadius="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#091E3A" Offset="0"/>
                                                <GradientStop Color="#1E3C72" Offset="0.5"/>
                                                <GradientStop Color="#2A5298" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Image x:Name="FhdLandscapeCityImage" Stretch="UniformToFill" Opacity="0.18"/>
                                    <Canvas Width="1920" Height="1080" IsHitTestVisible="False">
                                        <Ellipse Width="600" Height="600" Fill="#1538BDF8" Canvas.Left="0" Canvas.Top="0"/>
                                        <Ellipse Width="550" Height="550" Fill="#15F59E0B" Canvas.Left="1370" Canvas.Top="530"/>
                                    </Canvas>

                                    <Grid Margin="64,54" RowDefinitions="Auto,*,Auto" RowSpacing="30">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                                <Border Width="56" Height="56" CornerRadius="16" Background="#33FFFFFF">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="28" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="WEATHER WINUI" FontSize="26" FontWeight="ExtraBold" Foreground="White" CharacterSpacing="50"/>
                                                    <TextBlock Text="Dự Báo Khí Tượng Chuẩn Xác • Windows 10 &amp; 11" FontSize="15" Foreground="#94A3B8" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="FhdLandscapeDateText" Text="Thứ Bảy, 03/10/2026 • 15:30" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="FhdLandscapeLunarText" Text="Âm lịch: 23 Tháng 8 (Bính Ngọ) • Thu Phân" FontSize="16" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="36">
                                            <StackPanel Grid.Column="0" Spacing="24" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="32" Foreground="#38BDF8"/>
                                                    <TextBlock x:Name="FhdLandscapeLocationText" Text="HÀ NỘI, VIỆT NAM" FontSize="46" FontWeight="Black" Foreground="White"/>
                                                </StackPanel>

                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Grid.Column="0" x:Name="FhdLandscapeTempText" Text="28°" FontSize="130" FontWeight="Black" Foreground="White" Margin="0,-20,24,-10"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                            <FontIcon x:Name="FhdLandscapeConditionIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="42" Foreground="#60A5FA"/>
                                                            <TextBlock x:Name="FhdLandscapeConditionText" Text="Mưa Phùn Dày Hạt" FontSize="36" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="FhdLandscapeFeelsLikeText" Text="Cảm giác như: 31°C • Thấp nhất: 24°C / Cao nhất: 32°C" FontSize="20" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Background="#28000000" BorderBrush="#35FFFFFF" BorderThickness="1.5" CornerRadius="20" Padding="24,18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="20" Foreground="#38BDF8"/>
                                                                <TextBlock x:Name="FhdLandscapeOotdTitle" Text="HÔM NAY MẶC GÌ? (OOTD ADVISOR) — CÔNG SỞ" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" CharacterSpacing="40"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#2510B981" CornerRadius="6" Padding="10,3">
                                                                <TextBlock x:Name="FhdLandscapeThermalTag" Text="Mát Mẻ • Dễ Chịu" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock x:Name="FhdLandscapeOotdHeadline" Text="Sơ mi cotton thoáng mát + Quần âu co giãn. Mang áo blazer mỏng phòng điều hòa."
                                                                   FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>

                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                            <StackPanel Grid.Column="0" Spacing="4">
                                                                <TextBlock Text="👕 Trang Phục &amp; Giày Dép:" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                                                                <TextBlock x:Name="FhdLandscapeOotdClothing" Text="Sơ mi cộc tay, quần âu mỏng, giày da lười thoáng khí" FontSize="16" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <TextBlock Text="🎒 Phụ Kiện Nên Mang:" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                                                                <TextBlock x:Name="FhdLandscapeOotdAccessories" Text="☂️ Ô che mưa gấp gọn • 😷 Khẩu trang N95 • 🕶️ Kính râm" FontSize="16" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Border Background="#25F59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="10" Padding="14,8">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf21c;" FontSize="18" Foreground="#F59E0B" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                                                <TextBlock x:Name="FhdLandscapeMotorbikeText" Text="⚠️ Đường trơn trượt: Nên dùng áo mưa bộ, tránh áo cánh dơi cản gió. Giữ khoảng cách phanh gấp đôi."
                                                                           FontSize="15" Foreground="#FEF08A" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                                                    <Border Grid.Row="0" Grid.Column="0" Background="#26FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,14">
                                                        <StackPanel Spacing="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="18" Foreground="#F59E0B"/>
                                                                <TextBlock Text="Tia Cực Tím (UV)" FontSize="15" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="FhdLandscapeUvText" Text="6.8 - Rất Cao" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Row="0" Grid.Column="1" Background="#26FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="18" Padding="18,14">
                                                        <StackPanel Spacing="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="18" Foreground="#10B981"/>
                                                                <TextBlock Text="Không Khí (AQI)" FontSize="15" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <TextBlock x:Name="FhdLandscapeAqiText" Text="45 - Trong Lành" FontSize="22" FontWeight="Bold" Foreground="#10B981"/>
                                                        </StackPanel>
                                                    </Border>

