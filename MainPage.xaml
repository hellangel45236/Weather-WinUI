        </ContentDialog>

        <!-- ==================== DIALOG CHI TIẾT NGÀY & THỜI TIẾT (CALENDAR DAY DETAIL DIALOG - MỚI v1.8 & v1.9) ==================== -->
        <ContentDialog x:Name="CalendarDayDetailDialog"
                       CloseButtonText="Đóng"
                       DefaultButton="Close"
                       CornerRadius="16"
                       MaxWidth="520">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <Grid Width="460" RowDefinitions="Auto,*" RowSpacing="14" Margin="0,4,0,0">
                    <!-- Tiêu đề ngày Dương & Âm lịch -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#203B82F6" Margin="0,0,14,0">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="20" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <!-- Địa điểm -->
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,2">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="10.5" Foreground="#38BDF8"/>
                                <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            </StackPanel>
                            <!-- Ngày Dương lịch -->
                            <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.DayOfWeekName, Mode=OneWay}" FontSize="13" Opacity="0.75"/>
                            <TextBlock FontSize="18" FontWeight="Bold">
                                <Run Text="{x:Bind ViewModel.SelectedCalendarDay.SolarDay, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{x:Bind ViewModel.SelectedCalendarDay.SolarMonth, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{x:Bind ViewModel.SelectedCalendarDay.SolarYear, Mode=OneWay}"/>
                            </TextBlock>
                            <!-- Ngày Âm lịch -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12.5" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold">
                                    <Run Text="🌙 Ngày"/>
                                    <Run Text="{x:Bind ViewModel.SelectedCalendarDay.LunarDay, Mode=OneWay}"/>
                                    <Run Text="Tháng"/>
                                    <Run Text="{x:Bind ViewModel.SelectedCalendarDay.LunarMonth, Mode=OneWay}"/>
                                    <Run Text="ÂL (Năm"/>
                                    <Run Text="{x:Bind ViewModel.SelectedCalendarDay.CanChiYear, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.SolarTerm, Mode=OneWay}" FontSize="10.5" Opacity="0.8"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Nội dung chính: Cảnh báo xung đột + Ngày lễ + Dự báo thời tiết + Ghi chú sự kiện -->
                    <StackPanel Grid.Row="1" Spacing="12">
                        <!-- 0. Banner Cảnh Báo Xung Đột Thời Tiết Với Kế Hoạch Ngoài Trời (MỚI v1.9) -->
                        <Border Visibility="{x:Bind ViewModel.SelectedCalendarDay.HasWeatherConflictWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#22F59E0B" BorderBrush="#80F59E0B" BorderThickness="1.5" CornerRadius="12" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F59E0B">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf071;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.WeatherConflictTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.WeatherConflictMessage, Mode=OneWay}" FontSize="12" Opacity="0.9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1. Banner Ngày Lễ Việt Nam (Nếu có) -->
                        <Border Visibility="{x:Bind ViewModel.SelectedCalendarDay.HasHoliday, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#18DC2626" BorderBrush="#80DC2626" BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#DC2626">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06b;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#DC2626" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.HolidayBadge, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.HolidayName, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="#EF4444"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.HolidayDescription, Mode=OneWay}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. Thẻ Dự Báo Thời Tiết Chi Tiết Của Ngày (Nếu nằm trong phạm vi dự báo) -->
                        <Border Visibility="{x:Bind ViewModel.SelectedCalendarDay.HasWeatherForecast, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <!-- Tiêu đề thời tiết -->
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}"
                                              Glyph="{x:Bind ViewModel.SelectedCalendarDay.WeatherIconGlyph, Mode=OneWay}"
                                              FontSize="26" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.WeatherCondition, Mode=OneWay}" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Dự báo thời tiết chi tiết" FontSize="11" Opacity="0.65"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SelectedCalendarDay.TempRangeText, Mode=OneWay}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Lưới 2 chỉ số nhanh -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <!-- Khả năng mưa -->
                                    <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="13" Foreground="#38BDF8"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Khả năng mưa" FontSize="10.5" Opacity="0.7"/>
                                                <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.RainProbabilityText, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Chỉ số UV -->
                                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="13" Foreground="#F59E0B"/>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Chỉ số UV" FontSize="10.5" Opacity="0.7"/>
                                                <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.UvText, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Thông báo nếu ngày ngoài phạm vi dự báo thời tiết -->
                        <Border Visibility="{x:Bind ViewModel.SelectedCalendarDay.HasWeatherForecast, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf05a;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="Dữ liệu thời tiết chi tiết chỉ khả dụng cho 7 ngày tới. Khi ngày này đến gần, thời tiết sẽ tự động được cập nhật."
                                           FontSize="11.5" Opacity="0.75" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 3.5. Mục Tiêu Trong Ngày (Daily Focus & Goals v2.0) -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.GoalIcon, Mode=OneWay}" FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mục Tiêu Cá Nhân Trong Ngày" FontSize="13.5" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1810B981" CornerRadius="6" Padding="6,2"
                                            Visibility="{x:Bind ViewModel.SelectedCalendarDay.HasGoal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Đã đặt mục tiêu" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981"/>
                                    </Border>
                                </Grid>

                                <!-- Khung hiển thị mục tiêu hiện tại nếu có -->
                                <Border Visibility="{x:Bind ViewModel.SelectedCalendarDay.HasGoal, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="12,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind ViewModel.SelectedCalendarDay.IsGoalCompleted, Mode=OneWay}"
                                                  Click="GoalCompletedCheckBox_Click" Margin="0" MinWidth="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedCalendarDay.GoalText, Mode=OneWay}"
                                                   TextDecorations="{x:Bind ViewModel.SelectedCalendarDay.IsGoalCompleted, Mode=OneWay, Converter={StaticResource BoolToStrikeConverter}}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Column="2" Click="DeleteGoalButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,4" ToolTipService.ToolTip="Xóa mục tiêu">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2ed;" FontSize="11" Foreground="#EF4444"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Form đặt / sửa mục tiêu mới -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="DayGoalInputTextBox" PlaceholderText="VD: Chạy bộ 5km, Đọc 30 trang sách, Uống 2L nước..." FontSize="12" CornerRadius="6"
                                             Text="{x:Bind ViewModel.SelectedCalendarDay.GoalText, Mode=OneWay}"/>
                                    <Button Grid.Column="1" x:Name="SaveGoalButton" Click="SaveGoalButton_Click" Style="{ThemeResource AccentButtonStyle}" Height="34" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🎯" FontSize="12"/>
                                            <TextBlock Text="Đặt Mục Tiêu" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Gợi ý mục tiêu nhanh -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Click="QuickGoalChip_Click" Tag="🏃 Tập thể dục 30 phút" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" CornerRadius="6">
                                            <TextBlock Text="🏃 Tập thể dục 30p" FontSize="11"/>
                                        </Button>
                                        <Button Click="QuickGoalChip_Click" Tag="💧 Uống đủ 2L nước" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" CornerRadius="6">
                                            <TextBlock Text="💧 Uống 2L nước" FontSize="11"/>
                                        </Button>
                                        <Button Click="QuickGoalChip_Click" Tag="📚 Đọc sách 20 phút" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" CornerRadius="6">
                                            <TextBlock Text="📚 Đọc sách 20p" FontSize="11"/>
                                        </Button>
                                        <Button Click="QuickGoalChip_Click" Tag="🧘 Thiền &amp; thư giãn 15 phút" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" CornerRadius="6">
                                            <TextBlock Text="🧘 Thiền 15p" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- 4. Danh Sách & Thêm Kế Hoạch / Ghi Chú Cá Nhân (MỚI v1.9) -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel Spacing="10">
                                <!-- Tiêu đề & Đếm số sự kiện -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf02b;" FontSize="13" Foreground="#8B5CF6"/>
                                        <TextBlock Text="Kế Hoạch &amp; Ghi Chú Cá Nhân" FontSize="13.5" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#228B5CF6" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCalendarDay.UserEventCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6"/>
                                    </Border>
                                </Grid>

                                <!-- Danh sách sự kiện đã có của ngày -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedCalendarDay.UserEvents, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CalendarUserEvent">
                                            <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10,7" Margin="0,2">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <!-- Category Badge -->
                                                    <Border Grid.Column="0" Background="{x:Bind ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Category}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <!-- Tiêu đề + Giờ + Nhắc nhở + Tag Ngoài trời -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <Border Visibility="{x:Bind HasSpecificTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Background="#223B82F6" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{x:Bind TimeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                                            </Border>
                                                            <Border Visibility="{x:Bind HasSpecificTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Background="#228B5CF6" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{x:Bind ReminderDisplay}" FontSize="9.5" Foreground="#8B5CF6"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="🌲 Hoạt động ngoài trời (có cảnh báo thời tiết)" FontSize="10" Foreground="#10B981" Visibility="{x:Bind IsOutdoor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <!-- Nút xóa -->
                                                    <Button Grid.Column="2" Click="DeleteEventButton_Click" Tag="{x:Bind Id}"
                                                            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,4" ToolTipService.ToolTip="Xóa ghi chú này">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2ed;" FontSize="11" Foreground="#EF4444"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Form thêm ghi chú mới -->
                                <Expander Header="Thêm kế hoạch mới cho ngày này" HorizontalAlignment="Stretch" Padding="0" CornerRadius="8" Margin="0,4,0,0">
                                    <StackPanel Spacing="8" Padding="10">
                                        <TextBox x:Name="NewEventTitleBox" PlaceholderText="Nhập tên sự kiện (VD: Đi dã ngoại, Họp lớp...)" FontSize="12" CornerRadius="6"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="NewEventCategoryComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="11.5" CornerRadius="6">
                                                <ComboBoxItem Content="🌲 Ngoài trời / Dã ngoại" Tag="Ngoài trời"/>
                                                <ComboBoxItem Content="💼 Công việc / Học tập" Tag="Công việc"/>
                                                <ComboBoxItem Content="👥 Gia đình / Bạn bè" Tag="Gia đình"/>
                                                <ComboBoxItem Content="🏃 Thể thao / Rèn luyện" Tag="Thể thao"/>
                                                <ComboBoxItem Content="🎉 Kỷ niệm / Tiệc tùng" Tag="Kỷ niệm"/>
                                            </ComboBox>
                                            <CheckBox x:Name="NewEventIsOutdoorCheckBox" Grid.Column="1" Content="Ngoài trời" IsChecked="True" FontSize="11.5"/>
                                        </Grid>

                                        <!-- Giờ sự kiện & Nhắc nhở trước (v2.0) -->
                                        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="8">
                                            <CheckBox x:Name="NewEventHasTimeCheckBox" Content="Có giờ cụ thể" IsChecked="True" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TimePicker x:Name="NewEventTimePicker" Grid.Column="1" ClockIdentifier="24HourClock" Header="Thời gian" FontSize="11" HorizontalAlignment="Stretch"/>
                                            <ComboBox x:Name="NewEventReminderComboBox" Grid.Column="2" Header="Nhắc nhở trước" SelectedIndex="2" HorizontalAlignment="Stretch" FontSize="11">
                                                <ComboBoxItem Content="Không nhắc" Tag="0"/>
                                                <ComboBoxItem Content="Trước 15 phút" Tag="15"/>
                                                <ComboBoxItem Content="Trước 30 phút" Tag="30"/>
                                                <ComboBoxItem Content="Trước 1 giờ" Tag="60"/>
                                                <ComboBoxItem Content="Trước 2 giờ" Tag="120"/>
                                                <ComboBoxItem Content="Trước 1 ngày" Tag="1440"/>
                                            </ComboBox>
                                        </Grid>

                                        <Button x:Name="SaveEventButton" Click="SaveEventButton_Click" Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch" Height="34" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c7;" FontSize="11"/>
                                                <TextBlock Text="Lưu Kế Hoạch 📌" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </ContentDialog>

        <!-- ==================== TÍNH NĂNG MỚI v2.1: DIALOG CHIA SẺ THỜI TIẾT FULL HD (1080p+) ==================== -->
        <ContentDialog x:Name="ShareCardDialog"
                       Title="📸 Chia Sẻ Thẻ Thời Tiết Full HD (1080p)"
                       CloseButtonText="Đóng"
                       DefaultButton="None"
                       CornerRadius="16">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
            </ContentDialog.Resources>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Width="680" MaxHeight="580">
                <!-- Chọn định dạng & Tùy chọn -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Định dạng ảnh:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <RadioButton x:Name="ShareFormatLandscapeRadio" Content="🖥️ Khổ Ngang FHD (1920 × 1080)" IsChecked="True" Checked="ShareFormatRadio_Checked" GroupName="ShareFhdGroup" FontSize="12"/>
                        <RadioButton x:Name="ShareFormatStoryRadio" Content="📱 Khổ Dọc Story (1080 × 1920)" Checked="ShareFormatRadio_Checked" GroupName="ShareFhdGroup" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- KHUNG XEM TRƯỚC SẮC NÉT (WYSIWYG LIVE PREVIEW) -->
                <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" Padding="8" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="480" MinHeight="270">
                    <Grid MaxWidth="650" MaxHeight="380">
                        <Image x:Name="SharePreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ProgressRing x:Name="SharePreviewProgressRing" IsActive="False" Visibility="Collapsed" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Nút thao tác dưới cùng -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="✨ Độ phân giải gốc Full HD siêu nét, tối ưu cho Zalo, Facebook, Story." FontSize="11.5" Opacity="0.7" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Click="CopyFhdShareCardButton_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c5;" FontSize="13"/>
                            <TextBlock Text="Sao chép ảnh Full HD" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="SaveFhdShareCardButton_Click" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c7;" FontSize="13"/>
                            <TextBlock Text="Lưu file ảnh (.png)" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ContentDialog>

    </Grid>
</Page>