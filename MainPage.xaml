<Page
    x:Class="WeatherApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WeatherApp"
    xmlns:models="using:WeatherApp.Models"
    xmlns:helpers="using:WeatherApp.Helpers"
    xmlns:tabs="using:WeatherApp.Views.Tabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <Grid>
        <!-- ==================== ATMOSPHERIC SPATIAL AURORA BACKDROP (VERSION 3.7.0 - 100% WIN10 & WIN11) ==================== -->
        <Grid x:Name="SpatialAuroraBackdropGrid"
              Visibility="{x:Bind ViewModel.IsSpatialGlassDesign, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="False">
            <Border x:Name="SpatialBackdropBaseBorder">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="SpatialGradStop1" Color="#050914" Offset="0.0"/>
                        <GradientStop x:Name="SpatialGradStop2" Color="#0C1938" Offset="0.48"/>
                        <GradientStop x:Name="SpatialGradStop3" Color="#07223B" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Ambient Glowing Aurora Orbs (Cross-Version XAML Radial Gradients for Windows 10 & 11) -->
            <Ellipse x:Name="SpatialOrbCyan" Width="760" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-140,0,0" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4538BDF8" Offset="0.0"/>
                        <GradientStop Color="#180EA5E9" Offset="0.55"/>
                        <GradientStop Color="#000EA5E9" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="SpatialOrbViolet" Width="780" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-160" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#40A855F7" Offset="0.0"/>
                        <GradientStop Color="#156366F1" Offset="0.55"/>
                        <GradientStop Color="#006366F1" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="SpatialOrbEmerald" Width="620" Height="440" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="180,40,0,0" Opacity="0.4">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#3210B981" Offset="0.0"/>
                        <GradientStop Color="#1014B8A6" Offset="0.55"/>
                        <GradientStop Color="#0014B8A6" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- NỘI DUNG CHÍNH CỦA ỨNG DỤNG -->
        <Grid x:Name="MainContentGrid" RowDefinitions="Auto,Auto,Auto,*" Margin="24,12,24,18">

        <!-- ==================== HÀNG 0: UNIFIED SINGLE-ROW COMMAND HEADER (VERSION 3.7.0) ==================== -->
        <Border Grid.Row="0"
                x:Name="FloatingIslandHeader"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12,8"
                Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <!-- LEFT: App Emblem + v3.7 Badge + Smart Pinned Favorites Strip (GPS + 4 Pinned + All Flyout) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="30" Height="30" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="AppSubtitleText" Visibility="Collapsed"/>

                    <!-- Clickable Version Badge (Opens v3.7.0 Changelog) -->
                    <Button Click="HeaderChangelogButton_Click"
                            Visibility="{x:Bind ViewModel.IsFluent2Design, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="7,3" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Weather WinUI v3.7.0 — Bấm để xem tính năng mới">
                        <TextBlock Text="{x:Bind ViewModel.DesignBadgeText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                    </Button>
                    <Button Click="HeaderChangelogButton_Click"
                            Visibility="{x:Bind ViewModel.IsNothingDesign, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#D71921" BorderThickness="0" CornerRadius="8" Padding="7,3" VerticalAlignment="Center"
                            ToolTipService.ToolTip="NOTHING EDITION // v3.7.0 — Click for Release Notes">
                        <TextBlock Text="NDOT // 3.7.0" FontSize="9.5" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource NdotFontFamily}"/>
                    </Button>

                    <!-- 3-Way Design Language Quick Switcher (Fluent 2 / Spatial Glass 3.7 / Nothing OS 3.7) -->
                    <Button x:Name="DesignSwitcherBtn"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="7,3" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Chuyển đổi nhanh 3 Hệ Ngôn Ngữ Thiết Kế (Fluent 2 • Spatial Vision 3.7 • Nothing OS 3.7)">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf53f;" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf107;" FontSize="8.5" Opacity="0.65"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="DesignSwitcherFlyout" Placement="BottomEdgeAlignedLeft">
                                <Border Width="290" Padding="4">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="✨ NGÔN NGỮ THIẾT KẾ (DESIGN SYSTEM 3.7)" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="6,2,6,4"/>
                                        <Button Click="QuickCommand_Click" Tag="fluent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="🌊" FontSize="13"/>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Fluent 2 (Mica &amp; Acrylic)" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="Giao diện chuẩn Windows 11 &amp; 4 Mùa Lễ Hội" FontSize="10.5" Opacity="0.65"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="spatial" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="🔮" FontSize="13"/>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Spatial Vision (Aurora Glass 3.7)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    <TextBlock Text="Kính quang phổ đa lớp &amp; Viền Specular Rim" FontSize="10.5" Opacity="0.65"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="nothing" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⚫" FontSize="13"/>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Nothing OS 3.7 (Dot-Matrix &amp; Live LED)" FontSize="12" FontWeight="Bold" Foreground="#D71921"/>
                                                    <TextBlock Text="Ma trận điểm 13×13 tương tác &amp; Ndot77" FontSize="10.5" Opacity="0.65"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.35" Margin="4,2"/>
                                        <Button Click="QuickCommand_Click" Tag="eink" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="📄" FontSize="12"/>
                                                <TextBlock Text="Nothing E-Ink Paper Mode (#F4F1EA)" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" Opacity="0.5"/>

                    <!-- 1. GPS Pill -->
                    <Button Command="{x:Bind ViewModel.LoadCurrentLocationWeatherCommand}"
                            Background="{x:Bind ViewModel.GpsButtonBackground, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                            BorderBrush="{x:Bind ViewModel.GpsButtonBorderBrush, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="9,4"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.GpsTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="GpsButtonIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="10.5" Foreground="{x:Bind ViewModel.GpsIconForegroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                            <TextBlock Text="GPS" FontSize="11" FontWeight="{x:Bind ViewModel.GpsButtonFontWeight, Mode=OneWay}" Foreground="{x:Bind ViewModel.GpsButtonForeground, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                            <Ellipse Width="4.5" Height="4.5" Fill="{x:Bind ViewModel.GpsIconForegroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Pinned 4 City Pills (0ms Instant Switch) -->
                    <ItemsControl x:Name="PinnedCitiesItemsControl" ItemsSource="{x:Bind ViewModel.PinnedQuickChips, Mode=OneWay}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickLocationChipItem">
                                <Button Click="QuickLocationChip_Click"
                                        Tag="{x:Bind}"
                                        Background="{x:Bind ChipBackgroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                        BorderBrush="{x:Bind ChipBorderHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="9,4">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="9.5" Foreground="{x:Bind IconColor, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="11" FontWeight="{x:Bind ChipFontWeight, Mode=OneWay}" Foreground="{x:Bind ChipForegroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" MaxWidth="92" TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Width="4" Height="4" Fill="{x:Bind IconColor, Mode=OneWay}" Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 3. All Cities Flyout Button (+ / 12 Cities) -->
                    <Button x:Name="AllCitiesFlyoutBtn"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4"
                            ToolTipService.ToolTip="Danh sách toàn bộ thành phố yêu thích &amp; phổ biến">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;" FontSize="9.5" Opacity="0.75"/>
                            <TextBlock Text="12" FontSize="10.5" FontWeight="Bold" Opacity="0.75" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Border Width="310" Padding="4">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock Text="CHỌN NHANH THÀNH PHỐ (0MS CACHE)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        </StackPanel>
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.QuickChips, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:QuickLocationChipItem">
                                                        <Button Click="QuickLocationChip_Click"
                                                                Tag="{x:Bind}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="{x:Bind ChipBackgroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{x:Bind ChipBorderHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="10,6">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="11" Foreground="{x:Bind IconColor, Mode=OneWay}"/>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="12" FontWeight="{x:Bind ChipFontWeight, Mode=OneWay}" Foreground="{x:Bind ChipForegroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{x:Bind IconColor, Mode=OneWay}" Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- CENTER: Unified Command Capsule (City Search + Ctrl+K Quick Command Palette) -->
                <Grid Grid.Column="1" HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <AutoSuggestBox x:Name="LocationSearchBox"
                                    Grid.Column="0"
                                    MinWidth="160"
                                    PlaceholderText="Tìm thành phố hoặc gõ > lệnh (Ctrl+K)..."
                                    QueryIcon="Find"
                                    TextMemberPath="DisplayText"
                                    TextChanged="LocationSearchBox_TextChanged"
                                    QuerySubmitted="LocationSearchBox_QuerySubmitted"
                                    SuggestionChosen="LocationSearchBox_SuggestionChosen"
                                    VerticalAlignment="Center">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GeocodingItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,6">
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind DisplayText}" FontSize="11" Opacity="0.65"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <!-- Quick Command Palette Button (Ctrl+K) -->
                    <Button x:Name="CommandPaletteBtn"
                            Grid.Column="1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,5"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Bảng Lệnh Nhanh Command Palette (Ctrl + K)">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf120;" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="Bold" Opacity="0.8" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="CommandPaletteFlyout" Placement="Bottom">
                                <Border Width="320" Padding="4">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,4">
                                            <TextBlock Grid.Column="0" Text="⚡ COMMAND PALETTE (CTRL + K)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock Grid.Column="1" Text="v3.7.0" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                        </Grid>
                                        <Button Click="QuickCommand_Click" Tag="spatial" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="🔮" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Giao diện Spatial Vision (Aurora Glass 3.7)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; spatial" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="nothing" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="⚫" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Chuyển giao diện Nothing OS 3.7 (Dot-Matrix)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; nothing" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="fluent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="🌊" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Chuyển giao diện Fluent 2 (Mica Glass)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; fluent" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="eink" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="📄" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Nothing E-Ink Warm Paper Mode (#F4F1EA)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; eink" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="dock" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="🧭" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Đổi điều hướng: Floating Bottom Dock ⇄ Sidebar" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; dock" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="dark" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="🌙" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Chế độ Nền Tối (OLED Dark Mode)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; dark" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="light" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="☀️" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Chế độ Nền Sáng (Chalk Light Mode)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; light" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.35" Margin="4,2"/>
                                        <Button Click="QuickCommand_Click" Tag="zen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="🧘" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Bật Zen Mode 2.0 &amp; Nothing StandBy" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="F11" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="pomodoro" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="⏱️" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Bắt đầu Tập trung Pomodoro (25 phút)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; focus" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="widget" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="🏝️" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="Mở Studio Widget 3.7 (Spatial &amp; Strip)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; widget" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                        <Button Click="QuickCommand_Click" Tag="duel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="⚔️" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="So sánh Thời tiết Đối đầu (Weather Duel)" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="&gt; duel" FontSize="10" Opacity="0.55" FontFamily="Cascadia Mono, Consolas"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- RIGHT: Minimal Action Pills (Zen, Refresh, Unit, Seasonal/Glyph, Widget) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Zen Mode 2.0 Button -->
                    <Button x:Name="ZenButton"
                            Command="{x:Bind ViewModel.ToggleZenModeCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ZenModeTooltip, Mode=OneWay}"
                            Background="{ThemeResource ZenButtonBackgroundBrush}"
                            BorderBrush="{ThemeResource ZenButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="ZenButtonIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" FontSize="12" Foreground="{ThemeResource ZenButtonForegroundBrush}"/>
                            <TextBlock x:Name="ZenButtonText" Text="Zen" FontWeight="SemiBold" FontSize="11.5" Foreground="{ThemeResource ZenButtonForegroundBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{x:Bind ViewModel.RefreshCommand}"
                            CornerRadius="12"
                            Padding="9,5"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.RefreshTooltip, Mode=OneWay}">
                        <FontIcon x:Name="RefreshButtonIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="12"/>
                    </Button>

                    <!-- Unit °C / °F Button -->
                    <Button Command="{x:Bind ViewModel.ToggleUnitCommand}"
                            CornerRadius="12"
                            Padding="9,5"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.UnitTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="UnitButtonIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="11.5"/>
                            <TextBlock Text="{x:Bind ViewModel.UnitButtonText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Seasonal Skin Selector (Fluent 2) -->
                    <Button x:Name="SeasonalThemeButton"
                            Visibility="{x:Bind ViewModel.IsFluent2Design, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Thay áo giao diện theo 4 Mùa &amp; 4 Đại Lễ Hội"
                            Background="{x:Bind ViewModel.CurrentSeasonalSkin, Mode=OneWay, Converter={StaticResource SeasonalSkinToAdaptiveBackgroundConverter}}"
                            BorderBrush="{x:Bind ViewModel.CurrentSeasonalSkin.BorderStrokeHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentSeasonalSkin.BadgeEmoji, Mode=OneWay}" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SeasonalThemeBtnText" Text="{x:Bind ViewModel.CurrentSeasonalSkin.DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{x:Bind ViewModel.CurrentSeasonalSkin, Mode=OneWay, Converter={StaticResource SeasonalSkinToAdaptiveForegroundConverter}}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Width="260" Padding="4">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="CHỦ ĐỀ 4 MÙA &amp; ĐẠI LỄ HỘI" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="6,2,6,4"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="📅 Tự Động Theo Lịch &amp; Tiết Khí"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Tet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="🧧 Tết Cổ Truyền (Hoàng Kim)"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="MidAutumn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="🥮 Tết Trung Thu (Dạ Nguyệt)"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Christmas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="🎄 Giáng Sinh &amp; Năm Mới"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Halloween" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="🎃 Lễ Hội Halloween"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Spring" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="🌸 Mùa Xuân (Spring Bloom)"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Summer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="☀️ Mùa Hạ (Tropical Oasis)"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Autumn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="🍁 Mùa Thu (Amber Romance)"/>
                                        <Button Click="SeasonalSkinItem_Click" Tag="Winter" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" CornerRadius="8" Content="❄️ Mùa Đông (Nordic Aurora)"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Nothing OS Glyph Status Pill + E-Ink Quick Toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.IsNothingDesign, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center">
                        <Button Click="HeaderEInkToggle_Click"
                                Background="{ThemeResource NothingPillBackgroundBrush}"
                                BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.NothingEInkToggleText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#D71921"/>
                                <TextBlock Text="E-INK" FontSize="9.5" FontWeight="Bold" Foreground="{ThemeResource NothingTextPrimaryBrush}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="NothingGlyphBadgeBorder" Background="{ThemeResource NothingPillBackgroundBrush}"
                                BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse Width="5.5" Height="5.5" Fill="{ThemeResource NothingGreenBrush}"/>
                                <TextBlock x:Name="NothingGlyphBadgeText" Text="GLYPH // 3.7.0" FontSize="10" FontWeight="Bold"
                                           Foreground="{ThemeResource NothingTextPrimaryBrush}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Layout Toggle Pill (Floating Dock <-> Left Sidebar) -->
                    <Button Click="HeaderNavLayoutToggle_Click"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,5"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.DockToggleTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0db;" FontSize="10.5" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <TextBlock x:Name="DockToggleText" Text="{x:Bind ViewModel.NavigationLayoutBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Opacity="0.82" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                        </StackPanel>
                    </Button>

                    <!-- Desktop Widget Quick Menu -->
                    <DropDownButton x:Name="DesktopWidgetButton"
                                    Style="{ThemeResource DefaultButtonStyle}"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Loc.WidgetTooltip, Mode=OneWay}">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="DesktopWidgetButtonIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock x:Name="BtnTextWidget" Text="{x:Bind ViewModel.Loc.WidgetBtnText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="{x:Bind ViewModel.Loc.WidgetOpenCurrent, Mode=OneWay}" Click="OpenCurrentCityWidget_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.Loc.WidgetOpenCustom, Mode=OneWay}" Click="OpenCustomCityWidget_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="{x:Bind ViewModel.Loc.WidgetCloseAll, Mode=OneWay}" Click="CloseAllWidgets_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== HNG 1: THNG BO H? TH?NG / CHIA S? ==================== -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <InfoBar x:Name="ShareSuccessInfoBar"
                     Severity="Success"
                     Title="{x:Bind ViewModel.Loc.ShareSuccessTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Loc.ShareSuccessMessage, Mode=OneWay}"
                     IsOpen="False"
                     IsClosable="True"/>

            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="{x:Bind ViewModel.Loc.ErrorTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"/>
        </StackPanel>

        <!-- ==================== HNG 2: THANH TI?N TRNH T?I ==================== -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Height="2.5"
                     CornerRadius="1.2"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                     Margin="0,0,0,8"/>

        <!-- ==================== HÀNG 3: THANH ĐIỀU HƯỚNG FLUENT NAVIGATION VIEW & FLOATING SPATIAL DOCK (VERSION 3.7.0) ==================== -->
        <Grid Grid.Row="3">
        <NavigationView x:Name="MainNavView"
                        PaneDisplayMode="Left"
                        IsPaneVisible="{x:Bind ViewModel.IsLeftSidebarMode, Mode=OneWay}"
                        OpenPaneLength="216"
                        CompactPaneLength="52"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="MainNavView_SelectionChanged">
            <NavigationView.Resources>
                <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
                <CornerRadius x:Key="NavigationViewItemCornerRadius">10</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="overview" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavOverviewIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="138">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.NavOverview, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <Border x:Name="NavOverviewBadgeBorder" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <TextBlock x:Name="NavOverviewBadgeText" Text="{x:Bind ViewModel.NavOverviewTempText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Opacity="0.85" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NavTempBadgeForegroundBrush}"/>
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="flood">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavFloodIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" Foreground="#0284C7"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.HasFloodAlert, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Style="{ThemeResource AttentionDotInfoBadgeStyle}"/>
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Content>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="138">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.NavFlood, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <Border x:Name="NavFloodBadgeBorder" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <TextBlock x:Name="NavFloodBadgeText" Text="{x:Bind ViewModel.NavFloodTideText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Opacity="0.72" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NavFloodBadgeForegroundBrush}"/>
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="radar">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavRadarIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" Foreground="#10B981"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="138">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.NavRadar, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <Border x:Name="NavRadarBadgeBorder" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NavRadarBadgeText" Text="{x:Bind ViewModel.NavRadarStatusText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Opacity="0.8" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NavRadarBadgeForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="lifestyle">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavLifestyleIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" Foreground="#EC4899"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="138">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.NavLifestyle, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <Border x:Name="NavLifestyleBadgeBorder" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <TextBlock x:Name="NavLifestyleBadgeText" Text="{x:Bind ViewModel.NavLifestyleOotdText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Opacity="0.72" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NavLifestyleBadgeForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="54"/>
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavCalendarIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" Foreground="#8B5CF6"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="138">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.NavCalendar, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <Border x:Name="NavCalendarBadgeBorder" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <TextBlock x:Name="NavCalendarBadgeText" Text="{x:Bind ViewModel.NavLunarDateText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Opacity="0.72" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NavCalendarBadgeForegroundBrush}"/>
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="widget">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavWidgetIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" Foreground="#38BDF8"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Width="138">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.NavWidget, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                            <Border x:Name="NavWidgetBadgeBorder" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" CornerRadius="6" Padding="4,1">
                                <TextBlock x:Name="NavWidgetBadgeText" Text="3.0" FontSize="9.5" FontWeight="Bold" Opacity="0.75" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NavWidgetBadgeForegroundBrush}"/>
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind ViewModel.Loc.NavSettings, Mode=OneWay}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="NavSettingsIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf013;" Foreground="#94A3B8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- NỘI DUNG CHÍNH ĐA PHÂN HỆ -->
            <Grid x:Name="NavContentRootGrid" Margin="0,0,0,80">
                <!-- ==================== TAB 1: TỔNG QUAN (OVERVIEW - Non-Lazy) ==================== -->
                <tabs:OverviewTab x:Name="TabOverview"
                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsOverviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ShareRequested="OverviewTab_ShareRequested"/>

                <!-- ==================== TAB 2: TRIỀU CƯỜNG & NGẬP LỤT (URBAN FLOOD - Lazy) ==================== -->
                <tabs:UrbanFloodTab x:Name="TabFlood"
                                    x:DeferLoadStrategy="Lazy"
                                    ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsFloodVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 3: RADAR THỜI TIẾT DOPPLER 360 (RADAR - Lazy) ==================== -->
                <tabs:RadarTab x:Name="TabRadar"
                               x:DeferLoadStrategy="Lazy"
                               ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsRadarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 4: ĐỜI SỐNG & OOTD (LIFESTYLE - Lazy) ==================== -->
                <tabs:LifestyleTab x:Name="TabLifestyle"
                                   x:DeferLoadStrategy="Lazy"
                                   ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsLifestyleVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 5: LỊCH ÂM DƯƠNG & SỰ KIỆN (CALENDAR - Lazy) ==================== -->
                <tabs:CalendarTab x:Name="TabCalendar"
                                  x:DeferLoadStrategy="Lazy"
                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsCalendarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 6: WIDGET STUDIO & GHIM DESKTOP (WIDGET - Lazy) ==================== -->
                <tabs:WidgetStudioTab x:Name="TabWidgetStudio"
                                      x:DeferLoadStrategy="Lazy"
                                      ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsWidgetVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- ==================== TAB 7: TRUNG TÂM CÀI ĐẶT & GIAO DIỆN (SETTINGS - Lazy) ==================== -->
                <tabs:SettingsTab x:Name="TabSettings"
                                  x:DeferLoadStrategy="Lazy"
                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsSettingsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  OpenChangelogRequested="SettingsTab_OpenChangelogRequested"
                                  ReopenOnboardingRequested="SettingsTab_ReopenOnboardingRequested"/>
            </Grid>
        </NavigationView>

        <!-- ==================== FLOATING BOTTOM SPATIAL DOCK (VERSION 3.7.0 - WIN10 & WIN11) ==================== -->
        <Border x:Name="FloatingBottomDock"
                Visibility="{x:Bind ViewModel.IsFloatingDockMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                Canvas.ZIndex="150"
                Background="#E80F172A"
                BorderBrush="#4538BDF8"
                BorderThickness="1.2"
                CornerRadius="24"
                Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- 01. TỔNG QUAN -->
                <Button x:Name="DockBtnOverview" Click="FloatingDockTab_Click" Tag="overview"
                        Background="Transparent" BorderThickness="1" CornerRadius="16" Padding="11,6"
                        ToolTipService.ToolTip="01 • Tổng quan Thời tiết (Phím tắt: 1)">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="DockIconOverview" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="12.5" Foreground="#F59E0B"/>
                            <TextBlock x:Name="DockTextOverview" Text="{x:Bind ViewModel.Loc.NavOverview, Mode=OneWay}" FontSize="11.5" FontWeight="Bold"/>
                            <Border Background="#2238BDF8" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.NavOverviewTempText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                            </Border>
                        </StackPanel>
                        <Border x:Name="DockIndOverview" Grid.Row="1" Height="2.5" Width="22" CornerRadius="1.5" Background="#38BDF8" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 02. TRIỀU CƯỜNG & NGẬP -->
                <Button x:Name="DockBtnFlood" Click="FloatingDockTab_Click" Tag="flood"
                        Background="Transparent" BorderThickness="1" CornerRadius="16" Padding="11,6"
                        ToolTipService.ToolTip="02 • Triều cường &amp; Cảnh báo Ngập đô thị (Phím tắt: 2)">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="DockIconFlood" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" FontSize="12.5" Foreground="#0284C7"/>
                            <TextBlock x:Name="DockTextFlood" Text="{x:Bind ViewModel.Loc.NavFlood, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DockFloodBadgeText" Text="{x:Bind ViewModel.NavFloodTideText, Mode=OneWay}" FontSize="9.5" Opacity="0.7" FontFamily="Cascadia Mono, Consolas, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="DockIndFlood" Grid.Row="1" Height="2.5" Width="22" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 03. RADAR DOPPLER -->
                <Button x:Name="DockBtnRadar" Click="FloatingDockTab_Click" Tag="radar"
                        Background="Transparent" BorderThickness="1" CornerRadius="16" Padding="11,6"
                        ToolTipService.ToolTip="03 • Radar Mây Mưa Doppler 360° (Phím tắt: 3)">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="DockIconRadar" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" FontSize="12.5" Foreground="#10B981"/>
                            <TextBlock x:Name="DockTextRadar" Text="{x:Bind ViewModel.Loc.NavRadar, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                            <Ellipse Width="5.5" Height="5.5" Fill="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
