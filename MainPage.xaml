                       MaxWidth="860">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
            </ContentDialog.Resources>
            <Grid MaxWidth="800" MaxHeight="540" RowDefinitions="Auto,Auto,*" Margin="0,2,0,0">
                <!-- THANH CHỌN PHIÊN BẢN LỊCH SỬ -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
