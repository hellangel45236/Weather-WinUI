                        <StackPanel x:Name="ChangelogContent_v223" Spacing="10" Visibility="Visible">
                            <!-- 1. Sửa lỗi chí mạng không lưu cài đặt & Widget reset 20% -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
