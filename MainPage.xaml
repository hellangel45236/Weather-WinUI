        <!-- ==================== TÍNH NĂNG MỚI v2.1: DIALOG CHIA SẺ THỜI TIẾT FULL HD (1080p+) ==================== -->
        <ContentDialog x:Name="ShareCardDialog"
                       Title="📸 Chia Sẻ Thẻ Thời Tiết Full HD (1080p)"
                       CloseButtonText="Đóng"
                       DefaultButton="None"
                       CornerRadius="16">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
            </ContentDialog.Resources>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Width="680" MaxHeight="580">
                <!-- Chọn định dạng & Tùy chọn -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Định dạng ảnh:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                        <RadioButton x:Name="ShareFormatLandscapeRadio" Content="🖥️ Khổ Ngang FHD (1920 × 1080)" IsChecked="True" Checked="ShareFormatRadio_Checked" GroupName="ShareFhdGroup" FontSize="12"/>
                        <RadioButton x:Name="ShareFormatStoryRadio" Content="📱 Khổ Dọc Story (1080 × 1920)" Checked="ShareFormatRadio_Checked" GroupName="ShareFhdGroup" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- KHUNG XEM TRƯỚC SẮC NÉT (WYSIWYG LIVE PREVIEW) -->
                <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" Padding="8" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="480" MinHeight="270">
                    <Grid MaxWidth="650" MaxHeight="380">
                        <Image x:Name="SharePreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ProgressRing x:Name="SharePreviewProgressRing" IsActive="False" Visibility="Collapsed" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Nút thao tác dưới cùng -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="✨ Độ phân giải gốc Full HD siêu nét, tối ưu cho Zalo, Facebook, Story." FontSize="11.5" Opacity="0.7" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Click="CopyFhdShareCardButton_Click" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c5;" FontSize="13"/>
                            <TextBlock Text="Sao chép ảnh Full HD" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="SaveFhdShareCardButton_Click" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c7;" FontSize="13"/>
                            <TextBlock Text="Lưu file ảnh (.png)" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ContentDialog>

    </Grid>
</Page>
