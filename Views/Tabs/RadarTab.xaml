<UserControl
    x:Class="WeatherApp.Views.Tabs.RadarTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,16,24">

            <!-- THẺ ĐÀI RADAR DOPPLER CHÍNH -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <StackPanel Spacing="14">

                    <!-- HÀNG TIÊU ĐỀ & TRẠNG THÁI QUÉT REALTIME -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" Foreground="#10B981" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Loc.RadarDopplerTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.RadarDopplerSub, Mode=OneWay}" FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Các nút điều khiển trạng thái quét (Tạm dừng, Tốc độ quét & Đèn báo) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Nút Tạm Dừng / Tiếp Tục -->
                            <Button x:Name="BtnTogglePause"
                                    Click="TogglePause_Click"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    ToolTipService.ToolTip="Bấm để tạm dừng hoặc tiếp tục vòng quét radar 360°">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon x:Name="TogglePauseIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf04c;" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TogglePauseText" Text="{x:Bind ViewModel.Loc.RadarPause, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Đổi Tốc Độ Quét -->
                            <Button x:Name="BtnToggleSpeed"
                                    Click="ToggleSpeed_Click"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    ToolTipService.ToolTip="Đổi tốc độ chùm tia quét (1x, 2x, 0.5x)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0e7;" FontSize="11" Foreground="#F59E0B"/>
                                    <TextBlock x:Name="SpeedText" Text="1x" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Đèn báo trạng thái Realtime -->
                            <Border x:Name="StatusBadgeBorder" Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981"/>
                                    <TextBlock x:Name="StatusBadgeText" Text="{x:Bind ViewModel.Loc.RadarScanningStatus, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- THANH ĐIỀU KHIỂN BÁN KÍNH (RANGE) & TẦNG KHÍ TƯỢNG (LAYER MODES) -->
                    <Border Background="#150F172A" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                            <!-- Nhóm 1: Bán kính quét (100km, 200km, 300km, 500km) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf002;" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.RadarRadius, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"/>
                                </StackPanel>
                                <Button x:Name="BtnRange100" Tag="100" Click="RangeButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="SemiBold" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Content="100 km"/>
                                <Button x:Name="BtnRange200" Tag="200" Click="RangeButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="Bold" Background="#3538BDF8" BorderBrush="#38BDF8" BorderThickness="1" Content="200 km"/>
                                <Button x:Name="BtnRange300" Tag="300" Click="RangeButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="SemiBold" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Content="300 km"/>
                                <Button x:Name="BtnRange500" Tag="500" Click="RangeButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="SemiBold" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Content="500 km"/>
                            </StackPanel>

                            <!-- Dải phân cách -->
                            <Border Grid.Column="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.3"/>

                            <!-- Nhóm 2: Lớp dữ liệu khí tượng (Mây mưa dBZ, Dòng gió, Dông sét, Nhiệt độ) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf5fd;" FontSize="11" Foreground="#10B981"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.RadarObsLayer, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8"/>
                                </StackPanel>
                                <Button x:Name="BtnLayerPrecip" Tag="Precipitation" Click="LayerButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="Bold" Background="#3510B981" BorderBrush="#10B981" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="10.5" Foreground="#10B981"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.RadarLayerPrecip, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnLayerWind" Tag="Wind" Click="LayerButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="SemiBold" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="10.5" Foreground="#38BDF8"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.RadarLayerWind, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnLayerLightning" Tag="Lightning" Click="LayerButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="SemiBold" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0e7;" FontSize="10.5" Foreground="#F59E0B"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.RadarLayerLightning, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnLayerThermal" Tag="Thermal" Click="LayerButton_Click" CornerRadius="8" Padding="10,4" FontSize="11" FontWeight="SemiBold" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="10.5" Foreground="#EF4444"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.RadarLayerThermal, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- KHUNG MÀN HÌNH RADAR KHÍ TƯỢNG PHÓNG LỚN (CHIỀU CAO 460PX CHUẨN ĐÀI QUAN TRẮC) -->
                    <Border Height="460" Background="#0A101C" CornerRadius="14" BorderBrush="#2538BDF8" BorderThickness="1.5">
                        <Canvas x:Name="RadarSimulationCanvas" Height="460" HorizontalAlignment="Stretch" SizeChanged="RadarSimulationCanvas_SizeChanged"/>
                    </Border>

                    <!-- THƯỚC ĐO CƯỜNG ĐỘ PHẢN HỒI DBZ & CHÚ THÍCH CÁC TẦNG MÂY -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf080;" FontSize="11" Foreground="#38BDF8"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.RadarScaleDbz, Mode=OneWay}" FontSize="11" Opacity="0.8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Dải gradient thang đo chuẩn WMO -->
                        <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <Border Height="8" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0284C7" Offset="0"/>
                                        <GradientStop Color="#10B981" Offset="0.25"/>
                                        <GradientStop Color="#F59E0B" Offset="0.55"/>
                                        <GradientStop Color="#EF4444" Offset="0.85"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Loc.RadarScaleLight, Mode=OneWay}" FontSize="10" Opacity="0.7"/>
                            <TextBlock Text="•" FontSize="10" Opacity="0.4"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.RadarScaleModerate, Mode=OneWay}" FontSize="10" Foreground="#F59E0B" FontWeight="SemiBold"/>
                            <TextBlock Text="•" FontSize="10" Opacity="0.4"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.RadarScaleSevere, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4 THẺ CHỈ SỐ VI KHÍ HẬU & ĐỐI LƯỢNG RADAR THỜI GIAN THỰC -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <!-- 1. Gió & Dòng khí -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#20059669" BorderBrush="#40059669" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" Foreground="#10B981" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.RadarWindBeaufort, Mode=OneWay}" FontSize="12" Opacity="0.8" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindDirectionText, Mode=OneWay}" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 2. Áp suất khí quyển -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#207C3AED" BorderBrush="#407C3AED" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf14e;" Foreground="#A78BFA" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.RadarAtmPressure, Mode=OneWay}" FontSize="12" Opacity="0.8" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.PressureText, Mode=OneWay}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.Loc.RadarPressureStatus, Mode=OneWay}" FontSize="11" Foreground="#A78BFA" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. Phản hồi dBZ Cực Đại -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#200284C7" BorderBrush="#400284C7" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" Foreground="#38BDF8" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.RadarMaxReflectivity, Mode=OneWay}" FontSize="12" Opacity="0.8" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock x:Name="MaxDbzValueText" Text="28 dBZ" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="MaxDbzStatusText" Text="Mây mưa đối lưu nhẹ" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4. Hoạt Động Dông Sét & Rủi Ro -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0e7;" Foreground="#10B981" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.RadarDisasterRisk, Mode=OneWay}" FontSize="12" Opacity="0.8" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock x:Name="RiskLevelText" Text="Bình Thường" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock x:Name="RiskDetailText" Text="Không có áp thấp hay lốc xoáy" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
