<UserControl
    x:Class="WeatherApp.Views.Tabs.SettingsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,0,16,24">
                        <!-- HEADER CÀI ĐẶT -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#2094A3B8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf013;" Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Trung Tâm Cài Đặt &amp; Cá Nhân Hóa (Version 3.0.0)" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Quản lý giao diện, biểu tượng, đơn vị, ảnh nền, thông báo và hiệu năng hệ thống" FontSize="11.5" Opacity="0.65"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Click="SaveSettingsTab_Click" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c7;" FontSize="11"/>
                                            <TextBlock Text="Lưu &amp; Áp Dụng" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="#258B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <TextBlock Text="Version 3.0.0 (Chính Thức)" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- KHUNG 2 CỘT CÀI ĐẶT ĐẦY ĐỦ TỪ SETTINGS DIALOG GỐC (KHÔNG CỐ ĐỊNH CHIỀU CAO - MƯỢT MÀ WIN11) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16">
            <Grid ColumnDefinitions="230,*" MinHeight="620" ColumnSpacing="16" Margin="0,8,0,0">
                <!-- CỘT 1: THANH ĐIỀU HƯỚNG DANH MỤC CÀI ĐẶT (SIDEBAR) -->
                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="6">
                    <ListView x:Name="SettingsNavListView" SelectionChanged="SettingsNavListView_SelectionChanged" SelectionMode="Single" SelectedIndex="0">
                        <ListViewItem Tag="0">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf007;" FontSize="14" Foreground="#38BDF8"/>
                                <TextBlock Text="Cá nhân hóa" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="7">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf53f;" FontSize="14" Foreground="#F43F5E"/>
                                <TextBlock Text="Giao diện &amp; Biểu tượng" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="1">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" FontSize="14" Foreground="#F59E0B"/>
                                <TextBlock Text="Thời gian &amp; Đơn vị" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="2">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf03e;" FontSize="14" Foreground="#EC4899"/>
                                <TextBlock Text="Hình nền thành phố" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" FontSize="14" Foreground="#A855F7"/>
                                <TextBlock Text="Widget Desktop" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0f3;" FontSize="14" Foreground="#EF4444"/>
                                <TextBlock Text="Thông báo &amp; Khay" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="5">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf011;" FontSize="14" Foreground="#10B981"/>
                                <TextBlock Text="Hiệu năng &amp; Khởi động" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="6">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="4,6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf05a;" FontSize="14" Foreground="#6366F1"/>
                                <TextBlock Text="Giới thiệu &amp; Changelog" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Border>

                <!-- CỘT 2: CHI TIẾT TỪNG DANH MỤC -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <Grid>
                        <!-- PANEL 0: CÁ NHÂN HÓA -->
                        <ScrollViewer x:Name="PanelPersonalization" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Cá Nhân Hóa" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Thiết lập tên hiển thị và trải nghiệm cá nhân của bạn" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf007;" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Tên của bạn" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Tên hiển thị trong lời chào và các thông báo hàng ngày" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2" x:Name="SettingsUserNameBox" Width="180" PlaceholderText="Nhập tên..." VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PANEL 1: THỜI GIAN & ĐƠN VỊ -->
                        <ScrollViewer x:Name="PanelTimeUnits" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Thời Gian &amp; Đơn Vị Đo Lường" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Tùy chỉnh định dạng giờ, múi giờ và các đơn vị thời tiết" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <!-- Múi giờ -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0ac;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Múi giờ đồng hồ" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Chọn múi giờ hiển thị trên đồng hồ thời tiết" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="TimezoneComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="TimezoneComboBox_SelectionChanged">
                                            <ComboBoxItem Content="🌐 Tự động (Hệ thống)" Tag="Auto"/>
                                            <ComboBoxItem Content="🇻🇳 GMT+7 (Việt Nam, BKK)" Tag="GMT+7"/>
                                            <ComboBoxItem Content="🇸🇬 GMT+8 (Singapore)" Tag="GMT+8"/>
                                            <ComboBoxItem Content="🇯🇵 GMT+9 (Tokyo, Seoul)" Tag="GMT+9"/>
                                            <ComboBoxItem Content="🇬🇧 GMT+0 (London, UTC)" Tag="GMT+0"/>
                                            <ComboBoxItem Content="🇺🇸 GMT-5 (New York)" Tag="GMT-5"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Định dạng giờ -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Định dạng giờ" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Hiển thị theo chuẩn 24 giờ hoặc 12 giờ AM/PM" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="HourFormatToggle" OnContent="24 Giờ" OffContent="12 Giờ" IsOn="{x:Bind ViewModel.Settings.Is24HourFormat, Mode=TwoWay}" Toggled="HourFormatToggle_Toggled" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Định dạng ngày -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Định dạng ngày tháng" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Kiểu hiển thị ngày tháng trên màn hình" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="DateFormatComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="DateFormatComboBox_SelectionChanged">
                                            <ComboBoxItem Content="dd/MM/yyyy (30/09/2026)" Tag="dd/MM/yyyy"/>
                                            <ComboBoxItem Content="MM/dd/yyyy (09/30/2026)" Tag="MM/dd/yyyy"/>
                                            <ComboBoxItem Content="yyyy-MM-dd (2026-09-30)" Tag="yyyy-MM-dd"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Ngày bắt đầu của tuần (First Day of Week) v1.8 -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Ngày bắt đầu tuần" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Chọn ngày đầu tiên hiển thị trên Lịch tháng" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="FirstDayOfWeekComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="FirstDayOfWeekComboBox_SelectionChanged">
                                            <ComboBoxItem Content="📅 Thứ Hai (Mặc định)" Tag="Monday"/>
                                            <ComboBoxItem Content="📅 Chủ Nhật (Quốc tế)" Tag="Sunday"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Đơn vị nhiệt độ -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Đơn vị nhiệt độ" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Hiển thị độ Celsius (°C) hoặc Fahrenheit (°F)" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="TempUnitComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="TempUnitComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Độ C (°C)" Tag="C"/>
                                            <ComboBoxItem Content="Độ F (°F)" Tag="F"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Đơn vị gió & áp suất -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Đơn vị tốc độ gió" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="km/h, m/s hoặc mph" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="WindUnitComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="WindUnitComboBox_SelectionChanged">
                                            <ComboBoxItem Content="km/h" Tag="kmh"/>
                                            <ComboBoxItem Content="m/s" Tag="ms"/>
                                            <ComboBoxItem Content="mph" Tag="mph"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Đơn vị áp suất -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0e4;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Đơn vị áp suất khí quyển" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="hPa hoặc mmHg" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="PressureUnitComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="PressureUnitComboBox_SelectionChanged">
                                            <ComboBoxItem Content="hPa (chuẩn)" Tag="hPa"/>
                                            <ComboBoxItem Content="mmHg (thủy ngân)" Tag="mmHg"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Đơn vị lượng mưa -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Đơn vị lượng mưa" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Milimét (mm) hoặc Inch (in)" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="PrecipUnitComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="PrecipUnitComboBox_SelectionChanged">
                                            <ComboBoxItem Content="mm (milimét)" Tag="mm"/>
                                            <ComboBoxItem Content="inch" Tag="inch"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PANEL 2: HÌNH NỀN THÀNH PHỐ -->
                        <ScrollViewer x:Name="PanelCityBg" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Hình Nền Thành Phố (City Picture)" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Hiện ảnh nền mờ nghệ thuật phía sau thẻ thời tiết hiện tại" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <!-- Thẻ điều khiển chính -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf03e;" FontSize="16" Foreground="#EC4899" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Hình nền mờ theo địa điểm" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Tự động áp dụng ảnh thành phố tương ứng với vị trí đang xem hoặc ảnh mẫu tùy thích" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" x:Name="CityBgToggle" Toggled="CityBgToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel x:Name="CityBgControlsPanel" Spacing="12">
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5"/>

                                            <!-- Tự động chuyển đổi Ngày & Đêm theo chu kỳ mặt trời -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Đổi ảnh nền theo Ngày &amp; Đêm (Dynamic Day &amp; Night)" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Text="Tự động chuyển sang ảnh thành phố ban đêm lên đèn lung linh khi trời tối theo giờ mặt trời lặn" FontSize="11" Opacity="0.7"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="2" x:Name="DynamicDayNightToggle" Toggled="DynamicDayNightToggle_Toggled" VerticalAlignment="Center"/>
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.3"/>

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <ComboBox x:Name="CityImageModeComboBox" SelectionChanged="CityImageModeComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="🌐 Tự động theo địa điểm thời tiết" Tag="Auto"/>
                                                    <ComboBoxItem Content="🌆 Chọn trong danh sách ảnh mẫu" Tag="Preset"/>
                                                    <ComboBoxItem Content="📁 Tự chọn hình ảnh từ máy tính..." Tag="Custom"/>
                                                </ComboBox>
                                                <ComboBox Grid.Column="1" x:Name="PresetCityImageComboBox" Width="200" SelectionChanged="PresetCityImageComboBox_SelectionChanged" Visibility="Collapsed"/>
                                                <Button Grid.Column="1" x:Name="BrowseCustomImageButton" Content="Chọn ảnh..." Click="BrowseCustomImageButton_Click" Visibility="Collapsed"/>
                                            </Grid>

                                            <!-- Thanh thông tin ảnh tùy chỉnh từ máy tính -->
                                            <Border x:Name="CustomImageInfoPanel" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Visibility="Collapsed">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf15b;" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" x:Name="CustomImagePathText" Text="Chưa chọn tệp ảnh nào" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" x:Name="ChangeCustomImageButton" Content="Đổi ảnh khác..." FontSize="11.5" Padding="10,4" Click="BrowseCustomImageButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ Xem Trước Trực Quan Live Preview -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06e;" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                <TextBlock Text="Xem Trước Thẻ Thời Tiết Có Hình Nền" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" x:Name="PreviewModeBadge" Background="#2638BDF8" CornerRadius="6" Padding="8,3">
                                                <TextBlock x:Name="PreviewModeBadgeText" Text="Tự động" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Khung mô phỏng thẻ Hero Card có ảnh nền -->
                                        <Border x:Name="PreviewHeroCardBorder" CornerRadius="14" Height="140" Background="#1E293B">
                                            <Grid CornerRadius="14">
                                                <!-- Ảnh nền mờ mô phỏng -->
                                                <Border x:Name="PreviewCityImageBorder" CornerRadius="14">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="PreviewCityImageBrush" Stretch="UniformToFill" Opacity="0.45"/>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Lớp gradient mô phỏng -->
                                                <Border CornerRadius="14" Opacity="0.65">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0284C7" Offset="0"/>
                                                            <GradientStop Color="#0369A1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Nội dung thông tin mô phỏng -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                    <TextBlock x:Name="PreviewCityTitleText" Text="Sài Gòn" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
