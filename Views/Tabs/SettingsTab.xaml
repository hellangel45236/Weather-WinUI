                                </StackPanel>

                                <!-- Card Thông tin phiên bản -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0">
                                            <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="48" Height="48" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Weather WinUI" FontSize="16" FontWeight="Bold"/>
                                                <Border Background="#10B981" CornerRadius="6" Padding="6,1">
                                                    <TextBlock Text="v3.0.1 Official" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Ứng dụng thời tiết hiện đại, siêu nhẹ, tương thích hoàn hảo Windows 10 &amp; 11" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- THẺ KIỂM TRA BẢN CẬP NHẬT MỚI TRÊN GITHUB -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf021;" FontSize="14" Foreground="#38BDF8"/>
                                                <TextBlock Text="Cập Nhật Ứng Dụng (GitHub Releases)" FontWeight="Bold" FontSize="13.5"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Padding="12,5"
                                                    CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf01e;" FontSize="11"/>
                                                    <TextBlock Text="Kiểm tra ngay" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Trạng thái kiểm tra -->
                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12,10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <ProgressRing Grid.Column="0" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf058;" FontSize="14" Foreground="#10B981" Visibility="{x:Bind ViewModel.HasAvailableUpdate, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf135;" FontSize="14" Foreground="#F59E0B" Visibility="{x:Bind ViewModel.HasAvailableUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UpdateCheckStatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>

                                        <!-- Khung thông báo khi có bản cập nhật mới -->
                                        <Border Visibility="{x:Bind ViewModel.HasAvailableUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#25F59E0B" BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="🎉 Phiên bản mới:" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind ViewModel.LatestVersionText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.LatestReleaseTitle, Mode=OneWay}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{x:Bind ViewModel.OpenLatestReleaseUrlCommand}" Background="#F59E0B" Foreground="Black" FontWeight="Bold" CornerRadius="8" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf019;" FontSize="12"/>
                                                        <TextBlock Text="Tải về ngay" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Checkbox tự động kiểm tra mỗi khi khởi động -->
                                        <CheckBox x:Name="AutoCheckUpdatesCheck" Content="Tự động kiểm tra bản cập nhật mới mỗi khi mở ứng dụng" IsChecked="{x:Bind ViewModel.Settings.AutoCheckForUpdates, Mode=TwoWay}" Click="AutoCheckUpdatesCheck_Click" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>

                                <!-- Nút mở Nhật ký phiên bản (Changelog) -->
                                <Button x:Name="OpenChangelogFromSettingsButton"
                                        Click="OpenChangelogFromSettingsButton_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="14,10"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf02d;" FontSize="14"/>
                                        <TextBlock Text="📜 Xem Nhật Ký Thay Đổi Các Phiên Bản (Changelog)" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nút mở lại Onboarding -->
                                <Button x:Name="ReopenOnboardingButton"
                                        Click="ReopenOnboardingButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="14,10"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf05a;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="🚀 Mở lại trang hướng dẫn ban đầu (Onboarding)" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PANEL 7: GIAO DIỆN & BỘ BIỂU TƯỢNG (ICON PACK) -->
                        <ScrollViewer x:Name="PanelAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Giao Diện &amp; Biểu Tượng" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Tùy biến bộ icon thời tiết trực quan và phong cách hiển thị của toàn bộ ứng dụng" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <!-- MỤC ĐẦU: BỘ BIỂU TƯỢNG THỜI TIẾT (ICON PACK) VỚI CÁC THẺ TRỰC QUAN -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Bộ Biểu Tượng Thời Tiết (Icon Pack)" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Chọn bộ biểu tượng yêu thích để hiển thị trên màn hình chính, thanh dự báo và widget desktop:" FontSize="12" Opacity="0.75"/>

                                    <!-- 1. THẺ METEOCONS ANIMATED (BAS MILIUS) -->
                                    <Border x:Name="CardIconPackMeteocons"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="2"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            PointerPressed="CardIconPackMeteocons_PointerPressed">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <!-- Dòng 1: Tiêu đề + Huy hiệu khuyên dùng + Checkmark -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="Meteocons Animated" FontSize="14" FontWeight="Bold"/>
                                                    <Border Background="#10B981" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="✨ ĐỘC QUYỀN &amp; SỐNG ĐỘNG" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <Border x:Name="BadgeSelectedMeteocons" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,3" Visibility="Visible">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00c;" FontSize="11" Foreground="White"/>
                                                        <TextBlock Text="Đang dùng" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Dòng 2: Mô tả -->
                                            <TextBlock Grid.Row="1" Text="Bộ icon vector thời tiết hoạt họa mượt mà, sắc nét đỉnh cao từ Bas Milius (GitHub basmilius/meteocons). Hiển thị sống động mọi sắc thái nắng mưa." FontSize="11.5" Opacity="0.75" TextWrapping="Wrap"/>

                                            <!-- Dòng 3: Dải hình ảnh xem trước (Preview Icons) -->
                                            <Border Grid.Row="2" Background="#14000000" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="*,*,*,*" HorizontalAlignment="Stretch">
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/Meteocons/clear-day.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Nắng" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/Meteocons/partly-cloudy-day.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Nắng mây" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/Meteocons/partly-cloudy-day-rain.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Mưa rào" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/Meteocons/thunderstorms-day-rain.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Dông bão" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 2. THẺ FLUENT WEATHER 3D -->
                                    <Border x:Name="CardIconPackFluent3D"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            PointerPressed="CardIconPackFluent3D_PointerPressed">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <!-- Dòng 1: Tiêu đề + Huy hiệu + Checkmark -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="Fluent Weather 3D" FontSize="14" FontWeight="Bold"/>
                                                    <Border Background="#6366F1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="🎨 3D HIỆN ĐẠI" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <Border x:Name="BadgeSelectedFluent3D" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,3" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00c;" FontSize="11" Foreground="White"/>
                                                        <TextBlock Text="Đang dùng" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Dòng 2: Mô tả -->
                                            <TextBlock Grid.Row="1" Text="Bộ icon 3D sắc màu phong phú với chiều sâu bóng đổ, mang lại cảm giác hiện đại và trực quan." FontSize="11.5" Opacity="0.75" TextWrapping="Wrap"/>

                                            <!-- Dòng 3: Dải hình ảnh xem trước (Preview Icons) -->
                                            <Border Grid.Row="2" Background="#14000000" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="*,*,*,*" HorizontalAlignment="Stretch">
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/weather-icons-main/static/clear-day.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Nắng" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/weather-icons-main/static/cloudy-1-day.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Ít mây" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/weather-icons-main/static/rainy-2-day.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Mưa vừa" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="3">
                                                        <Image Source="ms-appx:///Assets/weather-icons-main/static/isolated-thunderstorms-day.svg" Width="38" Height="38" Stretch="Uniform"/>
                                                        <TextBlock Text="Sấm sét" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 3. THẺ FONTAWESOME MINIMALIST -->
                                    <Border x:Name="CardIconPackFontAwesome"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            PointerPressed="CardIconPackFontAwesome_PointerPressed">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <!-- Dòng 1: Tiêu đề + Huy hiệu + Checkmark -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="FontAwesome Minimalist" FontSize="14" FontWeight="Bold"/>
                                                    <Border Background="#64748B" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="⚡ TỐI GIẢN" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <Border x:Name="BadgeSelectedFontAwesome" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Padding="8,3" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00c;" FontSize="11" Foreground="White"/>
                                                        <TextBlock Text="Đang dùng" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Dòng 2: Mô tả -->
                                            <TextBlock Grid.Row="1" Text="Biểu tượng glyph phẳng tối giản, tải cực nhanh, tương thích 100% mọi độ phân giải màn hình." FontSize="11.5" Opacity="0.75" TextWrapping="Wrap"/>

                                            <!-- Dòng 3: Dải hình ảnh xem trước (Preview Glyphs) -->
                                            <Border Grid.Row="2" Background="#14000000" CornerRadius="8" Padding="12,8">
                                                <Grid ColumnDefinitions="*,*,*,*" HorizontalAlignment="Stretch">
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="5">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="28" Foreground="#F59E0B"/>
                                                        <TextBlock Text="Nắng" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="5">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" FontSize="28" Foreground="#38BDF8"/>
                                                        <TextBlock Text="Ít mây" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="5">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="28" Foreground="#60A5FA"/>
                                                        <TextBlock Text="Mưa rào" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="5">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf76c;" FontSize="28" Foreground="#EF4444"/>
                                                        <TextBlock Text="Sấm chớp" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- MỤC 2: CHỦ ĐỀ MÀU SẮC -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" FontSize="15" Foreground="#F43F5E" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Chủ đề hiển thị ứng dụng" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Chế độ màu Sáng, Tối hoặc Tự động thích ứng Windows" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="AppearanceThemeComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="AppearanceThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="💻 Theo hệ thống" Tag="system"/>
                                            <ComboBoxItem Content="☀️ Chế độ Sáng" Tag="light"/>
                                            <ComboBoxItem Content="🌙 Chế độ Tối" Tag="dark"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- MỤC 3: HIỆU ỨNG KHÍ QUYỂN ĐỘNG -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0e7;" FontSize="15" Foreground="#F43F5E" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Hiệu ứng hoạt họa khí quyển" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Mưa rơi, sấm sét, vầng nắng (Tắt để tiết kiệm pin/RAM)" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="AppearanceEffectsToggle" IsOn="{x:Bind ViewModel.Settings.EnableWeatherEffects, Mode=TwoWay}" Toggled="EffectsToggle_Toggled" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
                        </Border>
                    </StackPanel>
    </ScrollViewer>
</UserControl>
