                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Độ trong suốt Widget (Opacity)" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Tự động sáng rõ 100% khi rê chuột vào" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider x:Name="WidgetOpacitySlider" Minimum="20" Maximum="100" Value="100" StepFrequency="5" Width="120" ValueChanged="WidgetOpacitySlider_ValueChanged"/>
                                                <TextBlock x:Name="WidgetOpacityValueText" Text="100%" Width="42" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PANEL 4: THÔNG BÁO & KHAY HỆ THỐNG -->
                        <ScrollViewer x:Name="PanelNotifications" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Thông Báo &amp; Khay Hệ Thống" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Quản lý thông báo Windows Toast và hành vi khay Taskbar" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <!-- Thông báo Toast -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0f3;" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Cảnh báo Windows Toast" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Gửi cảnh báo mưa, nắng gắt và tóm tắt đầu ngày" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" x:Name="ToastNotificationToggle" Toggled="ToastNotificationToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel x:Name="ToastOptionsPanel" Spacing="6" Margin="28,0,0,0">
                                            <CheckBox x:Name="RainAlarmCheckBox" Content="🌧️ Cảnh báo mưa sắp đến trong 20-30 phút tới" Click="ToastOptionCheckBox_Click"/>
                                            <CheckBox x:Name="UvAlertCheckBox" Content="🔥 Cảnh báo tia cực tím UV rất cao buổi trưa (11h-14h)" Click="ToastOptionCheckBox_Click"/>
                                            <CheckBox x:Name="MorningBriefingCheckBox" Content="☀️ Tóm tắt dự báo đầu ngày (buổi sáng 07h00)" Click="ToastOptionCheckBox_Click"/>

                                            <Button Command="{x:Bind ViewModel.TestToastNotificationCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="12,6" CornerRadius="8" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0f3;" FontSize="11"/>
                                                    <TextBlock Text="Thử gửi thông báo kiểm tra ngay" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Cảnh báo Thời tiết Lịch trình Đi làm / Đi học / Tan ca (Commute Weather Alerts v2.0) -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1b9;" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Nhắc nhở thời tiết Đi làm &amp; Tan ca" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Báo trước thời tiết (mưa, nắng, gió) trước giờ xuất phát để kịp chuẩn bị áo mưa, ô che" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" x:Name="CommuteAlertToggle" Toggled="CommuteAlertToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel x:Name="CommuteOptionsPanel" Spacing="8" Margin="28,0,0,0">
                                            <!-- Giờ đi sáng & Giờ tan ca chiều -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Giờ đi làm / đi học sáng:" FontSize="11" FontWeight="SemiBold"/>
                                                    <TimePicker x:Name="MorningCommuteTimePicker" ClockIdentifier="24HourClock" SelectedTimeChanged="CommuteTime_Changed"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Giờ tan ca buổi chiều:" FontSize="11" FontWeight="SemiBold"/>
                                                    <TimePicker x:Name="EveningCommuteTimePicker" ClockIdentifier="24HourClock" SelectedTimeChanged="CommuteTime_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Thời gian báo trước -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="Thông báo trước:" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="CommuteLeadTimeComboBox" SelectionChanged="CommuteLeadTimeComboBox_SelectionChanged" SelectedIndex="1" HorizontalAlignment="Stretch" FontSize="11.5">
                                                    <ComboBoxItem Content="Trước 15 phút" Tag="15"/>
                                                    <ComboBoxItem Content="Trước 30 phút (Khuyên dùng)" Tag="30"/>
                                                    <ComboBoxItem Content="Trước 45 phút" Tag="45"/>
                                                    <ComboBoxItem Content="Trước 1 tiếng" Tag="60"/>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Các ngày trong tuần -->
                                            <TextBlock Text="Áp dụng vào các ngày:" FontSize="11" Opacity="0.8" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CheckBox x:Name="CommuteMonCheck" Content="T2" IsChecked="True" Click="CommuteDays_Click"/>
                                                <CheckBox x:Name="CommuteTueCheck" Content="T3" IsChecked="True" Click="CommuteDays_Click"/>
                                                <CheckBox x:Name="CommuteWedCheck" Content="T4" IsChecked="True" Click="CommuteDays_Click"/>
                                                <CheckBox x:Name="CommuteThuCheck" Content="T5" IsChecked="True" Click="CommuteDays_Click"/>
                                                <CheckBox x:Name="CommuteFriCheck" Content="T6" IsChecked="True" Click="CommuteDays_Click"/>
                                                <CheckBox x:Name="CommuteSatCheck" Content="T7" IsChecked="False" Click="CommuteDays_Click"/>
                                                <CheckBox x:Name="CommuteSunCheck" Content="CN" IsChecked="False" Click="CommuteDays_Click"/>
                                            </StackPanel>

                                            <Button Click="TestCommuteAlertButton_Click" Style="{ThemeResource AccentButtonStyle}" Padding="12,6" CornerRadius="8" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1b9;" FontSize="11"/>
                                                    <TextBlock Text="🔔 Thử gửi thông báo lịch trình ngay" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Khay hệ thống -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d2;" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Thu nhỏ xuống khay hệ thống" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Ẩn cửa sổ vào khay taskbar khi bấm nút thu nhỏ" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" x:Name="MinimizeToTrayToggle" Toggled="MinimizeToTrayToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Đóng ứng dụng về khay hệ thống" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Bấm nút X sẽ ẩn app về khay thay vì thoát hẳn" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" x:Name="CloseToTrayToggle" Toggled="CloseToTrayToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PANEL 5: HIỆU NĂNG & KHỞI ĐỘNG -->
                        <ScrollViewer x:Name="PanelPerformance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Hiệu Năng &amp; Khởi Động" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Tối ưu tài nguyên hệ thống, mức RAM và tần suất làm mới" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <!-- Khởi động cùng Windows -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf011;" FontSize="15" Foreground="#10B981" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Khởi động cùng Windows" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Tự động mở ứng dụng thời tiết khi bật máy tính" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" x:Name="StartupToggle" IsOn="{x:Bind ViewModel.Settings.LaunchAtStartup, Mode=TwoWay}" Toggled="StartupToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Tùy chọn khởi động thu nhỏ về Khay hệ thống -->
                                        <Border x:Name="StartMinimizedContainer" Background="#15FFFFFF" CornerRadius="8" Padding="12,8" Visibility="{x:Bind ViewModel.Settings.LaunchAtStartup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d2;" FontSize="13" Foreground="#10B981" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Khởi động thu nhỏ vào khay hệ thống" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Text="Tự động ẩn ứng dụng vào khay Taskbar khi bật máy tính, không bung to cửa sổ làm phiền" FontSize="11" Opacity="0.7"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="2" x:Name="StartMinimizedToggle" IsOn="{x:Bind ViewModel.Settings.StartMinimizedToTray, Mode=TwoWay}" Toggled="StartMinimizedToggle_Toggled" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Chủ đề -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" FontSize="15" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Chủ đề hiển thị" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Sáng, Tối hoặc Tự động theo Windows" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="SettingsThemeComboBox" SelectedIndex="0" Width="180" VerticalAlignment="Center" SelectionChanged="SettingsThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="💻 Theo hệ thống" Tag="system"/>
                                            <ComboBoxItem Content="☀️ Chế độ Sáng" Tag="light"/>
                                            <ComboBoxItem Content="🌙 Chế độ Tối" Tag="dark"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Tần suất làm mới -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="15" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Tự động cập nhật thời tiết" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Khoảng thời gian tự động đồng bộ thời tiết mới" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="RefreshIntervalComboBox" SelectedIndex="1" Width="180" VerticalAlignment="Center" SelectionChanged="RefreshIntervalComboBox_SelectionChanged">
                                            <ComboBoxItem Content="15 phút" Tag="15"/>
                                            <ComboBoxItem Content="30 phút (Khuyên dùng)" Tag="30"/>
                                            <ComboBoxItem Content="1 giờ" Tag="60"/>
                                            <ComboBoxItem Content="2 giờ" Tag="120"/>
                                            <ComboBoxItem Content="Chỉ làm mới thủ công" Tag="0"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Bật/tắt hiệu ứng động -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0e7;" FontSize="15" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Hiệu ứng khí quyển động" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Mưa rơi, sấm sét, vầng nắng (Tắt để tiết kiệm pin/RAM)" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="EffectsToggle" IsOn="{x:Bind ViewModel.Settings.EnableWeatherEffects, Mode=TwoWay}" Toggled="EffectsToggle_Toggled" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Tối ưu tiết kiệm pin Laptop thông minh -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf240;" FontSize="15" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Tối ưu tiết kiệm pin cho Laptop (Smart Battery Saver)" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Tự động tạm dừng hiệu ứng mưa/sấm sét động và giãn tài nguyên khi máy tính dùng pin hoặc bật Tiết kiệm pin của Windows" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="BatterySaverToggle" IsOn="{x:Bind ViewModel.Settings.EnableBatterySaverOptimization, Mode=TwoWay}" Toggled="BatterySaverToggle_Toggled" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Mức RAM tiêu thụ -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2db;" FontSize="15" Foreground="#10B981" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Mức chiếm dụng RAM hiện tại" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Đã tối ưu Native Engine, không chạy WebView2 Chrome nền" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#2010B981" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.RamUsageDisplay, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PANEL 6: GIỚI THIỆU & CHANGELOG -->
                        <ScrollViewer x:Name="PanelAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Giới Thiệu &amp; Nhật Ký Phiên Bản" FontSize="16" FontWeight="Bold"/>
