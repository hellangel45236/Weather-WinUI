                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" FontSize="16" Foreground="#A855F7" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Kiểu dáng Widget" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Glass Card đầy đủ hoặc Compact Bar thanh gọn" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2" x:Name="WidgetStyleComboBox" Width="180" SelectionChanged="WidgetStyleComboBox_SelectionChanged">
                                                <ComboBoxItem Content="✨ Dribbble Dynamic (Đổi màu)" Tag="BryanCDynamic"/>
                                                <ComboBoxItem Content="🪟 Glass Card (Đầy đủ)" Tag="GlassCard"/>
                                                <ComboBoxItem Content="➖ Compact Bar (Gọn)" Tag="Compact"/>
                                                <ComboBoxItem Content="💊 Mini Island (Viên thuốc)" Tag="MiniIsland"/>
