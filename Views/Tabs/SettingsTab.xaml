                        <!-- PANEL 3: WIDGET DESKTOP -->
                        <ScrollViewer x:Name="PanelWidget" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Widget Mini Desktop" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Tùy chỉnh tiện ích thời tiết mini nổi trên màn hình Desktop" FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="14">
