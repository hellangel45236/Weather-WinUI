                        <!-- BANNER HUY HIỆU & LỜI CHÚC MÙA / ĐẠI LỄ HỘI (HERO SEASONAL FESTIVE BANNER) -->
                        <Border x:Name="HeroSeasonalBanner"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{x:Bind ViewModel.CurrentSeasonalSkin.BorderStrokeHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                Padding="12,7"
                                Margin="0,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush x:Name="HeroBannerBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="HeroBannerStop0" Color="#45E11D48" Offset="0"/>
                                    <GradientStop x:Name="HeroBannerStop1" Color="#25F59E0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <!-- Huy hiệu Emoji & Tên Skin nổi bật -->
                                    <Border CornerRadius="8" Padding="7,2" VerticalAlignment="Center"
                                            Background="{x:Bind ViewModel.CurrentSeasonalSkin.BadgeBackgroundHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                            BorderBrush="{x:Bind ViewModel.CurrentSeasonalSkin.BorderStrokeHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentSeasonalSkin.BadgeEmoji, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentSeasonalSkin.DisplayName, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Lời chúc / Câu thơ mùa lễ hội -->
                                    <TextBlock Text="{x:Bind ViewModel.SeasonalGreetingText, Mode=OneWay}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#FEF08A" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Nút Đổi Chủ Đề Mùa & Lễ Hội có Flyout ngay trên Hero Card -->
                                <Button Grid.Column="1"
                                        x:Name="HeroSeasonalSwitchButton"
                                        Background="#26FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9,4"
                                        ToolTipService.ToolTip="Chọn chủ đề 4 Mùa &amp; 4 Đại Lễ Hội"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf53f;" FontSize="10.5" Foreground="White"/>
                                        <TextBlock Text="Đổi chủ đề" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <Border Width="280" Padding="4">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="CHỦ ĐỀ 4 MÙA &amp; ĐẠI LỄ HỘI" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="6,2,6,4"/>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="📅" FontSize="13"/>
                                                            <TextBlock Text="Tự Động Theo Lịch &amp; Tiết Khí" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="4,2"/>
                                                    <TextBlock Text="4 ĐẠI LỄ HỘI LỚN" FontSize="10.5" FontWeight="Bold" Opacity="0.7" Margin="6,2,6,2"/>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Tet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="🧧" FontSize="13"/>
                                                            <TextBlock Text="Tết Cổ Truyền (Hoàng Kim)" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="MidAutumn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="🥮" FontSize="13"/>
                                                            <TextBlock Text="Tết Trung Thu (Dạ Nguyệt)" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Christmas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="🎄" FontSize="13"/>
                                                            <TextBlock Text="Giáng Sinh &amp; Năm Mới" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Halloween" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="🎃" FontSize="13"/>
                                                            <TextBlock Text="Lễ Hội Halloween" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="4,2"/>
                                                    <TextBlock Text="4 MÙA TRONG NĂM" FontSize="10.5" FontWeight="Bold" Opacity="0.7" Margin="6,2,6,2"/>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Spring" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="🌸" FontSize="13"/>
                                                            <TextBlock Text="Mùa Xuân (Spring Bloom)" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Summer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="☀️" FontSize="13"/>
                                                            <TextBlock Text="Mùa Hạ (Tropical Oasis)" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Autumn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="🍁" FontSize="13"/>
                                                            <TextBlock Text="Mùa Thu (Amber Romance)" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="HeroSeasonalItem_Click" Tag="Winter" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="❄️" FontSize="13"/>
                                                            <TextBlock Text="Mùa Đông (Nordic Aurora)" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- HÀNG 2: THANH THÔNG TIN THỜI GIAN, LỊCH ÂM & ĐỊNH DẠNG 12/24H -->
                        <Border Background="#200F172A" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="12" Padding="12,7">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Đồng hồ phát sáng -->
                                    <Border Background="#2A38BDF8" BorderBrush="#5038BDF8" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" Foreground="#38BDF8" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ngày dương lịch -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" Foreground="White" Opacity="0.75" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentDateDisplay, Mode=OneWay}" FontSize="12.5" Foreground="White" Opacity="0.95" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="•" Foreground="White" Opacity="0.35" VerticalAlignment="Center"/>

                                    <!-- Lịch Âm & 24 Tiết Khí -->
                                    <Border Background="#20FEF08A" BorderBrush="#35FEF08A" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" Foreground="#FEF08A" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LunarDateText, Mode=OneWay}" FontSize="11.5" Foreground="#FEF08A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Nút 12h/24h -->
                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.ToggleTimeFormatCommand}"
                                        Background="#28FFFFFF"
                                        BorderBrush="#50FFFFFF"
                                        BorderThickness="1"
                                        Foreground="White"
                                        CornerRadius="14"
                                        Padding="11,4"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.Toggle1224HoursTooltip, Mode=OneWay}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f2;" FontSize="10" Foreground="#38BDF8"/>
                                        <TextBlock Text="{x:Bind ViewModel.TimeFormatLabel, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- HÀNG 3: BENTO 2 CỘT BẤT ĐỐI XỨNG (HERO BENTO GRID) -->
                        <Grid x:Name="HeroBentoGrid" ColumnSpacing="14" RowSpacing="12" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HeroBentoLeftCol" Width="1.25*"/>
                                <ColumnDefinition x:Name="HeroBentoRightCol" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="HeroBentoRow1" Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CỘT TRÁI (HERO BENTO LEFT): TRỌNG TÂM THỜI TIẾT HIỆN TẠI -->
                            <Border x:Name="HeroBentoLeftCard" Grid.Column="0" Grid.Row="0"
                                    Background="#260F172A" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Padding="20,16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                    <!-- Nhiệt độ, Tình trạng & Cảm giác -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <!-- Nhiệt độ lớn (Click đổi °C / °F) -->
                                        <Button Command="{x:Bind ViewModel.ToggleUnitCommand}"
                                                Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.UnitTooltip, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}"
                                                       FontSize="68" FontWeight="Bold" Foreground="White"/>
                                        </Button>

                                        <!-- Mô tả trạng thái thời tiết -->
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}"
                                                   FontSize="21" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>

                                        <!-- Cảm giác như & Thấp / Cao -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.95" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="10.5" Foreground="#38BDF8"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.FeelsLikeText, Mode=OneWay}" FontSize="12.5" Foreground="White"/>
                                            </StackPanel>
                                            <TextBlock Text="•" Foreground="White" Opacity="0.4"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.MinMaxText, Mode=OneWay}" FontSize="12.5" Foreground="White" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Badges hàng ngang -->
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
                                            <!-- Alert badge -->
                                            <Border Visibility="{x:Bind ViewModel.CurrentWeather.HasWeatherAlertBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{x:Bind ViewModel.CurrentWeather.WeatherAlertBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="8" Padding="8,3">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WeatherAlertBadgeText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- AQI badge -->
                                            <Border Visibility="{x:Bind ViewModel.CurrentWeather.HasAqi, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="{x:Bind ViewModel.CurrentWeather.AqiColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="8" Padding="8,3"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.Loc.AirQualityTooltip, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="10" Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="AQI" FontSize="9.5" FontWeight="Bold" Foreground="White" Opacity="0.9"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Rain Probability badge -->
                                            <Border Visibility="{x:Bind ViewModel.CurrentWeather.HasRainChance, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Background="#250EA5E9" BorderBrush="#500EA5E9" BorderThickness="1"
                                                    CornerRadius="8" Padding="8,3"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.Loc.RainChance, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="10" Foreground="#38BDF8"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.RainProbabilityText, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Biểu tượng thời tiết SVG Vector động lơ lửng -->
                                    <Grid Grid.Column="1" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="WeatherIconFloatTransform" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Image x:Name="WeatherSvgImage" Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <FontIcon x:Name="FallbackWeatherIcon" FontFamily="{StaticResource FontAwesomeSolid}"
                                                  Glyph="{x:Bind ViewModel.CurrentWeather.IconGlyph, Mode=OneWay}"
                                                  FontSize="54" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- CỘT PHẢI (HERO BENTO RIGHT): AI BRIEFING & LỜI KHUYÊN NỔI BẬT HÔM NAY -->
                            <Border x:Name="HeroBentoRightCard" Grid.Column="1" Grid.Row="0"
                                    Background="#260F172A" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="16" Padding="18,16">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <!-- AI Briefing -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#2A38BDF8" BorderBrush="#6038BDF8" BorderThickness="1.5" VerticalAlignment="Top">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0eb;" FontSize="15" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Border Background="#FBBF24" CornerRadius="5" Padding="6,1.5">
                                                    <TextBlock Text="AI BRIEFING" FontSize="9" FontWeight="Bold" Foreground="#0F172A"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind ViewModel.Loc.AiBriefingHeader, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AiBriefingSummaryText" Text="{x:Bind ViewModel.CurrentWeather.SmartSummaryText, Mode=OneWay}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" LineHeight="18"/>

                                            <!-- Hàng 3 Smart Action Pills trực quan (Quick Scannable Intelligence) -->
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.QuickAdvicePills, Mode=OneWay}" Margin="0,3,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:WeatherAdvice">
                                                        <Border Background="#25FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,3">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="10" Foreground="#FDE047"/>
                                                                <TextBlock Text="{x:Bind Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#25FFFFFF"/>

                                    <!-- Lời khuyên nổi bật hôm nay & Nút mở rộng -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#30F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" Foreground="#FBBF24" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Loc.AdviceHeader, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="#FDE047"/>
                                            <TextBlock Text="{x:Bind ViewModel.TopAdviceSummary, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.ToggleAdviceExpandedCommand}"
                                                Background="#35FFFFFF" Foreground="White" CornerRadius="9" Padding="10,5"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ExpandAdviceTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{x:Bind ViewModel.AdviceExpandButtonText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.AdviceExpandIconGlyph, Mode=OneWay}" FontSize="9"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- KHUNG XỔ XUỐNG 5 LỜI KHUYÊN SINH HOẠT CHI TIẾT -->
                        <StackPanel x:Name="AdviceDetailsPanel"
                                    Visibility="{x:Bind ViewModel.IsAdviceExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Spacing="8" Margin="0,4,0,0">
                            <Border Height="1" Background="#35FFFFFF" Margin="0,2,0,2"/>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.AdviceList, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WeatherAdvice">
                                        <Border Background="#33000000" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                        Background="#35FFFFFF" VerticalAlignment="Top" Margin="0,2,12,0">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                              FontSize="14" Foreground="#FDE047"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Category}" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" CharacterSpacing="50"/>
                                                        <Border Grid.Column="1" Background="{x:Bind BadgeBackground, Converter={StaticResource HexToBrushConverter}}" CornerRadius="5" Padding="6,2">
                                                            <TextBlock Text="{x:Bind BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="#F1F5F9" Opacity="0.92" TextWrapping="Wrap" LineHeight="18"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!-- =================================================================================== -->
            <!-- 2. LƯỚI 8 CHỈ SỐ KHÍ TƯỢNG TRỰC QUAN HOÁ (VISUAL GAUGES METRICS GRID)                 -->
            <!-- =================================================================================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf080;" FontSize="15" Foreground="#38BDF8"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.TodayWeatherDetails, Mode=OneWay}" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1838BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="{x:Bind ViewModel.Loc.EssentialMetrics, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="MetricsGrid" RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="MetricsRow2" Height="Auto"/>
                            <RowDefinition x:Name="MetricsRow3" Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="MetricsCol2" Width="*"/>
                            <ColumnDefinition x:Name="MetricsCol3" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. CHỈ SỐ UV (QUANG PHỔ 5 MỨC ĐỘ) -->
                        <Border x:Name="CardUv" Grid.Row="0" Grid.Column="0"
                                Tag="UvIndex" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#25D97706" BorderBrush="#45D97706" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.UvIndex, Mode=OneWay}" FontSize="12.5" Opacity="0.9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UvIndexText, Mode=OneWay}" FontSize="26" FontWeight="Bold"/>
                                    <Border Background="#20D97706" BorderBrush="#50D97706" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UvIndexDescription, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                                    </Border>
                                </StackPanel>

                                <!-- Thanh quang phổ UV trực quan -->
                                <Border Height="6" CornerRadius="3" Margin="0,2,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                             <GradientStop Color="#10B981" Offset="0.0"/>
                                             <GradientStop Color="#FBBF24" Offset="0.3"/>
                                             <GradientStop Color="#F97316" Offset="0.6"/>
                                             <GradientStop Color="#EF4444" Offset="0.85"/>
                                             <GradientStop Color="#A855F7" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Canvas con trỏ vị trí UV -->
                                <Canvas x:Name="UvGaugeCanvas" IsHitTestVisible="False" Height="8" HorizontalAlignment="Stretch" Margin="0,-2,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,-4,0,0" Opacity="0.65">
                                    <TextBlock Grid.Column="0" Text="0" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="5" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="11+" FontSize="10"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. KHÔNG KHÍ (AQI & PM2.5) -->
                        <Border x:Name="CardAqi" Grid.Row="0" Grid.Column="1"
                                Tag="AirQuality" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#2510B981" BorderBrush="#4510B981" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" Foreground="#10B981" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.AirQuality, Mode=OneWay}" FontSize="12.5" Opacity="0.9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="US-AQI" FontSize="11" Opacity="0.65" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    <Border Background="{x:Bind ViewModel.CurrentWeather.AqiColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiDescription, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Thanh quang phổ AQI trực quan -->
                                <Border Height="6" CornerRadius="3" Margin="0,2,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#10B981" Offset="0.0"/>
                                            <GradientStop Color="#FACC15" Offset="0.25"/>
                                            <GradientStop Color="#FB923C" Offset="0.5"/>
                                            <GradientStop Color="#F87171" Offset="0.75"/>
                                            <GradientStop Color="#C084FC" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Canvas con trỏ vị trí AQI -->
                                <Canvas x:Name="AqiGaugeCanvas" IsHitTestVisible="False" Height="8" HorizontalAlignment="Stretch" Margin="0,-2,0,0"/>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,-4,0,0">
                                    <TextBlock Grid.Column="0" Text="PM2.5:" FontSize="10.5" Opacity="0.7" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.Pm25Text, Mode=OneWay}" FontSize="10.5" Opacity="0.95" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. GIÓ & LA BÀN HƯỚNG GIÓ TRỰC QUAN -->
                        <Border x:Name="CardWind" Grid.Row="0" Grid.Column="2"
                                Tag="Wind" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#25059669" BorderBrush="#45059669" BorderThickness="1">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" Foreground="#10B981" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.WindAndDirection, Mode=OneWay}" FontSize="12.5" Opacity="0.9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindDirectionText, Mode=OneWay}" FontSize="11.5" Opacity="0.85" FontWeight="Medium" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- La bàn mini chỉ hướng gió xoay theo độ thực tế -->
                                <Grid Grid.Column="1" Width="56" Height="56" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Ellipse Width="54" Height="54" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1.5" Fill="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                    <Ellipse Width="36" Height="36" Stroke="#2010B981" StrokeThickness="1" StrokeDashArray="2,2"/>
                                    <TextBlock Text="N" FontSize="8" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <TextBlock Text="S" FontSize="7.5" FontWeight="Bold" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    <TextBlock Text="E" FontSize="7.5" FontWeight="Bold" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="W" FontSize="7.5" FontWeight="Bold" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>

                                    <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="WindNeedleRotate" Angle="0"/>
                                        </Grid.RenderTransform>
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf062;" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Ellipse Width="4" Height="4" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 4. ĐỘ ẨM & ĐIỂM SƯƠNG -->
                        <Border x:Name="CardHumidity" Grid.Row="0" Grid.Column="3"
                                Tag="Humidity" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#250284C7" BorderBrush="#450284C7" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" Foreground="#38BDF8" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.Humidity, Mode=OneWay}" FontSize="12.5" Opacity="0.9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="26" FontWeight="Bold"/>

                                <ProgressBar Value="{x:Bind ViewModel.CurrentWeather.HumidityValue, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="#0284C7" Margin="0,2,0,0"/>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.DewPoint, Mode=OneWay}" FontSize="10.5" Opacity="0.7" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.DewPointText, Mode=OneWay}" FontSize="10.5" Opacity="0.95" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 5. KHẢ NĂNG MƯA & LƯỢNG MƯA -->
                        <Border x:Name="CardRain" Grid.Row="1" Grid.Column="0"
                                Tag="Rain" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#250EA5E9" BorderBrush="#450EA5E9" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" Foreground="#0EA5E9" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.RainChance, Mode=OneWay}" FontSize="12.5" Opacity="0.9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.RainProbabilityText, Mode=OneWay}" FontSize="26" FontWeight="Bold"/>

                                <ProgressBar Value="{x:Bind ViewModel.CurrentWeather.RainProbabilityValue, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3" Foreground="#0EA5E9" Margin="0,2,0,0"/>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.Precipitation, Mode=OneWay}" FontSize="10.5" Opacity="0.7" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.PrecipitationText, Mode=OneWay}" FontSize="10.5" Opacity="0.95" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 6. ÁP SUẤT KHÍ QUYỂN -->
                        <Border x:Name="CardPressure" Grid.Row="1" Grid.Column="1"
                                Tag="Pressure" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#257C3AED" BorderBrush="#457C3AED" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf14e;" Foreground="#7C3AED" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.Pressure, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.PressureText, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                                    <Border Background="#187C3AED" BorderBrush="#357C3AED" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.PressureTrendText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#7C3AED"/>
                                    </Border>
                                </StackPanel>

                                <!-- Sparkline xu hướng áp suất 6 giờ -->
                                <Canvas x:Name="PressureSparklineCanvas" Height="20" HorizontalAlignment="Stretch" Margin="0,2,0,0" IsHitTestVisible="False"/>

                                <TextBlock Text="{x:Bind ViewModel.Loc.SeaPressureDesc, Mode=OneWay}" FontSize="10" Opacity="0.8" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 7. VÒNG CUNG MẶT TRỜI & MẶT TRĂNG -->
                        <Border x:Name="CardSunMoon" Grid.Row="1" Grid.Column="2"
                                Tag="SunMoon" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,12">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#25EAB308" BorderBrush="#45EAB308" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#D97706" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.SunAndMoon, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="#1838BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.SunStatusText, Mode=OneWay}" FontSize="9.5" Foreground="#0284C7" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="105"/>
                                    </Border>
                                </Grid>

                                <Canvas x:Name="SunArcCanvas" IsHitTestVisible="False" Height="36" Margin="2,2" HorizontalAlignment="Stretch"/>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="10" Foreground="#D97706" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.SunriseText, Mode=OneWay}" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" FontSize="10" Foreground="#6366F1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.SunsetText, Mode=OneWay}" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 8. CHI TIẾT Ô NHIỄM & BỤI MỊN -->
                        <Border x:Name="CardPollutants" Grid.Row="1" Grid.Column="3"
                                Tag="Pollutants" Tapped="MetricCard_Tapped"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClickHint, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#2510B981" BorderBrush="#4510B981" BorderThickness="1">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf132;" Foreground="#059669" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.AirQualitySub, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,2,0,0">
                                    <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="8,5">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="PM10" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.Pm10Text, Mode=OneWay}" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="8,5">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Ozone (O₃)" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.OzoneText, Mode=OneWay}" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="NO₂:" FontSize="10.5" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.No2Text, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =================================================================================== -->
            <!-- 2.5. DỰ BÁO MƯA 60 PHÚT TỚI (60-MINUTE PRECIPITATION NOWCAST — v3.6.0)              -->
            <!-- =================================================================================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#200EA5E9" BorderBrush="#400EA5E9" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11.5" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="60-MINUTE PRECIPITATION NOWCAST" FontSize="11.5" FontWeight="Bold" Foreground="#0EA5E9" CharacterSpacing="40" VerticalAlignment="Center"/>
                            <Border Background="#180EA5E9" BorderBrush="#400EA5E9" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.NowcastBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.NowcastHeadline, Mode=OneWay}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.NowcastSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 12 Five-Minute Intensity Bars (+5m .. +60m) -->
                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.NowcastBars, Mode=OneWay}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NowcastBarItem">
                                <StackPanel Spacing="4" Width="26" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind IntensityLabel}">
                                    <Grid Height="44" VerticalAlignment="Bottom">
                                        <Border Width="14" Height="44" CornerRadius="4" Background="#14FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        <Border Width="14" Height="{x:Bind BarHeight}" CornerRadius="4"
                                                Background="{x:Bind FluentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind MinuteLabel}" FontSize="9" Opacity="0.65" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- =================================================================================== -->
            <!-- 3. DỰ BÁO & DÒNG THỜI GIAN 24 GIỜ (UNIFIED INTERACTIVE HOURLY FORECAST & TIMELINE)    -->
            <!-- =================================================================================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16">
                <StackPanel Spacing="14">
                    <!-- Header: Tiêu đề + Huy hiệu Realtime + Trạng thái Scrubber + Nút Về hiện tại -->
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <!-- Tiêu đề + LIVE badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf017;" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.Loc.HourlyForecast, Mode=OneWay}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            
                            <!-- Huy hiệu REALTIME -->
                            <Border Background="#1A10B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#10B981"/>
                                    <TextBlock Text="REALTIME" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Giữa / Phải: Badge khi đang xem giờ tua + Nút Quay lại bây giờ -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Visibility="{x:Bind ViewModel.IsTimeScrubbingActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#2538BDF8" BorderBrush="#6038BDF8" BorderThickness="1" CornerRadius="8" Padding="10,3">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06e;" FontSize="10" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.ScrubbedTimeLabel, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="•" Foreground="#38BDF8" Opacity="0.5"/>
                                    <TextBlock Text="{x:Bind ViewModel.ScrubbedTempText, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>

                            <Button Click="ResetScrubberButton_Click"
                                    Visibility="{x:Bind ViewModel.IsTimeScrubbingActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#2010B981"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,4"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ResetScrubberTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="10.5" Foreground="#10B981"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.ResetScrubber, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- THANH CHUYỂN ĐỔI CHỈ SỐ BIỂU ĐỒ (HOURLY METRIC SEGMENTED PILL SWITCHER) -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Padding="4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- Nút Nhiệt độ -->
                            <Button x:Name="BtnHourlyTemp" Click="HourlyMetricTab_Click" Tag="Temperature"
                                    Background="#2538BDF8" BorderBrush="#6038BDF8" BorderThickness="1"
                                    CornerRadius="18" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2c9;" FontSize="11.5" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtHourlyTemp" Text="{x:Bind ViewModel.Loc.HourlyModeTemp, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Khả năng mưa -->
                            <Button x:Name="BtnHourlyRain" Click="HourlyMetricTab_Click" Tag="RainProbability"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="18" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11.5" Foreground="#0EA5E9"/>
                                    <TextBlock x:Name="TxtHourlyRain" Text="{x:Bind ViewModel.Loc.HourlyModeRain, Mode=OneWay}" FontSize="11.5" FontWeight="Normal"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Tốc độ gió -->
                            <Button x:Name="BtnHourlyWind" Click="HourlyMetricTab_Click" Tag="WindSpeed"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="18" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="11.5" Foreground="#10B981"/>
                                    <TextBlock x:Name="TxtHourlyWind" Text="{x:Bind ViewModel.Loc.HourlyModeWind, Mode=OneWay}" FontSize="11.5" FontWeight="Normal"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Tia UV -->
                            <Button x:Name="BtnHourlyUv" Click="HourlyMetricTab_Click" Tag="UvIndex"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="18" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11.5" Foreground="#F59E0B"/>
                                    <TextBlock x:Name="TxtHourlyUv" Text="{x:Bind ViewModel.Loc.HourlyModeUv, Mode=OneWay}" FontSize="11.5" FontWeight="Normal"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- DANH SÁCH CUỘN NGANG KÈM ĐƯỜNG CONG SPLINE 24H -->
                    <ScrollViewer x:Name="HourlyScrollViewer" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Disabled" 
                                  HorizontalScrollMode="Enabled"
                                  PointerWheelChanged="HourlyScrollViewer_PointerWheelChanged">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <!-- Đường cong Spline 24h kèm con trỏ từ tính Magnetic Hover Scrubber (v3.1.0) -->
                            <Canvas x:Name="HourlyTrendlineCanvas" Height="80" HorizontalAlignment="Left"
                                    Background="Transparent"
                                    PointerMoved="HourlyTrendlineCanvas_PointerMoved"
                                    PointerExited="HourlyTrendlineCanvas_PointerExited"
                                    PointerPressed="HourlyTrendlineCanvas_PointerPressed"/>

                            <!-- Các thẻ giờ dự báo -->
                            <ItemsControl x:Name="HourlyItemsControl" ItemsSource="{x:Bind ViewModel.HourlyForecast, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HourlyForecastItem">
                                        <Button Click="HourlyCard_Click"
                                                Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToHourlyCardBackgroundConverter}}"
                                                BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToHourlyCardBorderBrushConverter}}"
                                                BorderThickness="1.5"
                                                CornerRadius="12"
                                                Padding="8,10"
                                                Width="82"
                                                Height="130">
                                            <Grid RowDefinitions="Auto,Auto,*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <!-- Hàng 0: Giờ (kèm badge NOW nếu là hiện tại) -->
                                                <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind TimeDisplay}" FontSize="11.5" 
                                                               FontWeight="{x:Bind IsNow, Converter={StaticResource BoolToFontWeightConverter}}"
                                                               Foreground="{x:Bind IsNow, Converter={StaticResource BoolToSunColorConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                    <Border Visibility="{x:Bind IsNow, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="#2538BDF8" BorderBrush="#5038BDF8" BorderThickness="1"
                                                            CornerRadius="4" Padding="4,0" HorizontalAlignment="Center">
                                                        <TextBlock Text="NOW" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Hàng 1: Biểu tượng thời tiết -->
                                                <Grid Grid.Row="1" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,4,0,2">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="19" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Hàng 2: Giá trị chỉ số chính (Nhiệt độ / Xác suất mưa / Gió / UV) -->
                                                <TextBlock Grid.Row="2" Text="{x:Bind PrimaryMetricText, Mode=OneWay}" 
                                                           FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Hàng 3: Chỉ số phụ (Khả năng mưa % / Lượng mưa / Hướng gió / Mức độ UV) -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind SecondaryIconGlyph, Mode=OneWay}" FontSize="9" 
                                                              Foreground="{x:Bind SecondaryColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind SecondaryMetricText, Mode=OneWay}" FontSize="10" 
                                                               Foreground="{x:Bind SecondaryColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" FontWeight="Medium" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- =================================================================================== -->
            <!-- 4. DỰ BÁO 7 NGÀY TỚI (DAILY FORECAST)                                                -->
            <!-- =================================================================================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.Loc.DailyForecast, Mode=OneWay}" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Danh sách theo ngày -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DailyForecast, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DailyForecastItem">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="110,Auto,*,Auto,110,Auto">
                                        <!-- Tên ngày & ngày tháng (kèm badge NOW nếu là hôm nay) -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Border Visibility="{x:Bind IsToday, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                                    <TextBlock Text="NOW" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind DateDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Icon Thời Tiết & Tỷ lệ mưa -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,12,0">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="#F59E0B" VerticalAlignment="Center" Width="20" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind RainProbabilityText}" FontSize="11" Foreground="#0099BC" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Mô tả thời tiết -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind ConditionText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0"/>

                                        <!-- Nhiệt độ Thấp nhất -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind TempMinDisplay}" FontSize="12.5" Opacity="0.7" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                        <!-- Thanh Đo Nhiệt Độ Tuần (Apple Weather-Style Weekly Range Bar v3.1.0) -->
                                        <Grid Grid.Column="4" Width="100" Height="16" VerticalAlignment="Center" Margin="8,0">
                                            <Border Height="6" CornerRadius="3" Background="#22FFFFFF" VerticalAlignment="Center"/>
                                            <Border Height="6" CornerRadius="3" Width="{x:Bind BarWidth}" Margin="{x:Bind BarMarginThickness}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#38BDF8" Offset="0.0"/>
                                                        <GradientStop Color="#34D399" Offset="0.35"/>
                                                        <GradientStop Color="#FBBF24" Offset="0.7"/>
                                                        <GradientStop Color="#F87171" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- Chấm chỉ báo nhiệt độ hiện tại kèm quầng sáng Halo cho ngày hôm nay -->
                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{x:Bind CurrentTempDotMargin}"
                                                  Visibility="{x:Bind ShowCurrentIndicator, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Ellipse Width="12" Height="12" Fill="#45FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Width="7" Height="7" Fill="White" Stroke="#0F172A" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Nhiệt độ Cao nhất -->
                                        <TextBlock Grid.Column="5" Text="{x:Bind TempMaxDisplay}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- =================================================================================== -->
            <!-- NOTHING OS OVERVIEW CONTAINER (AUTHENTIC NOTHING OS AESTHETIC v3.5.0)               -->
            <!-- =================================================================================== -->
            <!-- =================================================================================== -->
            <!-- NOTHING OS OVERVIEW CONTAINER (AUTHENTIC NOTHING OS AESTHETIC v3.5.0)               -->
            <!-- =================================================================================== -->
            <StackPanel x:Name="NothingOverviewContainer"
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.IsNothingDesign, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- 1. TACTICAL OBSERVATION HEADER BAR -->
                <Border x:Name="NothingHeaderBorder"
                        Background="{ThemeResource NothingCardBackgroundBrush}"
                        BorderBrush="{ThemeResource NothingCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <!-- Left: Station Identification -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NothingStationTitle" Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="20" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{ThemeResource NothingRedBrush}"
                                    CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.CityIataCode, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="White"/>
                            </Border>

                            <Border x:Name="NothingHeaderPill1" Visibility="Collapsed" Background="{ThemeResource NothingPillBackgroundBrush}"
                                    BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="NothingHeaderStationSub" Text="ACTIVE STATION // METEO-NDOT" FontSize="10" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="NothingHeaderPill2" Background="{ThemeResource NothingPillBackgroundBrush}"
                                    BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="NothingHeaderCoordSub" Text="{x:Bind ViewModel.CurrentWeather.FormattedCoordinates, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right: Live Sensor Telemetry Badge & Time -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource NothingGreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="TELEMETRY: LIVE" FontSize="11" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingGreenBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="NothingHeaderTimePill" Background="{ThemeResource NothingPillBackgroundBrush}"
                                    BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,4">
                                <TextBlock x:Name="NothingHeaderTimeVal" Text="{x:Bind ViewModel.CurrentWeather.UpdatedTimeText, Mode=OneWay}"
                                           FontSize="11" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                           Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. HERO BENTO MASTERPIECE: ASYMMETRIC GRID (Cols 8 & 4) -->
                <Grid ColumnDefinitions="*,360" ColumnSpacing="20">
                    <!-- Col 0: Big Bento Weather Hero Card -->
                    <Border x:Name="NothingHeroBorder"
                            Grid.Column="0"
                            Background="{ThemeResource NothingCardBackgroundBrush}"
                            BorderBrush="{ThemeResource NothingCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="28,24">
                        <StackPanel Spacing="20">
                            <!-- Top Technical Tag -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="CURRENT OBSERVATION"
                                               FontSize="11.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                               Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                </StackPanel>
                                <Border x:Name="NothingHeroSensorPill" Grid.Column="1" Background="{ThemeResource NothingPillBackgroundBrush}"
                                        BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="LOCAL SENSOR // NDOT-01"
                                               FontSize="10.5" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                               Foreground="{ThemeResource NothingTextMutedBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Center Area: Big Numbers & Weather Glyph Box -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <!-- Left: Large Temperature & Subtitle -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4">
                                        <TextBlock x:Name="NothingTempNumber" Text="{x:Bind ViewModel.CurrentWeather.TemperatureNumberOnly, Mode=OneWay}"
                                                   FontSize="104" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                   Foreground="{ThemeResource NothingTextPrimaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureUnitOnly, Mode=OneWay}"
                                                   FontSize="48" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                   Foreground="{ThemeResource NothingRedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                                    </StackPanel>

                                    <!-- Subtitle stacked layout to avoid clipping -->
                                    <StackPanel Spacing="8">
                                        <Border x:Name="NothingHeroFeelsLikePill" Background="{ThemeResource NothingPillBackgroundBrush}"
                                                BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="NothingFeelsLikeValue" Text="{x:Bind ViewModel.CurrentWeather.FeelsLikeText, Mode=OneWay}"
                                                       FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                       Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="NothingHighLowText" Text="{x:Bind ViewModel.CurrentWeather.HighLowTempText, Mode=OneWay}"
                                                   FontSize="12" FontFamily="{StaticResource NdotFontFamily}"
                                                   Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Nothing Weather Glyph Box -->
                                <Border x:Name="NothingGlyphBoxBorder"
                                        Grid.Column="1"
                                        Width="200" Height="185"
                                        Background="{ThemeResource NothingGlyphBoxBackgroundBrush}"
                                        BorderBrush="{ThemeResource NothingSubCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="22"
                                        Padding="14">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                        <Grid Width="72" Height="68" HorizontalAlignment="Center">
                                            <FontIcon x:Name="NothingHeroIcon" FontFamily="{StaticResource NdotFontFamily}"
                                                      Glyph="{x:Bind ViewModel.CurrentWeather.NothingGlyph, Mode=OneWay}"
                                                      FontSize="56"
                                                      Foreground="{ThemeResource NothingTextPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource NothingRedBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                                        </Grid>
                                        <TextBlock x:Name="NothingConditionTitle" Text="{x:Bind ViewModel.CurrentWeather.FormattedConditionUppercase, Mode=OneWay}"
                                                   FontSize="12" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                   Foreground="{ThemeResource NothingTextPrimaryBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="180"/>
                                        <Border x:Name="NothingHeroConditionPill" Background="{ThemeResource NothingPillBackgroundBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.GlyphConditionEnglish, Mode=OneWay}"
                                                       FontSize="9.5" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                       Foreground="{ThemeResource NothingRedBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom Telemetry Strip (4 Metrics) -->
                            <Border x:Name="NothingHeroMetricsSeparator" BorderBrush="{ThemeResource NothingSubCardBorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                                    <!-- Col 0: Humidity -->
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource NdotFontFamily}" Glyph="&#xF191A;" FontSize="11" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                            <TextBlock Text="HUMIDITY" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NothingHumidityVal" Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                        <ProgressBar x:Name="NothingHumidityProgress" Value="{x:Bind ViewModel.CurrentWeather.HumidityValue, Mode=OneWay}" Maximum="100" Height="5"
                                                     Foreground="{ThemeResource NothingTextPrimaryBrush}" Background="{ThemeResource NothingSubCardBorderBrush}" CornerRadius="2.5"/>
                                    </StackPanel>

                                    <!-- Col 1: Wind Speed -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource NdotFontFamily}" Glyph="&#xF191D;" FontSize="11" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                            <TextBlock Text="WIND SPEED" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NothingWindVal" Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                        <ProgressBar x:Name="NothingWindProgress" Value="{x:Bind ViewModel.CurrentWeather.WindSpeedValue, Mode=OneWay}" Maximum="50" Height="5"
                                                     Foreground="{ThemeResource NothingTextPrimaryBrush}" Background="{ThemeResource NothingSubCardBorderBrush}" CornerRadius="2.5"/>
                                    </StackPanel>

                                    <!-- Col 2: UV Index -->
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource NdotFontFamily}" Glyph="&#xF1964;" FontSize="11" Foreground="{ThemeResource NothingRedBrush}"/>
                                            <TextBlock Text="UV INDEX" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NothingUvProgress" Text="{x:Bind ViewModel.CurrentWeather.UvIndexText, Mode=OneWay}" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingRedBrush}"/>
                                        <ProgressBar Value="{x:Bind ViewModel.CurrentWeather.UvIndexValue, Mode=OneWay}" Maximum="11" Height="5"
                                                     Foreground="{ThemeResource NothingRedBrush}" Background="{ThemeResource NothingSubCardBorderBrush}" CornerRadius="2.5"/>
                                    </StackPanel>

                                    <!-- Col 3: Barometer Pressure -->
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource NdotFontFamily}" Glyph="&#xF1930;" FontSize="11" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                            <TextBlock Text="BAROMETER" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NothingPressureVal" Text="{x:Bind ViewModel.CurrentWeather.PressureText, Mode=OneWay}" FontSize="17" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                        <ProgressBar x:Name="NothingBarometerProgress" Value="60" Maximum="100" Height="5"
                                                     Foreground="{ThemeResource NothingTextPrimaryBrush}" Background="{ThemeResource NothingSubCardBorderBrush}" CornerRadius="2.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Col 1: Right Side Telemetry Stack -->
                    <StackPanel Grid.Column="1" Spacing="20">
                        <!-- Card 1: Glyph AQI Monitor -->
                        <Border x:Name="NothingAqiBorder"
                                Background="{ThemeResource NothingCardBackgroundBrush}"
                                BorderBrush="{ThemeResource NothingCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse x:Name="NothingAqiDot" Width="6" Height="6" Fill="{ThemeResource NothingTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="GLYPH AQI MONITOR" FontSize="11" FontWeight="Bold"
                                                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border x:Name="NothingAqiPm25Pill" Grid.Column="1" Background="{ThemeResource NothingPillBackgroundBrush}"
                                            BorderBrush="{ThemeResource NothingPillBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="6,2">
                                        <TextBlock x:Name="NothingAqiPm25Val" Text="{x:Bind ViewModel.CurrentWeather.Pm25Text, Mode=OneWay}"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                   Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="NothingAqiVal" Text="{x:Bind ViewModel.CurrentWeather.AqiValue, Mode=OneWay}"
                                                   FontSize="46" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                   Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.AqiDescription, Mode=OneWay}"
                                                   FontSize="12" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                   Foreground="{ThemeResource NothingGreenBrush}"/>
                                    </StackPanel>

                                    <!-- Simulated Glyph LED Light Bar (5 dynamic bars) -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <Border x:Name="NothingAqiGlyphBar5" Width="60" Height="5" CornerRadius="2.5" Background="{ThemeResource NothingTextPrimaryBrush}"
                                                Opacity="{x:Bind ViewModel.CurrentWeather.GlyphBar5Opacity, Mode=OneWay}"/>
                                        <Border x:Name="NothingAqiGlyphBar4" Width="60" Height="5" CornerRadius="2.5" Background="{ThemeResource NothingTextPrimaryBrush}"
                                                Opacity="{x:Bind ViewModel.CurrentWeather.GlyphBar4Opacity, Mode=OneWay}"/>
                                        <Border x:Name="NothingAqiGlyphBar3" Width="60" Height="5" CornerRadius="2.5" Background="{ThemeResource NothingTextPrimaryBrush}"
                                                Opacity="{x:Bind ViewModel.CurrentWeather.GlyphBar3Opacity, Mode=OneWay}"/>
                                        <Border x:Name="NothingAqiGlyphBar2" Width="60" Height="5" CornerRadius="2.5" Background="{ThemeResource NothingTextPrimaryBrush}"
                                                Opacity="{x:Bind ViewModel.CurrentWeather.GlyphBar2Opacity, Mode=OneWay}"/>
                                        <Border x:Name="NothingAqiGlyphBar1" Width="60" Height="5" CornerRadius="2.5" Background="{ThemeResource NothingTextPrimaryBrush}"
                                                Opacity="{x:Bind ViewModel.CurrentWeather.GlyphBar1Opacity, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="NothingAqiAdviceSeparator" BorderBrush="{ThemeResource NothingSubCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <TextBlock x:Name="NothingAqiAdviceText" Text="{x:Bind ViewModel.CurrentWeather.AqiAdvice, Mode=OneWay}"
                                               FontSize="11" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                               Foreground="{ThemeResource NothingTextSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="2"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Tactical Compass / Sunset Telemetry -->
                        <Border x:Name="NothingSunsetBorder"
                                Background="{ThemeResource NothingCardBackgroundBrush}"
                                BorderBrush="{ThemeResource NothingCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="WIND &amp; SUNSET TELEMETRY" FontSize="11" FontWeight="Bold"
                                                   FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{ThemeResource NothingRedBrush}"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                    <!-- Mechanical Dial -->
                                    <Border x:Name="NothingCompassDial" Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                                            BorderBrush="{ThemeResource NothingTextSecondaryBrush}" BorderThickness="1.5">
                                        <Grid>
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource NothingRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border x:Name="NothingCompassNeedle" Width="2.5" Height="28" Background="{ThemeResource NothingTextPrimaryBrush}" CornerRadius="1.25"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                                                    RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="{x:Bind ViewModel.CurrentWeather.WindDirectionDegrees, Mode=OneWay}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock Text="N" FontSize="9" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontWeight="Bold"
                                                       Foreground="{ThemeResource NothingRedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                            <TextBlock Text="S" FontSize="9" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontWeight="Bold"
                                                       Foreground="{ThemeResource NothingTextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                            <TextBlock Text="W" FontSize="9" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontWeight="Bold"
                                                       Foreground="{ThemeResource NothingTextSecondaryBrush}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            <TextBlock Text="E" FontSize="9" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontWeight="Bold"
                                                       Foreground="{ThemeResource NothingTextSecondaryBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Telemetry text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="SUNSET" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        <TextBlock x:Name="NothingSunsetValue" Text="{x:Bind ViewModel.CurrentWeather.SunsetText, Mode=OneWay}"
                                                   FontSize="24" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                   Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="SUNRISE:" FontSize="10.5" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextMutedBrush}"/>
                                            <TextBlock x:Name="NothingSunriseValue" Text="{x:Bind ViewModel.CurrentWeather.SunriseText, Mode=OneWay}" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Daylight Trajectory Meter -->
                                <Border x:Name="NothingSunProgressSeparator" BorderBrush="{ThemeResource NothingSubCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <TextBlock x:Name="NothingSunriseSubValue" Grid.Column="0" Text="{x:Bind ViewModel.CurrentWeather.SunriseText, Mode=OneWay}" FontSize="10" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.DaylightTelemetryText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingRedBrush}"/>
                                            <TextBlock x:Name="NothingSunsetSubValue" Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.SunsetText, Mode=OneWay}" FontSize="10" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Height="6" VerticalAlignment="Center">
                                            <ProgressBar x:Name="NothingSunProgressBar" Value="{x:Bind ViewModel.CurrentWeather.SunProgressPercent, Mode=OneWay}" Maximum="1.0" Height="4"
                                                         Foreground="{ThemeResource NothingRedBrush}" Background="{ThemeResource NothingSubCardBorderBrush}" CornerRadius="2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2.5. 60-MINUTE PRECIPITATION NOWCAST: NOTHING GLYPH RADAR MATRIX (v3.6.0) -->
                <Border x:Name="NothingNowcastBorder"
                        Background="{ThemeResource NothingCardBackgroundBrush}"
                        BorderBrush="{ThemeResource NothingCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="24,18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="60-MIN NOWCAST // DỰ BÁO MƯA 60 PHÚT TỚI" FontSize="11.5" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                <Border Background="#22D71921" BorderBrush="#55D71921" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="{x:Bind ViewModel.NowcastBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="Bold"
                                               FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingRedBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="NothingNowcastHeadlineText" Text="{x:Bind ViewModel.NowcastHeadline, Mode=OneWay}"
                                       FontSize="16" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                       Foreground="{ThemeResource NothingTextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="NothingNowcastSubText" Text="{x:Bind ViewModel.NowcastSubtitle, Mode=OneWay}"
                                       FontSize="11.5" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                       Foreground="{ThemeResource NothingTextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ItemsControl x:Name="NothingNowcastItemsControl" Grid.Column="1" ItemsSource="{x:Bind ViewModel.NowcastBars, Mode=OneWay}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NowcastBarItem">
                                    <StackPanel Spacing="5" Width="28" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind IntensityLabel}">
                                        <Grid Height="46" VerticalAlignment="Bottom">
                                            <Border Width="14" Height="46" CornerRadius="3" Background="#18888888" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <Border Width="14" Height="{x:Bind BarHeight}" CornerRadius="3"
                                                    Background="{x:Bind NothingColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <TextBlock Text="{x:Bind MinuteLabel}" FontSize="9" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                   Foreground="#888888" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- 3. 24-HOUR FORECAST: NOTHING DOT-MATRIX TIMELINE STRIP -->
                <Border x:Name="NothingHourlyBorder"
                        Background="{ThemeResource NothingCardBackgroundBrush}"
                        BorderBrush="{ThemeResource NothingCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="24,20">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="24-HOUR TELEMETRY CURVE // DỰ BÁO 24 GIỜ" FontSize="12" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border x:Name="NothingCurveHoverPill" Visibility="Collapsed"
                                        Background="#22D71921" BorderBrush="#66D71921" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                    <TextBlock x:Name="NothingCurveHoverText" Text="14:00 // 31°C // RAIN 10%" FontSize="10" FontWeight="Bold"
                                               FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingRedBrush}"/>
                                </Border>
                                <TextBlock Text="INTERACTIVE SCRUBBER // DOT MATRIX" FontSize="11" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextMutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hourly Horizontal Items + Interactive Nothing Curve Scrubber (v3.6.0) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                            <StackPanel Orientation="Vertical" Spacing="6">
                                <Canvas x:Name="NothingHourlyCurveCanvas" Height="72" HorizontalAlignment="Left"
                                        Background="Transparent"
                                        PointerMoved="NothingHourlyCurveCanvas_PointerMoved"
                                        PointerExited="NothingHourlyCurveCanvas_PointerExited"
                                        PointerPressed="NothingHourlyCurveCanvas_PointerPressed"/>
                                <ItemsControl x:Name="NothingHourlyItemsControl" ItemsSource="{x:Bind ViewModel.HourlyForecast, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:HourlyForecastItem">
                                            <Border Background="{ThemeResource NothingSubCardBackgroundBrush}"
                                                    BorderBrush="{ThemeResource NothingSubCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Width="96"
                                                    Padding="10,14">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TimeDisplay}" FontSize="11" FontFamily="{StaticResource NdotFontFamily}"
                                                               Foreground="{ThemeResource NothingTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <FontIcon FontFamily="{StaticResource NdotFontFamily}" Glyph="{x:Bind NothingGlyph}"
                                                              FontSize="20" Foreground="{ThemeResource NothingTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="{x:Bind TempDisplay}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                               Foreground="{ThemeResource NothingTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind RainProbabilityText}" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                               Foreground="{ThemeResource NothingRedBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 4. 7-DAY FORECAST: NOTHING DAILY PROJECTION -->
                <Border x:Name="NothingDailyBorder"
                        Background="{ThemeResource NothingCardBackgroundBrush}"
                        BorderBrush="{ThemeResource NothingCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="24,20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="7-DAY FORECAST // D&#x1EF0; B&#x00C1;O 7 NG&#x00C0;Y" FontSize="12" FontWeight="Bold"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="RANGE: 7 DAYS // SYNCHRONIZED" FontSize="11"
                                       FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{ThemeResource NothingTextMutedBrush}"/>
                        </Grid>

                        <!-- Daily Items List -->
                        <ItemsControl x:Name="NothingDailyItemsControl" ItemsSource="{x:Bind ViewModel.DailyForecast, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DailyForecastItem">
                                    <Border Background="{ThemeResource NothingSubCardBackgroundBrush}"
                                            BorderBrush="{ThemeResource NothingSubCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16,10"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="120,Auto,*,Auto,110,Auto">
                                            <!-- Day & Date -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DayName}" FontWeight="Bold" FontSize="13" FontFamily="{StaticResource NdotFontFamily}"
                                                           Foreground="{ThemeResource NothingTextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind DateDisplay}" FontSize="11" FontFamily="{StaticResource NdotFontFamily}"
                                                           Foreground="{ThemeResource NothingTextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Icon & Rain -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,12,0">
                                                <FontIcon FontFamily="{StaticResource NdotFontFamily}" Glyph="{x:Bind NothingGlyph}"
                                                          FontSize="18" Foreground="{ThemeResource NothingTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind RainProbabilityText}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}"
                                                           Foreground="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Condition -->
                                            <TextBlock Grid.Column="2" Text="{x:Bind ConditionText}" FontSize="12" FontFamily="{StaticResource NdotFontFamily}"
                                                       Foreground="{ThemeResource NothingTextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>

                                            <!-- Min Temp -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind TempMinDisplay}" FontSize="12.5" FontFamily="{StaticResource NdotFontFamily}"
                                                       Foreground="{ThemeResource NothingTextMutedBrush}" VerticalAlignment="Center"/>

                                            <!-- Clean Range Bar -->
                                            <Grid Grid.Column="4" Width="100" Height="6" VerticalAlignment="Center" Margin="8,0">
                                                <Border Height="5" CornerRadius="2.5" Background="{ThemeResource NothingSubCardBorderBrush}" VerticalAlignment="Center"/>
                                                <Border Height="5" CornerRadius="2.5" Width="{x:Bind BarWidth}" Margin="{x:Bind BarMarginThickness}"
                                                        HorizontalAlignment="Left" Background="{ThemeResource NothingRedBrush}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Max Temp -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind TempMaxDisplay}" FontSize="13.5" FontWeight="Bold" FontFamily="{StaticResource NdotFontFamily}" Foreground="{ThemeResource NothingTextPrimaryBrush}" VerticalAlignment="Center"/>
                
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- =================================================================================== -->
    <!-- 4. MODAL POPUP CHI TIẾT CHỈ SỐ KHÍ TƯỢNG & DỰ BÁO 7 NGÀY (DEEP-DIVE METRIC POPUP)    -->
    <!-- =================================================================================== -->
    <Grid x:Name="MetricDetailOverlay"
          Canvas.ZIndex="999"
          Visibility="Collapsed"
          Opacity="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        
        <!-- Lớp nền mờ (Backdrop) với hiệu ứng làm tối và làm mờ -->
        <Border x:Name="MetricDetailBackdrop"
                Background="#75000000"
                PointerPressed="MetricDetailBackdrop_PointerPressed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- Thẻ Modal Card trung tâm (Fluent Design, Bo góc 18px, Viền tinh tế) -->
        <Border x:Name="MetricDetailCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="660"
                MaxHeight="680"
                Margin="20"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="18"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ModalScaleTransform" ScaleX="0.95" ScaleY="0.95"/>
                    <TranslateTransform x:Name="ModalTranslateTransform" Y="8"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header: Tiêu đề + Icon + Nút X -->
                <Border Grid.Row="0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="18,18,0,0"
                        Padding="18,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                        <!-- Icon badge -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                      Glyph="{x:Bind ViewModel.SelectedMetricDetail.IconGlyph, Mode=OneWay}"
                                      Foreground="{x:Bind ViewModel.SelectedMetricDetail.IconColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                      FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Tiêu đề & Mô tả ngắn -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.Title, Mode=OneWay}"
                                           FontSize="15" FontWeight="Bold"/>
                                <Border Background="{x:Bind ViewModel.SelectedMetricDetail.StatusBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                        CornerRadius="6" Padding="6,1.5">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.StatusBadgeText, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.Subtitle, Mode=OneWay}"
                                       FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Nút Đóng [X] -->
                        <Button Grid.Column="2" Click="CloseMetricModalButton_Click"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="8" Width="32" Height="32" Padding="0"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Loc.MetricPopupClose, Mode=OneWay}">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="13"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <StackPanel Spacing="16">
                        
                        <!-- KHỐI 1: CHỈ SỐ HIỆN TẠI & THƯỚC ĐO QUANG PHỔ -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Loc.EssentialMetrics, Mode=OneWay}"
                                                   FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   CharacterSpacing="40"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.PrimaryValueText, Mode=OneWay}"
                                                       FontSize="30" FontWeight="Bold"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.UnitText, Mode=OneWay}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,4" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.ScaleStandardName, Mode=OneWay}"
                                                   FontSize="10" Opacity="0.75" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.SecondaryInfoText, Mode=OneWay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Thanh thước đo phân cấp độ -->
                                <StackPanel Spacing="4">
                                    <Border Height="8" CornerRadius="4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#10B981" Offset="0.0"/>
                                                <GradientStop Color="#FACC15" Offset="0.35"/>
                                                <GradientStop Color="#F97316" Offset="0.65"/>
                                                <GradientStop Color="#EF4444" Offset="0.9"/>
                                                <GradientStop Color="#A855F7" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Nhãn vạch đo (Min, Mid, Max) -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" Opacity="0.7">
                                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedMetricDetail.GaugeMinLabel, Mode=OneWay}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedMetricDetail.GaugeMidLabel, Mode=OneWay}" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SelectedMetricDetail.GaugeMaxLabel, Mode=OneWay}" FontSize="10"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Giải thích khoa học -->
                                <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="8" Padding="12,9" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf05a;"
                                                  FontSize="12" Foreground="#38BDF8" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedMetricDetail.ScientificExplanation, Mode=OneWay}"
                                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- KHỐI 2: LỜI KHUYÊN & HƯỚNG DẪN HÀNH ĐỘNG THÔNG MINH -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0eb;" FontSize="13" Foreground="#F59E0B"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.MetricPopupAdviceTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedMetricDetail.Advices, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:MetricAdviceItem">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        VerticalAlignment="Top" Margin="0,1,10,0">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                                              Glyph="{x:Bind IconGlyph}" FontSize="13"
                                                              Foreground="{x:Bind IconColor, Converter={StaticResource HexToBrushConverter}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{x:Bind Category}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        <Border Grid.Column="1" Background="{x:Bind BadgeBackground, Converter={StaticResource HexToBrushConverter}}" CornerRadius="5" Padding="5,1.5">
                                                            <TextBlock Text="{x:Bind BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- KHỐI 3: DỰ BÁO 7 NGÀY TIẾP THEO CỦA RIÊNG CHỈ SỐ NÀY -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf073;" FontSize="13" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.MetricPopup7DayTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Loc.MetricPopupWeekCompare, Mode=OneWay}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="12,10">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedMetricDetail.DailyTrends, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:MetricDailyTrendItem">
                                            <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                    CornerRadius="8" Padding="10,6">
                                                <Grid ColumnDefinitions="84,28,*,100,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <!-- Tên thứ & Ngày -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind DayName}" FontSize="11.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind DateDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Icon thời tiết ngày đó -->
                                                    <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}"
                                                              Glyph="{x:Bind IconGlyph}" FontSize="13" Foreground="#F59E0B"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <!-- Giá trị chỉ số & Mô tả -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind ValueText}" FontSize="12" FontWeight="Bold"/>
                                                        <TextBlock Text="{x:Bind ExtraInfo}" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Thanh đo tương đối giữa các ngày -->
                                                    <ProgressBar Grid.Column="3" Value="{x:Bind BarPercent}" Minimum="0" Maximum="1" Height="5" CornerRadius="2.5"
                                                                 Foreground="{x:Bind BarColor, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center"/>

                                                    <!-- Huy hiệu trạng thái -->
                                                    <Border Grid.Column="4" Background="{x:Bind BarColor, Converter={StaticResource HexToBrushConverter}}"
                                                            CornerRadius="5" Padding="6,2" MinWidth="48" HorizontalAlignment="Right">
                                                        <TextBlock Text="{x:Bind StatusBadge}" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Nút Đóng -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,18,18"
                        Padding="16,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Click="CloseMetricModalButton_Click"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                CornerRadius="8" Padding="16,5">
                            <TextBlock Text="{x:Bind ViewModel.Loc.MetricPopupClose, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- =================================================================================== -->
    <!-- 5. MODAL SO SÁNH THỜI TIẾT ĐỐI ĐẦU 2 THÀNH PHỐ (WEATHER DUEL COMPARISON v3.0.9)     -->
    <!-- =================================================================================== -->
    <Grid x:Name="WeatherComparisonOverlay"
          Canvas.ZIndex="1000"
          Visibility="{x:Bind ViewModel.IsComparisonOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- Nền mờ Backdrop -->
        <Border x:Name="WeatherComparisonBackdrop"
                Background="#7A000000"
                PointerPressed="WeatherComparisonBackdrop_PointerPressed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- Thẻ Modal Đối Đầu (Fluent Glass Card) -->
        <Border x:Name="WeatherComparisonCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="740"
                MaxHeight="700"
                Margin="20"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ComparisonScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="ComparisonTranslateTransform" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- HEADER: Tiêu đề + Huy hiệu + Nút X -->
                <Border Grid.Row="0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="20,20,0,0"
                        Padding="20,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                                Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                      Glyph="&#xf362;" FontSize="16" Foreground="#38BDF8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WeatherComparisonTitle, Mode=OneWay}"
                                           FontSize="15" FontWeight="Bold"/>
                                <Border Background="#2538BDF8" BorderBrush="#5038BDF8" BorderThickness="1"
                                        CornerRadius="6" Padding="6,1.5">
                                    <TextBlock Text="v3.0.9" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Loc.WeatherComparisonSubtitle, Mode=OneWay}"
                                       FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{x:Bind ViewModel.CloseWeatherComparisonCommand}"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="8" Width="32" Height="32" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- NỘI DUNG CUỘN CHÍNH -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="20,16">

                        <!-- KHỐI 1: CHỌN NHANH THÀNH PHỐ HOẶC TÌM KIẾM -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.Loc.CompareSelectPrompt, Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold" Opacity="0.85"/>

                                <!-- Danh sách cuộn ngang các thành phố gợi ý -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PresetCompareCities, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:QuickCompareCityItem">
                                                <Button Click="PresetCompareCity_Click"
                                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="10.5" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Ô Tìm Kiếm Thành Phố Bất Kỳ Trên Thế Giới -->
                                <AutoSuggestBox x:Name="ComparisonSearchBox"
                                                PlaceholderText="{x:Bind ViewModel.Loc.CompareSearchPlaceholder, Mode=OneWay}"
                                                QueryIcon="Find"
                                                TextChanged="ComparisonSearchBox_TextChanged"
                                                QuerySubmitted="ComparisonSearchBox_QuerySubmitted"
                                                SuggestionChosen="ComparisonSearchBox_SuggestionChosen"
                                                ItemsSource="{x:Bind ViewModel.ComparisonSearchResults, Mode=OneWay}"
                                                TextMemberPath="DisplayName"
                                                HorizontalAlignment="Stretch">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:GeocodingItem">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="11" Foreground="#38BDF8"/>
                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                            </StackPanel>
                        </Border>

                        <!-- THANH TIẾN ĐỘ KHI ĐANG TẢI DỮ LIỆU ĐỐI SÁNH -->
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{x:Bind ViewModel.IsComparisonLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Height="3" CornerRadius="1.5" Foreground="#38BDF8" Margin="0,-8,0,-8"/>

                        <!-- KHỐI 2: ĐỐI ĐẦU TRỰC TIẾP (ARENA VS) -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="16,14">
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                                <!-- Bên Trái: Thành phố hiện tại -->
                                <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Border Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1"
                                                CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Loc.CompareCurrentCity, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityA.LocationName, Mode=OneWay}"
                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                                      Glyph="{x:Bind ViewModel.ComparisonData.CityA.IconGlyph, Mode=OneWay}"
                                                      FontSize="24" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityA.TemperatureText, Mode=OneWay}"
                                                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityA.ConditionText, Mode=OneWay}"
                                                   FontSize="11.5" Opacity="0.85" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityA.HighLowTempText, Mode=OneWay}"
                                                   FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Trung Tâm: Huy hiệu VS & Tóm tắt chênh lệch -->
                                <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="#20EF4444" BorderBrush="#50EF4444" BorderThickness="1.5"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.Loc.CompareVersus, Mode=OneWay}"
                                                   FontSize="13" FontWeight="Black" Foreground="#EF4444"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1"
                                            CornerRadius="6" Padding="6,2" HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.ComparisonData.TempComparisonBadge, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.TempComparisonBadge, Mode=OneWay}"
                                                   FontSize="9.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Bên Phải: Thành phố đối sánh -->
                                <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <Border Background="#20F59E0B" BorderBrush="#40F59E0B" BorderThickness="1"
                                                CornerRadius="6" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.Loc.CompareTargetCity, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityB.LocationName, Mode=OneWay}"
                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                                      Glyph="{x:Bind ViewModel.ComparisonData.CityB.IconGlyph, Mode=OneWay}"
                                                      FontSize="24" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityB.TemperatureText, Mode=OneWay}"
                                                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityB.ConditionText, Mode=OneWay}"
                                                   FontSize="11.5" Opacity="0.85" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.CityB.HighLowTempText, Mode=OneWay}"
                                                   FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- KHỐI 3: PHÁN QUYẾT MỨC ĐỘ DỄ CHỊU (COMFORT VERDICT) -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf058;" FontSize="13" Foreground="#10B981"/>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.VerdictTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{x:Bind ViewModel.ComparisonData.VerdictBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.VerdictBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.ComparisonData.VerdictDescription, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Border>

                        <!-- KHỐI 4: BẢNG 6 CHỈ SỐ ĐỐI CHIẾU KHÍ TƯỢNG -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Loc.CompareMetricTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="12,8">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ComparisonData.MetricRows, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:MetricComparisonRow">
                                            <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                    CornerRadius="8" Padding="12,7">
                                                <Grid ColumnDefinitions="140,*,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <!-- Tên chỉ số kèm icon -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                                                  Glyph="{x:Bind IconGlyph}" FontSize="12"
                                                                  Foreground="{x:Bind IconColor, Converter={StaticResource HexToBrushConverter}}"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind MetricName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Giá trị Thành phố A -->
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind ValueA}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{x:Bind SubValueA}" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                    </StackPanel>

                                                    <!-- Huy hiệu so sánh chênh lệch -->
                                                    <Border Grid.Column="2"
                                                            Background="{x:Bind DifferenceBadgeColor, Converter={StaticResource HexToBrushConverter}}"
                                                            CornerRadius="6" Padding="8,2" MinWidth="68" HorizontalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DifferenceBadge}" FontSize="9.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Giá trị Thành phố B -->
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind ValueB}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{x:Bind SubValueB}" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                                                    </StackPanel>

                                                    <!-- Biểu tượng mũi tên lợi thế -->
                                                    <Border Grid.Column="4" Width="18" HorizontalAlignment="Center">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00c;" FontSize="9" Foreground="#10B981"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- KHỐI 5: CỐ VẤN HÀNH LÝ & DI CHUYỂN -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf5b0;" FontSize="13" Foreground="#F59E0B"/>
                                    <TextBlock Text="{x:Bind ViewModel.ComparisonData.TravelAdviceTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ComparisonData.TravelAdviceDescription, Mode=OneWay}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="10,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0eb;" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonData.PackingTips, Mode=OneWay}"
                                                   FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER: Nút Đặt làm Thành Phố Chính & Nút Đóng -->
                <Border Grid.Row="2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,20,20"
                        Padding="20,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0" Command="{x:Bind ViewModel.SwitchToComparedCityCommand}"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                CornerRadius="8" Padding="14,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="11"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.CompareSwitchLocation, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.CloseWeatherComparisonCommand}"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="16,6">
                            <TextBlock Text="{x:Bind ViewModel.Loc.CompareClose, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- =================================================================================== -->
    <!-- 6. MINI WEATHER BAR THU GỌN KHI CUỘN CHUỘT (SCROLL COMPACT HEADER PILL)             -->
    <!-- =================================================================================== -->
    <Border x:Name="MiniWeatherPill"
            Canvas.ZIndex="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Opacity="0"
            IsHitTestVisible="False"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="14,6"
            PointerPressed="MiniWeatherPill_PointerPressed"
            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ScrollToTopTooltip, Mode=OneWay}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="MiniPillTranslate" Y="-45"/>
        </Border.RenderTransform>
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
            <!-- Icon thời tiết mini -->
            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}"
                      Glyph="{x:Bind ViewModel.CurrentWeather.IconGlyph, Mode=OneWay}"
                      Foreground="#F59E0B" FontSize="14" VerticalAlignment="Center"/>
            
            <!-- Nhiệt độ hiện tại -->
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}"
                       FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>

            <!-- Vị trí & Tình trạng thời tiết -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                           MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Text="•" Opacity="0.5" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="12"
                           Opacity="0.85" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Nút Cuộn lên đỉnh -->
            <Border Grid.Column="3" Width="22" Height="22" CornerRadius="11"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf077;" FontSize="9.5"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Grid>
</UserControl>
