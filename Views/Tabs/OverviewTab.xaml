                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="12" Foreground="#FDE047"/>
                                                                <TextBlock Text="{x:Bind ViewModel.Loc.ParticleFxSunny, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
