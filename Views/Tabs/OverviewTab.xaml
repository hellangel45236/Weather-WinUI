<UserControl
    x:Class="WeatherApp.Views.Tabs.OverviewTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    xmlns:helpers="using:WeatherApp.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NothingCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NothingCardBorderBrush" Color="#E2E2E6" />
                    <SolidColorBrush x:Key="NothingSubCardBackgroundBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="NothingSubCardBorderBrush" Color="#E5E5E8" />
                    <SolidColorBrush x:Key="NothingGlyphBoxBackgroundBrush" Color="#F9F9FA" />
                    <SolidColorBrush x:Key="NothingTextPrimaryBrush" Color="#0A0A0C" />
                    <SolidColorBrush x:Key="NothingTextSecondaryBrush" Color="#71717A" />
                    <SolidColorBrush x:Key="NothingTextMutedBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="NothingRedBrush" Color="#D71921" />
                    <SolidColorBrush x:Key="NothingGreenBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="NothingPillBackgroundBrush" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="NothingPillBorderBrush" Color="#DDDDDD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="NothingCardBackgroundBrush" Color="#121214" />
                    <SolidColorBrush x:Key="NothingCardBorderBrush" Color="#242428" />
                    <SolidColorBrush x:Key="NothingSubCardBackgroundBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="NothingSubCardBorderBrush" Color="#26262B" />
                    <SolidColorBrush x:Key="NothingGlyphBoxBackgroundBrush" Color="#0A0A0C" />
                    <SolidColorBrush x:Key="NothingTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NothingTextSecondaryBrush" Color="#737373" />
                    <SolidColorBrush x:Key="NothingTextMutedBrush" Color="#52525B" />
                    <SolidColorBrush x:Key="NothingRedBrush" Color="#D71921" />
                    <SolidColorBrush x:Key="NothingGreenBrush" Color="#00FF66" />
                    <SolidColorBrush x:Key="NothingPillBackgroundBrush" Color="#1F1F23" />
                    <SolidColorBrush x:Key="NothingPillBorderBrush" Color="#333333" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NothingCardBackgroundBrush" Color="#121214" />
                    <SolidColorBrush x:Key="NothingCardBorderBrush" Color="#242428" />
                    <SolidColorBrush x:Key="NothingSubCardBackgroundBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="NothingSubCardBorderBrush" Color="#26262B" />
                    <SolidColorBrush x:Key="NothingGlyphBoxBackgroundBrush" Color="#0A0A0C" />
                    <SolidColorBrush x:Key="NothingTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NothingTextSecondaryBrush" Color="#737373" />
                    <SolidColorBrush x:Key="NothingTextMutedBrush" Color="#52525B" />
                    <SolidColorBrush x:Key="NothingRedBrush" Color="#D71921" />
                    <SolidColorBrush x:Key="NothingGreenBrush" Color="#00FF66" />
                    <SolidColorBrush x:Key="NothingPillBackgroundBrush" Color="#1F1F23" />
                    <SolidColorBrush x:Key="NothingPillBorderBrush" Color="#333333" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="OverviewScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,16,24">
            <!-- =================================================================================== -->
            <!-- FLUENT 2 OVERVIEW CONTAINER (Active in Default/Fluent 2 Mode)                       -->
            <!-- =================================================================================== -->
            <StackPanel x:Name="Fluent2OverviewContainer"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsFluent2Design, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- =================================================================================== -->
            <!-- 1. THẺ HERO BENTO: 2 CỘT BẤT ĐỐI XỨNG HIỆN ĐẠI (ASYMMETRIC BENTO HERO)               -->
            <!-- =================================================================================== -->
            <Grid Margin="0,0,0,16">
                <!-- LỚP HÀO QUANG ÁNH SÁNG MÔI TRƯỜNG THÍCH ỨNG (ADAPTIVE AMBIENT BACKLIGHT GLOW v3.1.0) -->
                <Border x:Name="HeroAmbientGlow"
                        CornerRadius="20"
                        Margin="0"
                        Opacity="0.45"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1.018" ScaleY="1.035"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush x:Name="HeroAmbientBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="HeroAmbientStop0" Color="#1E3A8A" Offset="0"/>
                            <GradientStop x:Name="HeroAmbientStop1" Color="#0EA5E9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="HeroCardBorder" CornerRadius="16" Padding="0" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#1E293B">
                    <Grid CornerRadius="16">
                    <!-- Ảnh nền thành phố theo thời gian thực -->
                    <Border x:Name="CityHeroBackgroundBorder" CornerRadius="16">
                        <Border.Background>
                            <ImageBrush x:Name="CityHeroImageBrush" Stretch="UniformToFill" Opacity="0.45"/>
                        </Border.Background>
                    </Border>

                    <!-- Lớp phủ Gradient theo hiệu ứng thời tiết và Mùa/Lễ hội -->
                    <Border x:Name="HeroGradientOverlay" CornerRadius="16" Opacity="0.75">
                        <Border.Background>
                            <LinearGradientBrush x:Name="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="HeroGradStop0" Color="#0284C7" Offset="0"/>
                                <GradientStop x:Name="HeroGradStop1" Color="#0F172A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Canvas hiệu ứng động (Mưa, tuyết, sao, nắng) -->
                    <Canvas x:Name="WeatherEffectsCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <!-- Chớp sấm sét khi có dông bão -->
                    <Border x:Name="LightningFlashOverlay" Background="#99EEF2FF" Opacity="0" CornerRadius="16" IsHitTestVisible="False"/>

                    <!-- Nội dung chính của Thẻ Hero -->
                    <StackPanel Spacing="12" Padding="20,16">

                        <!-- HÀNG 1: VỊ TRÍ, TIỆN ÍCH & NÚT GÓP Ý THỜI TIẾT FLYOUT -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                            <!-- Bên trái: Vị trí & Nút yêu thích -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" Foreground="#38BDF8" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.LocationTitle, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                                <Button Command="{x:Bind ViewModel.ToggleFavoriteCurrentLocationCommand}"
                                        Background="#26FFFFFF"
                                        BorderThickness="0"
                                        CornerRadius="12"
                                        Padding="8,4"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteButtonToolTip, Mode=OneWay}"
                                        VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.FavoriteIconGlyph, Mode=OneWay}" Foreground="#F43F5E" FontSize="13"/>
                                </Button>
                            </StackPanel>

                            <!-- Bên phải: Các nút tiện ích (Góp ý, Làm mới, Chia sẻ, Âm thanh) -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Nút Góp ý độ chính xác thời tiết (Flyout dạng Pill Button) -->
                                <Button x:Name="WeatherFeedbackButton"
                                        Background="#25FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="11,5"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.FeedbackPillTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf059;" FontSize="11" Foreground="#FBBF24"/>
                                        <TextBlock Text="{x:Bind ViewModel.FeedbackButtonLabel, Mode=OneWay}" FontSize="11.5" Foreground="White" Opacity="0.95"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <Border Width="330" Padding="4">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf059;" FontSize="13" Foreground="#38BDF8"/>
                                                            <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackTitle, Mode=OneWay}" FontSize="12.5" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Chưa gửi phản hồi -->
                                                    <Grid Visibility="{x:Bind ViewModel.FeedbackSubmitted, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                                <Button Grid.Column="0" Command="{x:Bind ViewModel.SubmitFeedbackCommand}" CommandParameter="accurate"
                                                                        HorizontalAlignment="Stretch" Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf164;" FontSize="11" Foreground="#10B981"/>
                                                                        <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackAccurate, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Column="1" Command="{x:Bind ViewModel.SubmitFeedbackCommand}" CommandParameter="inaccurate"
                                                                        HorizontalAlignment="Stretch" Background="#20F43F5E" BorderBrush="#40F43F5E" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf165;" FontSize="11" Foreground="#F43F5E"/>
                                                                        <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackInaccurate, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F43F5E"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>

                                                            <!-- Khi chọn Chưa đúng: Hiện 11 trạng thái thực tế -->
                                                            <StackPanel Visibility="{x:Bind ViewModel.ShowInaccurateOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="6">
                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackWhatIsActual, Mode=OneWay}" FontSize="11" Opacity="0.75" FontWeight="SemiBold"/>
                                                                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                                                    <StackPanel Spacing="4">
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Trời nắng đẹp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11" Foreground="#FDE047"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionSunny, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Nắng gắt chói chang UV" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" FontSize="11" Foreground="#FB923C"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionHighUv, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Nắng nhẹ ít mây" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" FontSize="11" Foreground="#38BDF8"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionMildSun, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Nhiều mây u ám" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c2;" FontSize="11" Foreground="#CBD5E1"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionCloudy, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Mưa phùn nhỏ" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#7DD3FC"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionDrizzle, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Đang có mưa vừa" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#60A5FA"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionRaining, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Mưa rất to xối xả" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#3B82F6"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionHeavyRain, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Dông sét sấm bão" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf76c;" FontSize="11" Foreground="#F87171"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionThunder, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Sương mù dày" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf75f;" FontSize="11" Foreground="#E2E8F0"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionFog, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Gió to lốc mạnh" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="11" Foreground="#FB7185"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionWindy, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{x:Bind ViewModel.SubmitActualConditionCommand}" CommandParameter="Rét buốt lạnh giá" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" CornerRadius="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2dc;" FontSize="11" Foreground="#93C5FD"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackOptionCold, Mode=OneWay}" FontSize="11.5"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Đã gửi phản hồi -->
                                                    <Grid Visibility="{x:Bind ViewModel.FeedbackSubmitted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="{x:Bind ViewModel.FeedbackResponseText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <Button Command="{x:Bind ViewModel.ResetFeedbackCommand}" HorizontalAlignment="Left" CornerRadius="6" Padding="8,3" FontSize="11">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="9"/>
                                                                    <TextBlock Text="{x:Bind ViewModel.Loc.FeedbackChangeAgain, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Nút Làm mới -->
                                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                                        Background="#25FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="11,5"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.RefreshTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2f1;" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.UpdatedTimeText, Mode=OneWay}" FontSize="11.5" Foreground="White" Opacity="0.9"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nút So Sánh Thời Tiết Đối Đầu (Weather Duel v3.0.9) -->
                                <Button Command="{x:Bind ViewModel.OpenWeatherComparisonCommand}"
                                        Background="#2538BDF8"
                                        BorderBrush="#6038BDF8"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="11,5"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.WeatherComparisonTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf362;" FontSize="11" Foreground="#38BDF8"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.WeatherComparisonButton, Mode=OneWay}" FontSize="11.5" Foreground="White" Opacity="0.95"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nút Chế Độ Thư Giãn Toàn Cảnh (Zen Immersive View F11) -->
                                <Button Command="{x:Bind ViewModel.ToggleZenModeCommand}"
                                        Background="#308B5CF6"
                                        BorderBrush="#65C084FC"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="11,5"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ZenHeroButtonTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" FontSize="11" Foreground="#DDD6FE"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.ZenHeroButtonText, Mode=OneWay}" FontSize="11.5" Foreground="#DDD6FE" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nút Chia sẻ ảnh -->
                                <Button Click="ShareWeatherCardButton_Click"
                                        Background="#25FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="11,5"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Loc.ShareTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf030;" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.ShareWeather, Mode=OneWay}" FontSize="11.5" Foreground="White" Opacity="0.9"/>
                                    </StackPanel>
                                </Button>

                                <!-- Nút Âm thanh thiên nhiên -->
                                <Button x:Name="AmbientSoundButton"
                                        Background="#25FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="11,5"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.AmbientSoundButtonToolTip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.AmbientSoundIconGlyph, Mode=OneWay}" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="{x:Bind ViewModel.AmbientSoundButtonText, Mode=OneWay}" FontSize="11.5" Foreground="White" Opacity="0.9"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight" Opened="Flyout_Opened">
                                            <Border Width="310" Padding="2">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf025;" FontSize="14" Foreground="#38BDF8"/>
                                                            <TextBlock Text="{x:Bind ViewModel.Loc.AmbientFlyoutTitle, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
                                                        </StackPanel>
                                                        <ToggleSwitch Grid.Column="2" x:Name="FlyoutAmbientToggle" IsOn="{x:Bind ViewModel.IsAmbientSoundPlaying, Mode=OneWay}" Toggled="FlyoutAmbientToggle_Toggled" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf027;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        <Slider Grid.Column="1" x:Name="FlyoutVolumeSlider" Minimum="0" Maximum="100" StepFrequency="5" Value="50" ValueChanged="FlyoutVolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" x:Name="FlyoutVolumeText" Text="50%" FontSize="11" Width="34" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4"/>

                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.Loc.AmbientChooseSpace, Mode=OneWay}" FontSize="11" Opacity="0.7" FontWeight="SemiBold"/>
                                                        <Button x:Name="BtnSoundAuto" Tag="Auto" Click="SoundPresetButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0ac;" FontSize="12" Foreground="#38BDF8"/>
                                                                <StackPanel Spacing="1">
                                                                    <TextBlock Text="{x:Bind ViewModel.Loc.SoundAutoTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{x:Bind ViewModel.Loc.SoundAutoDesc, Mode=OneWay}" FontSize="10" Opacity="0.7"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="BtnSoundRain" Tag="Rain" Click="SoundPresetButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" CornerRadius="8">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="12" Foreground="#38BDF8"/>
                                                                <StackPanel Spacing="1">
