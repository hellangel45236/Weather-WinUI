<UserControl
    x:Class="WeatherApp.Views.Tabs.UrbanFloodTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,16,24">
            <!-- THẺ ĐỒ THỊ SÓNG BÁN NHẬT TRIỀU 24 GIỜ (V3.0 BETA) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasTideData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#200284C7">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" Foreground="#0284C7" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Đồ Thị Sóng Bán Nhật Triều 24 Giờ (Sông Sài Gòn &amp; Nhà Bè)" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Mô phỏng mực nước thực tế theo chu kỳ thiên văn 2 đỉnh 2 đáy trong ngày" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#200284C7" BorderBrush="#400284C7" BorderThickness="1" CornerRadius="8" Padding="10,4">
                            <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.NextPeakCountdown, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                    </Grid>

                    <Border Height="190" Background="#0C000000" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Canvas x:Name="TidalSineWaveCanvas" Height="190" HorizontalAlignment="Stretch" SizeChanged="TidalSineWaveCanvas_SizeChanged"/>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="&lt;1.40m: An toàn" FontSize="11" Opacity="0.75"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center"/>
                            <TextBlock Text="1.40m: BĐ I" FontSize="11" Opacity="0.75"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#EA580C" VerticalAlignment="Center"/>
                            <TextBlock Text="1.55m: BĐ II" FontSize="11" Opacity="0.75"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"/>
                            <TextBlock Text="≥1.60m: BĐ III (Ngập)" FontSize="11" Opacity="0.75"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- TÌM KIẾM TUYẾN ĐƯỜNG NGẬP NHANH (V3.0 BETA) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Tra Cứu Tuyến Đường Ngập Úng &amp; Thoát Nước" FontSize="14" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="FloodSearchTextBox"
                                 PlaceholderText="Gõ tên đường (Huỳnh Tấn Phát, Nguyễn Hữu Cảnh, Thái Hà...)"
                                 TextChanged="FloodSearchTextBox_TextChanged"
                                 CornerRadius="10"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.AvailableFloodDistricts, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFloodDistrict, Mode=TwoWay}"
                                  SelectionChanged="FloodDistrictComboBox_SelectionChanged"
                                  CornerRadius="10"
                                  Width="160"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CẢNH BÁO NGẬP ÚNG & TRIỀU CƯỜNG ĐÔ THỊ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <StackPanel Spacing="14">
                    <!-- Tiêu đề, Thành phố & Huy hiệu Cảnh báo mức độ rủi ro -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeBg, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                          Glyph="{x:Bind ViewModel.UrbanFloodWarning.RiskIconGlyph, Mode=OneWay}"
                                          FontSize="16"
                                          Foreground="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Cảnh Báo Ngập Úng &amp; Triều Cường" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#1A0284C7" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="v2.2.3" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf3c5;" FontSize="9.5" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.CityDisplayName, Mode=OneWay}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    <TextBlock Text="• Giám sát hạ tầng &amp; lưu thông" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Huy hiệu Trạng thái Rủi ro -->
                        <Border Grid.Column="1"
                                Background="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeBg, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                BorderBrush="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}"
                                          Glyph="{x:Bind ViewModel.UrbanFloodWarning.RiskIconGlyph, Mode=OneWay}"
                                          FontSize="11"
                                          Foreground="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.RiskTitle, Mode=OneWay}"
                                           FontSize="11.5" FontWeight="Bold"
                                           Foreground="{x:Bind ViewModel.UrbanFloodWarning.RiskBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Khung thông điệp tổng quan & Headline -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.Headline, Mode=OneWay}"
                                       FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.Summary, Mode=OneWay}"
                                       FontSize="11.5" Opacity="0.85" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- Lưới 2 thẻ chi tiết: Triều Cường & Thoát Nước Mưa -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Thẻ 1: Triều Cường (Hiện khi HasTideData == True) -->
                        <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10"
                                Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasTideData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf773;" FontSize="11" Foreground="#0284C7"/>
                                        <TextBlock Text="Triều Cường Sông Sài Gòn" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{x:Bind ViewModel.UrbanFloodWarning.TideAlertColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TideAlertBadge, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.UrbanFloodWarning.CurrentTideLevelDisplay, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UrbanFloodWarning.TideStatusText, Mode=OneWay}"
                                               FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Đỉnh Triều Sáng" FontSize="9.5" Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TidePeakMorning, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Đỉnh Triều Chiều" FontSize="9.5" Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TidePeakEvening, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.TidePhaseText, Mode=OneWay}"
                                           FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ 1 thay thế cho Hà Nội & các thành phố không có triều: Lưu Vực Sông & Cống Thoát Nước -->
                        <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10"
                                Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasTideData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf043;" FontSize="11" Foreground="#0284C7"/>
                                    <TextBlock Text="Hạ Tầng Lưu Vực Sông" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                                </StackPanel>

                                <TextBlock Text="Lưu vực sông Tô Lịch, Nhuệ, Kim Ngưu" FontSize="13.5" FontWeight="Bold"/>
                                <TextBlock Text="Đoạn kênh cống tiêu thoát chính cho nội đô" FontSize="11" Opacity="0.7"/>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4"/>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Trạm bơm Yên Sở &amp; Cửa điều tiết:" FontSize="9.5" Opacity="0.6"/>
                                    <TextBlock Text="Sẵn sàng bơm cưỡng bức khi mưa lớn" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Thẻ 2: Cường Độ Mưa & Tình Trạng Thoát Nước -->
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock Text="Cường Độ Mưa &amp; Thoát Nước" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.UrbanFloodWarning.RainIntensityDisplay, Mode=OneWay}"
                                               FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UrbanFloodWarning.RainDrainageStatus, Mode=OneWay}"
                                               FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.4"/>

                                <TextBlock Text="Đánh giá năng lực hệ thống:" FontSize="9.5" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.RainDrainageStatus, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Khuyến nghị phương tiện di chuyển (Xe máy & Ô tô) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Xe máy -->
                        <Border Grid.Column="0" Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="10" Padding="11,8">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf21c;" FontSize="11" Foreground="#F59E0B"/>
                                    <TextBlock Text="Lưu ý Xe Máy" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.MotorbikeAdvice, Mode=OneWay}"
                                           FontSize="11" Opacity="0.9" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Ô tô -->
                        <Border Grid.Column="1" Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="10" Padding="11,8">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1b9;" FontSize="11" Foreground="#60A5FA"/>
                                    <TextBlock Text="Lưu ý Xe Ô Tô" FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.CarAdvice, Mode=OneWay}"
                                           FontSize="11" Opacity="0.9" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Danh sách các tuyến đường ngập trọng điểm -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.UrbanFloodWarning.HasHotspotRoads, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf018;" FontSize="11" Foreground="#EC4899"/>
                                <TextBlock Text="Tuyến Đường Trọng Điểm Cần Lưu Ý" FontSize="12" FontWeight="Bold" Opacity="0.85"/>
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{x:Bind ViewModel.UrbanFloodWarning.HotspotRoadsCount, Mode=OneWay}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- Bộ lọc theo Quận/Huyện -->
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.AvailableFloodDistricts, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedFloodDistrict, Mode=TwoWay}"
                                      SelectionChanged="FloodDistrictComboBox_SelectionChanged"
                                      Width="140" FontSize="11" Padding="8,3"/>
                        </Grid>

                        <!-- Danh sách tuyến đường -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayedFloodRoads, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:FloodHotspotRoad">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{x:Bind SeverityColor, Converter={StaticResource HexToBrushConverter}}"
                                            BorderThickness="1,0,0,0"
                                            CornerRadius="8"
                                            Padding="12,7"
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind StreetName}" FontSize="12" FontWeight="SemiBold"/>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="{x:Bind District}" FontSize="10" Opacity="0.75"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Note}" FontSize="10.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                <Border Background="{x:Bind SeverityBg, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{x:Bind EstimatedDepth}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{x:Bind SeverityColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind Cause}" FontSize="9.5" Opacity="0.6" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Nút Thu gọn / Xem tất cả -->
                        <Button Command="{x:Bind ViewModel.ToggleFloodRoadsExpandedCommand}"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,4"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.FloodRoadsExpandButtonText, Mode=OneWay}"/>
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind ViewModel.FloodRoadsExpandIconGlyph, Mode=OneWay}" FontSize="9.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
