<UserControl
    x:Class="WeatherApp.Views.Tabs.LifestyleTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    xmlns:helpers="using:WeatherApp.Helpers"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,16,84">

            <!-- Thông báo sao chép OOTD vào clipboard -->
            <InfoBar IsOpen="{x:Bind ViewModel.IsOotdCopiedOpen, Mode=TwoWay}"
                     Severity="Success"
                     Message="{x:Bind ViewModel.OotdCopiedMessage, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ==================== PHẦN 1: HERO EDITORIAL OOTD CAPSULE (MAGAZINE GRADE) ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20">
                <StackPanel Spacing="16">
                    
                    <!-- 1.1 Header Bar: Title, Occasion & Copy Button -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="12" Background="#20EC4899">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="16" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdHeaderTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="#1A10B981" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdBadge, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                    <Border Visibility="{x:Bind ViewModel.IsNothingDesign, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource NothingPillBackgroundBrush}" BorderBrush="{ThemeResource NothingPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="OOTD // CAPSULE" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource NothingRedBrush}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Loc.OotdHeaderSub, Mode=OneWay}" FontSize="11.5" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Nút sao chép gợi ý OOTD -->
                        <Button Grid.Column="1" x:Name="CopyOotdButton" Click="CopyOotdButton_Click"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c5;" FontSize="11.5" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.OotdCopyBtn, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 1.2 Unified Filter Capsule (Occasions + Gender in Single Sleek Bar) -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="8,6">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <!-- Hàng nút chọn Dịp (Occasions) -->
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button x:Name="OccasionWorkButton" Click="OccasionButton_Click" Tag="Work"
                                            CornerRadius="10" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0b1;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionWork, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionSchoolButton" Click="OccasionButton_Click" Tag="School"
                                            CornerRadius="10" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf19d;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionSchool, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionCasualButton" Click="OccasionButton_Click" Tag="Casual"
                                            CornerRadius="10" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf70c;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionCasual, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionSportButton" Click="OccasionButton_Click" Tag="Sport"
                                            CornerRadius="10" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf44b;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionSport, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionTravelButton" Click="OccasionButton_Click" Tag="Travel"
                                            CornerRadius="10" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionTravel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Đường phân cách dọc -->
                            <Border Grid.Column="1" Width="1" Height="20" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="8,0" Opacity="0.4"/>

                            <!-- Hàng nút chọn Giới tính (Gender) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Button x:Name="GenderAllButton" Click="GenderButton_Click" Tag="All"
                                        CornerRadius="10" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf183;" FontSize="10"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdGenderAll, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="GenderMenButton" Click="GenderButton_Click" Tag="Men"
                                        CornerRadius="10" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf007;" FontSize="10"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdGenderMen, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="GenderWomenButton" Click="GenderButton_Click" Tag="Women"
                                        CornerRadius="10" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf182;" FontSize="10"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdGenderWomen, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 1.3 Hero Look Feature Card (Editorial Typography & Tone) -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="18,16">
                        <StackPanel Spacing="10">
                            <!-- Headline & Style Badges -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.CurrentOutfitAdvice.ThermalTagColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Headline, Mode=OneWay}"
                                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.ThermalComfortNotice, Mode=OneWay}"
                                               FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="16,0,0,0"/>
                                </StackPanel>

                                <!-- Style Tag Badge -->
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="10.5" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.FashionStyleTag, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Commuter Weather Context Strip (Motorbike & Raincoat Inline Pills) -->
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.3" Margin="0,4"/>
                            <Grid x:Name="MotorbikeRainGrid" ColumnDefinitions="*,*" ColumnSpacing="10">
                                <!-- Xe máy -->
                                <Border Grid.Column="0" Background="#14F59E0B" BorderBrush="#35F59E0B" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}"
                                                  Glyph="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarningIcon, Mode=OneWay}"
                                                  FontSize="12" Foreground="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarningColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarning, Mode=OneWay}"
                                                   FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" Opacity="0.9"/>
                                    </Grid>
                                </Border>

                                <!-- Áo mưa -->
                                <Border Grid.Column="1" Background="#1438BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;"
                                                  FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentOutfitAdvice.RaincoatAdvice, Mode=OneWay}"
                                                   FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" Opacity="0.9"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 1.4 Wardrobe Breakdown (4 Clean Editorial Bento Cards) -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Card 1: Áo & Thân trên -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="11.5" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdTopClothing, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.TopClothing, Mode=OneWay}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Quần & Thân dưới -->
                        <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf005;" FontSize="11.5" Foreground="#818CF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdBottomClothing, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.BottomClothing, Mode=OneWay}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Áo khoác & Che chắn -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="11.5" Foreground="#F59E0B"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdOuterwear, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Outerwear, Mode=OneWay}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Giày dép & Bước đi -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="14,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf549;" FontSize="11.5" Foreground="#34D399"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdFootwear, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Footwear, Mode=OneWay}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 1.5 Color Palette & Fabric Advice (Clean Single Row) -->
                    <Grid x:Name="PaletteFabricGrid" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Bảng màu đề xuất (Color Swatches) -->
                        <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="12,10">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf53f;" FontSize="11" Foreground="#EC4899"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdColorPalette, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.7"/>
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentOutfitAdvice.SuggestedColors, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:OutfitColorItem">
                                                <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="8" Padding="7,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <Border Width="12" Height="12" CornerRadius="6"
                                                                Background="{x:Bind HexColor, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Chất liệu vải khuyên dùng (Fabric Advice) -->
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="12,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf02c;" FontSize="11" Foreground="#06B6D4"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdFabricAdvice, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.FabricRecommendation, Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 1.6 Phụ kiện & Vật dụng cần mang (Essential Accessories Chips) -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf468;" FontSize="11" Foreground="#60A5FA"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.OotdAccessories, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Opacity="0.75"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentOutfitAdvice.Accessories, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:OutfitAccessoryItem">
                                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="10" Padding="8,6" Margin="0,0,6,6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalAlignment="Center">
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
                                                        Background="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                        Opacity="0.25" VerticalAlignment="Center">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="10.5"
                                                              Foreground="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Reason}" FontSize="9.5" Opacity="0.7" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ==================== PHẦN 2: KHUNG GIỜ VẬN ĐỘNG & THỂ THAO NGOÀI TRỜI (WORKOUT TIMELINE) ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2010B981">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf44b;" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WorkoutWindowsHeader, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.WorkoutWindowsSub, Mode=OneWay}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Danh sách khung giờ vận động (4 Slots Sleek Grid) -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WorkoutWindows, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkoutWindowItem">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,8,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                Background="{x:Bind StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                Opacity="0.9" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                      FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind TimeRange}" FontSize="11.5" FontWeight="Bold"/>
                                                <TextBlock Text="•" Opacity="0.4" FontSize="10"/>
                                                <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold" Opacity="0.85"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Advice}" FontSize="10.5" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Temperature}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <Border Background="{x:Bind StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind Status}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== PHẦN 3: CHỈ SỐ SINH HOẠT & TIỆN ÍCH ĐỜI SỐNG (LIFESTYLE INDICES) ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#208B5CF6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1ae;" FontSize="14" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.Loc.LifestyleHeader, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.LifestyleSub, Mode=OneWay}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Ma trận các chỉ số sinh hoạt gọn gàng (4 Cột hoặc 2 Cột linh hoạt) -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LifestyleIndices, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LifestyleIndexItem">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Margin="0,0,8,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{x:Bind RatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                Opacity="0.9" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                      FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Advice}" FontSize="10.5" Opacity="0.75" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                            <Border Background="{x:Bind RatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind Rating}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind StarsDisplay}" FontSize="9.5" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
