<UserControl
    x:Class="WeatherApp.Views.Tabs.LifestyleTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    xmlns:helpers="using:WeatherApp.Helpers"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,16,84">

            <!-- Thông báo sao chép OOTD vào clipboard -->
            <InfoBar IsOpen="{x:Bind ViewModel.IsOotdCopiedOpen, Mode=TwoWay}"
                     Severity="Success"
                     Message="{x:Bind ViewModel.OotdCopiedMessage, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ==================== KHỐI 1: HEADER & BỘ LỌC TỐI GIẢN (MINIMAL FILTER STRIP) ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18,14">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    
                    <!-- Hàng 1: Tiêu đề trang nhã + Nút Sao chép -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border x:Name="OotdHeaderIconBorder" Width="34" Height="34" CornerRadius="10" Background="#20EC4899">
                                <FontIcon x:Name="OotdHeaderIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="15" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdHeaderTitle, Mode=OneWay}" FontSize="15.5" FontWeight="Bold"/>
                                    <Border Background="#1A10B981" CornerRadius="6" Padding="6,1.5">
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdBadge, Mode=OneWay}" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                    <Border Visibility="{x:Bind ViewModel.IsNothingDesign, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource NothingPillBackgroundBrush}" BorderBrush="{ThemeResource NothingPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5,1">
                                        <TextBlock Text="MINIMAL" FontSize="8.5" FontWeight="Bold" Foreground="{ThemeResource NothingRedBrush}" FontFamily="Cascadia Mono, Consolas, Segoe UI"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Loc.OotdHeaderSub, Mode=OneWay}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Nút sao chép gợi ý OOTD -->
                        <Button Grid.Column="1" x:Name="CopyOotdButton" Click="CopyOotdButton_Click"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c5;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.OotdCopyBtn, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Hàng 2: Bộ lọc phân loại Dịp & Giới tính (Chuẩn tương phản cao mọi chế độ) -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="6,4">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <!-- Danh sách Dịp (Occasions) -->
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button x:Name="OccasionWorkButton" Click="OccasionButton_Click" Tag="Work"
                                            CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0b1;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionWork, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionSchoolButton" Click="OccasionButton_Click" Tag="School"
                                            CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf19d;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionSchool, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionCasualButton" Click="OccasionButton_Click" Tag="Casual"
                                            CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf70c;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionCasual, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionSportButton" Click="OccasionButton_Click" Tag="Sport"
                                            CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf44b;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionSport, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OccasionTravelButton" Click="OccasionButton_Click" Tag="Travel"
                                            CornerRadius="8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf57d;" FontSize="10.5"/>
                                            <TextBlock Text="{x:Bind ViewModel.Loc.OotdOccasionTravel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Vạch phân cách -->
                            <Border Grid.Column="1" Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" Opacity="0.3"/>

                            <!-- Danh sách Giới tính -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Button x:Name="GenderAllButton" Click="GenderButton_Click" Tag="All"
                                        CornerRadius="8" Padding="9,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf183;" FontSize="10"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdGenderAll, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="GenderMenButton" Click="GenderButton_Click" Tag="Men"
                                        CornerRadius="8" Padding="9,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf007;" FontSize="10"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdGenderMen, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="GenderWomenButton" Click="GenderButton_Click" Tag="Women"
                                        CornerRadius="8" Padding="9,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf182;" FontSize="10"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.OotdGenderWomen, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== KHỐI 2: THẺ HERO LOOKBOOK TRỌNG TÂM (SINGLE CANVAS LOOKBOOK) ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22">
                <StackPanel Spacing="16">

                    <!-- 2.1 Headline chính lớn, đắt giá, dễ đọc trong 1 giây -->
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.CurrentOutfitAdvice.ThermalTagColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Headline, Mode=OneWay}"
                                           FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.ThermalComfortNotice, Mode=OneWay}"
                                       FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="16,0,0,0"/>
                        </StackPanel>

                        <!-- Style Tag Badge -->
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock x:Name="FashionStyleTagText" Text="{x:Bind ViewModel.CurrentOutfitAdvice.FashionStyleTag, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 2.2 Hai dòng lưu ý thiết yếu (Xe máy & Thời tiết bảo vệ) dạng Strip tinh tế, KHÔNG viền lòe loẹt -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                            <!-- Dòng 1: Xe máy -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="MotorbikeWarningIcon" Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}"
                                          Glyph="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarningIcon, Mode=OneWay}"
                                          FontSize="12.5" Foreground="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarningColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentOutfitAdvice.MotorbikeWarning, Mode=OneWay}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Opacity="0.88"/>
                            </Grid>

                            <!-- Dòng 2: Áo mưa / Áo nắng -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="RaincoatIcon" Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf73d;"
                                          FontSize="12.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentOutfitAdvice.RaincoatAdvice, Mode=OneWay}"
                                           FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Opacity="0.88"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2.3 Bộ Tủ Đồ 4 Món Cốt Lõi (The 4-Piece Capsule - Bento Grid Thoáng Đãng) -->
                    <Grid x:Name="CapsuleBentoGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <!-- Ô 1: Áo & Thân Trên -->
                        <Border x:Name="TopClothingCard" Grid.Row="0" Grid.Column="0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon x:Name="TopClothingIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf553;" FontSize="11.5" Foreground="#38BDF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdTopClothing, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.TopClothing, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <!-- Ô 2: Quần & Thân Dưới -->
                        <Border x:Name="BottomClothingCard" Grid.Row="0" Grid.Column="1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon x:Name="BottomClothingIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf005;" FontSize="11.5" Foreground="#818CF8"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdBottomClothing, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.BottomClothing, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <!-- Ô 3: Áo Khoác & Che Chắn -->
                        <Border x:Name="OuterwearCard" Grid.Row="1" Grid.Column="0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon x:Name="OuterwearIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf72e;" FontSize="11.5" Foreground="#F59E0B"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdOuterwear, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Outerwear, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <!-- Ô 4: Giày Dép & Bước Đi -->
                        <Border x:Name="FootwearCard" Grid.Row="1" Grid.Column="1"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon x:Name="FootwearIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf549;" FontSize="11.5" Foreground="#10B981"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdFootwear, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.Footwear, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2.4 Dải Chi Tiết Bổ Trợ: Bảng màu & Chất liệu vải (Gọn gàng trong 1 hàng) -->
                    <Grid x:Name="PaletteFabricGrid" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Bảng màu đề xuất -->
                        <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="PaletteIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf53f;" FontSize="10.5" Foreground="#EC4899"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdColorPalette, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentOutfitAdvice.SuggestedColors, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:OutfitColorItem">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Border Width="11" Height="11" CornerRadius="6"
                                                            Background="{x:Bind HexColor, Converter={StaticResource HexToBrushConverter}}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Chất liệu vải khuyên dùng -->
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="FabricIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf02c;" FontSize="10.5" Foreground="#06B6D4"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.OotdFabricAdvice, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentOutfitAdvice.FabricRecommendation, Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2.5 Danh Sách Vật Dụng Nên Mang Theo (Pills Gọn Gàng, Không Rối Rắm) -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="AccessoriesIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf468;" FontSize="11" Foreground="#60A5FA"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.OotdAccessories, Mode=OneWay}" FontSize="11" FontWeight="Bold" Opacity="0.65"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentOutfitAdvice.Accessories, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:OutfitAccessoryItem">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8" Padding="8,6" Margin="0,0,6,6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}" FontSize="11"
                                                          Foreground="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ==================== KHỐI 3: KHUNG GIỜ VẬN ĐỘNG & CHỈ SỐ SINH HOẠT ==================== -->
            <Grid x:Name="BottomIndicesGrid" ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Khung giờ vận động -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon x:Name="WorkoutWindowsIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf44b;" FontSize="13" Foreground="#10B981"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.WorkoutWindowsHeader, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.WorkoutWindows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkoutWindowItem">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                      FontSize="12" Foreground="{x:Bind StatusColor, Converter={StaticResource HexToBrushConverter}}"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{x:Bind TimeRange}" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{x:Bind Label}" FontSize="10.5" Opacity="0.75"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Advice}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{x:Bind StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="5" Padding="5,1.5">
                                                <TextBlock Text="{x:Bind Status}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Chỉ số sinh hoạt -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon x:Name="LifestyleIndicesIcon" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf1ae;" FontSize="13" Foreground="#8B5CF6"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.LifestyleHeader, Mode=OneWay}" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.LifestyleIndices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LifestyleIndexItem">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                            <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="{x:Bind IconGlyph}"
                                                      FontSize="12" Foreground="{x:Bind RatingColor, Converter={StaticResource HexToBrushConverter}}"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{x:Bind Advice}" FontSize="10" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{x:Bind RatingColor, Converter={StaticResource HexToBrushConverter}}"
                                                    CornerRadius="5" Padding="5,1.5">
                                                <TextBlock Text="{x:Bind Rating}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
