                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#22C55E"/>
                                        <TextBlock Text="📌 Ghim Widget Giáng Sinh Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 4. WIDGET HALLOWEEN (MIDNIGHT PHANTOM) -->
                        <Border x:Name="CardSeasonalHalloween" Grid.Row="1" Grid.Column="1"
                                Tag="Halloween" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#50F97316" BorderThickness="1.5" CornerRadius="16" Padding="14">
