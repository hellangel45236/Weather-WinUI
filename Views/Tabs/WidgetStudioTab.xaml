                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="Halloween" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#20F97316" BorderBrush="#50F97316" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#F97316"/>
                                        <TextBlock Text="📌 Ghim Widget Halloween Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#F97316"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 5. WIDGET MÙA XUÂN (SPRING BLOOM) -->
                        <Border x:Name="CardSeasonalSpring" Grid.Row="2" Grid.Column="0"
                                Tag="Spring" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#50EC4899" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🌸" FontSize="13"/>
                                        <TextBlock Text="Mùa Xuân (Spring)" FontWeight="Bold" FontSize="13.5" Foreground="#FBCFE8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalSpring" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#25EC4899" BorderBrush="#50EC4899" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Chồi Non" FontSize="10" FontWeight="Bold" Foreground="#FBCFE8"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Height="105" CornerRadius="12" BorderBrush="#60EC4899" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0210A1A" Offset="0"/>
                                            <GradientStop Color="#F0331028" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Padding="14,10">
                                        <!-- Họa tiết Mùa Xuân: Nhành hoa đào & Chồi non -->
                                        <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" Width="100" Height="85">
                                            <Path Data="M 100,8 C 75,12 55,26 35,48" Stroke="#78350F" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
                                            <Ellipse Canvas.Left="40" Canvas.Top="38" Width="12" Height="12" Fill="#F472B6" Opacity="0.8"/>
                                            <Ellipse Canvas.Left="44" Canvas.Top="42" Width="4" Height="4" Fill="#FACC15"/>
                                        </Canvas>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Xuân Tươi Mới • Vạn Vật Hồi Sinh" FontSize="10" FontWeight="SemiBold" Foreground="#F472B6"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06c;" Foreground="#EC4899" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="Spring" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#20EC4899" BorderBrush="#50EC4899" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#EC4899"/>
                                        <TextBlock Text="📌 Ghim Widget Mùa Xuân Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#EC4899"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 6. WIDGET MÙA HẠ (TROPICAL OASIS) -->
                        <Border x:Name="CardSeasonalSummer" Grid.Row="2" Grid.Column="1"
                                Tag="Summer" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#500EA5E9" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="☀️" FontSize="13"/>
                                        <TextBlock Text="Mùa Hạ (Summer)" FontWeight="Bold" FontSize="13.5" Foreground="#7DD3FC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalSummer" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#250EA5E9" BorderBrush="#500EA5E9" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Biển Ngọc" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Height="105" CornerRadius="12" BorderBrush="#600EA5E9" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0091825" Offset="0"/>
                                            <GradientStop Color="#F00F293F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Padding="14,10">
                                        <!-- Họa tiết Mùa Hạ: Mặt trời rực rỡ & Sóng biển ngọc -->
                                        <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" Width="100" Height="85">
                                            <Ellipse Canvas.Left="45" Canvas.Top="10" Width="36" Height="36" Fill="#F59E0B" Stroke="#FDE047" StrokeThickness="1.2" Opacity="0.85"/>
                                            <Path Data="M 10,75 Q 40,65 70,75 Q 85,70 100,72 L 100,85 L 10,85 Z" Fill="#06B6D4" Opacity="0.5"/>
                                        </Canvas>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Nắng Hạ Rực Rỡ • Năng Lượng Đầy Tràn" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="Summer" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#200EA5E9" BorderBrush="#500EA5E9" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#0EA5E9"/>
                                        <TextBlock Text="📌 Ghim Widget Mùa Hạ Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#0EA5E9"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 7. WIDGET MÙA THU (AMBER ROMANCE) -->
                        <Border x:Name="CardSeasonalAutumn" Grid.Row="3" Grid.Column="0"
                                Tag="Autumn" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#50D97706" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🍁" FontSize="13"/>
                                        <TextBlock Text="Mùa Thu (Autumn)" FontWeight="Bold" FontSize="13.5" Foreground="#FDE68A"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalAutumn" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#25D97706" BorderBrush="#50D97706" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Hổ Phách" FontSize="10" FontWeight="Bold" Foreground="#FDE68A"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Height="105" CornerRadius="12" BorderBrush="#60D97706" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0241407" Offset="0"/>
                                            <GradientStop Color="#F0381E0A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Padding="14,10">
                                        <!-- Họa tiết Mùa Thu: Cặp lá phong đỏ cam -->
                                        <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" Width="100" Height="85">
                                            <Path Data="M 65,30 L 65,22 C 60,22 53,17 56,12 C 59,6 63,10 65,13 C 67,10 71,6 74,12 C 77,17 70,22 65,22 Z" Fill="#DC2626" Stroke="#FDE047" StrokeThickness="0.8" Opacity="0.85"/>
                                            <Path Data="M 40,48 L 40,42 C 36,42 30,38 32,34 C 34,29 38,32 40,35 C 42,32 46,29 48,34 C 50,38 44,42 40,42 Z" Fill="#EA580C" Stroke="#FDE047" StrokeThickness="0.8" Opacity="0.8"/>
                                        </Canvas>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Mùa Thu Êm Ả • Gió Mát Trong Lành" FontSize="10" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06c;" Foreground="#D97706" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="Autumn" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#20D97706" BorderBrush="#50D97706" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#D97706"/>
                                        <TextBlock Text="📌 Ghim Widget Mùa Thu Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 8. WIDGET MÙA ĐÔNG (NORDIC AURORA) -->
                        <Border x:Name="CardSeasonalWinter" Grid.Row="3" Grid.Column="1"
                                Tag="Winter" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#50818CF8" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="❄️" FontSize="13"/>
                                        <TextBlock Text="Mùa Đông (Winter)" FontWeight="Bold" FontSize="13.5" Foreground="#BAE6FD"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalWinter" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#25818CF8" BorderBrush="#50818CF8" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Bắc Cực" FontSize="10" FontWeight="Bold" Foreground="#C7D2FE"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Height="105" CornerRadius="12" BorderBrush="#60818CF8" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F00A1328" Offset="0"/>
                                            <GradientStop Color="#F0132247" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Padding="14,10">
                                        <!-- Họa tiết Mùa Đông: Thạch nhũ băng giá & Tinh thể tuyết -->
                                        <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" Width="100" Height="85">
                                            <Path Data="M 20,0 L 25,12 L 30,0 L 38,18 L 45,0 L 55,14 L 65,0 L 80,20 L 90,0 L 100,16 L 100,0 Z" Fill="#BAE6FD" Opacity="0.65"/>
                                            <Path Data="M 65,40 L 65,70 M 52,48 L 78,62 M 52,62 L 78,48" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"/>
                                        </Canvas>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Mùa Đông An Yên • Không Khí Trong Lành" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2dc;" Foreground="#818CF8" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="Winter" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#20818CF8" BorderBrush="#50818CF8" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#818CF8"/>
                                        <TextBlock Text="📌 Ghim Widget Mùa Đông Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#818CF8"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== ĐIỀU KHIỂN & TÙY BIẾN WIDGET ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioControlsHeader, Mode=OneWay}" FontSize="15" FontWeight="Bold"/>

                    <!-- Hàng 1: Kiểu Dáng & Độ Trong Suốt -->
                    <Grid x:Name="ControlsGrid" ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioStyleLabel, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"/>
                            <ComboBox x:Name="StudioWidgetStyleComboBox" SelectionChanged="WidgetStyleComboBox_SelectionChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="✨ Bryan C Dynamic" Tag="BryanCDynamic"/>
                                <ComboBoxItem Content="🪟 Fluent Glass Card" Tag="GlassCard"/>
                                <ComboBoxItem Content="➖ Compact Bar" Tag="Compact"/>
                                <ComboBoxItem Content="💊 Dynamic Island Pill" Tag="MiniIsland"/>
                                <ComboBoxItem Content="🎆 Seasonal Festival Card" Tag="SeasonalCard"/>
                                <ComboBoxItem Content="&#x1F371; Bento Pop (Vivid Sky)" Tag="BentoVivid"/>
                                <ComboBoxItem Content="&#x1F9ED; Bento Pilot (Tactical Slate)" Tag="BentoTactical"/>
                                <ComboBoxItem Content="&#x1F4DF; Retro Cyber LCD Computer" Tag="RetroLcd"/>
                                <ComboBoxItem Content="&#x26AB; Nothing Bento (Capsule 2:1)" Tag="NothingBento"/>
                                <ComboBoxItem Content="&#x25FD; Nothing Square (Minimal 1:1)" Tag="NothingSquare"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Loc.WidgetStudioOpacityLabel, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" x:Name="OpacityValueText" Text="100%" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            </Grid>
                            <Slider x:Name="StudioOpacitySlider" Minimum="20" Maximum="100" StepFrequency="5" Value="100" ValueChanged="WidgetOpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 2: Always on Top Toggle -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioAlwaysOnTop, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioAlwaysOnTopSub, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="AlwaysOnTopSwitch" OnContent="" OffContent="" IsOn="True" Toggled="AlwaysOnTopSwitch_Toggled" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Hàng 3: Các Nút Thao Tác (Responsive Wrap) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Click="OpenCurrentCityWidget_Click" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10" Padding="16,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioPinCurrentBtn, Mode=OneWay}" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OpenCustomCityWidget_Click" CornerRadius="10" Padding="14,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioOpenOtherBtn, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <Button Click="CloseAllWidgets_Click" CornerRadius="10" Padding="14,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioCloseAllBtn, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
