<UserControl
    x:Class="WeatherApp.Views.Tabs.WidgetStudioTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" Padding="0,0,16,24">
                        <!-- HEADER TIÊU ĐỀ STUDIO -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="#2038BDF8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" Foreground="#38BDF8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Studio Thiết Kế Desktop Widget (Bộ Sưu Tập Trực Quan)" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Chọn kiểu dáng trực quan, tinh chỉnh độ mờ Acrylic và ghim ra màn hình Desktop" FontSize="11.5" Opacity="0.65"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="8" Padding="12,5">
                                        <TextBlock Text="WinUI 3 Glass Studio" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BỘ SƯU TẬP 4 KIỂU DÁNG WIDGET TRỰC QUAN (VISUAL GALLERY MOCKUPS) -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <!-- 1. BRYAN C DYNAMIC CARD -->
                            <Border x:Name="CardWidgetBryanC" Grid.Row="0" Grid.Column="0"
                                    PointerPressed="CardWidgetBryanC_PointerPressed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="✨ Bryan C Dynamic" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeWidgetBryanC" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="Đang chọn" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Mockup Box -->
                                    <Border Height="140" CornerRadius="12" BorderBrush="#30FFFFFF" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F20F172A" Offset="0"/>
                                                <GradientStop Color="#F21E293B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Padding="14,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="13"/>
                                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="11" Opacity="0.8" Foreground="White"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="Dự Báo 4 Ngày" FontSize="9.5" Opacity="0.6" Foreground="White" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border VerticalAlignment="Bottom" Background="#2E000000" CornerRadius="8" Padding="6,4">
                                                <Grid ColumnDefinitions="*,*,*,*">
                                                    <TextBlock Grid.Column="0" Text="T2 • 28°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="T3 • 29°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="T4 • 27°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="T5 • 30°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Tự động biến đổi nền bầu trời, hình học mặt trời &amp; vầng trăng theo điều kiện thực tế" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. GLASS CARD (THẺ KÍNH MỜ ACRYLIC) -->
                            <Border x:Name="CardWidgetGlassCard" Grid.Row="0" Grid.Column="1"
                                    PointerPressed="CardWidgetGlassCard_PointerPressed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🪟 Fluent Glass Card" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeWidgetGlassCard" Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <TextBlock Text="Đang chọn" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Mockup Box -->
                                    <Border Height="140" CornerRadius="12" Background="#351E293B" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="14,10">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="38" Height="38" CornerRadius="10" Background="#2038BDF8">
                                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" Foreground="#38BDF8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="6" Padding="4,2">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="6" Padding="4,2">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" Background="#20FFFFFF" CornerRadius="6" Padding="4,2">
                                                    <TextBlock Text="AQI Chuẩn" FontSize="9.5" Foreground="#10B981" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Thẻ kính mờ hiệu ứng Mica/Acrylic đầy đủ chi tiết độ ẩm, gió và chất lượng không khí" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. COMPACT BAR (THANH NGANG) -->
                            <Border x:Name="CardWidgetCompact" Grid.Row="1" Grid.Column="0"
                                    PointerPressed="CardWidgetCompact_PointerPressed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="➖ Compact Bar" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeWidgetCompact" Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <TextBlock Text="Đang chọn" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Mockup Box -->
                                    <Border Height="140" CornerRadius="12" Background="#150F172A" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                                        <Border Height="48" CornerRadius="12" Background="#600F172A" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                                <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="15" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="11" Opacity="0.7" Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Thanh ngang dài thanh mảnh, chiếm diện tích tối thiểu, đặt sát góc trên màn hình" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. DYNAMIC ISLAND PILL (VIÊN THUỐC NỔI) -->
                            <Border x:Name="CardWidgetMiniIsland" Grid.Row="1" Grid.Column="1"
                                    PointerPressed="CardWidgetMiniIsland_PointerPressed"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="💊 Dynamic Island Pill" FontWeight="Bold" FontSize="14"/>
                                        </StackPanel>
                                        <Border x:Name="BadgeWidgetMiniIsland" Grid.Column="1" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                            <TextBlock Text="Đang chọn" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Mockup Box -->
                                    <Border Height="140" CornerRadius="12" Background="#150F172A" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                                        <Border Height="44" CornerRadius="22" Background="#E80F172A" BorderBrush="#6038BDF8" BorderThickness="1.5" Padding="14,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c2;" Foreground="#38BDF8" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                <Border Background="#2538BDF8" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Viên thuốc bo tròn tinh tế, tối giản sang trọng, luôn nổi nhẹ nhàng trên màn hình" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ĐIỀU KHIỂN & TÙY BIẾN ĐỘ TRONG SUỐT -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Danh sách kiểu dáng Widget:" FontSize="13" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="StudioWidgetStyleComboBox" SelectionChanged="WidgetStyleComboBox_SelectionChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                                            <ComboBoxItem Content="✨ Bryan C Dynamic (Tự đổi màu)" Tag="BryanCDynamic"/>
                                            <ComboBoxItem Content="🪟 Fluent Glass Card (Thẻ kính mờ)" Tag="GlassCard"/>
                                            <ComboBoxItem Content="➖ Compact Bar (Thanh ngang gọn)" Tag="Compact"/>
                                            <ComboBoxItem Content="💊 Dynamic Island Pill (Viên thuốc nổi)" Tag="MiniIsland"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Độ trong suốt Widget (Opacity):" FontSize="13" FontWeight="SemiBold"/>
                                        <Slider x:Name="StudioOpacitySlider" Minimum="20" Maximum="100" StepFrequency="5" Value="100" ValueChanged="WidgetOpacitySlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <Button Click="OpenCurrentCityWidget_Click" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="12"/>
                                            <TextBlock Text="📌 Ghim Ngay Lên Desktop" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenCustomCityWidget_Click" CornerRadius="10" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf067;" FontSize="12"/>
                                            <TextBlock Text="➕ Mở Thêm Thành Phố Khác..."/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="CloseAllWidgets_Click" CornerRadius="10" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf00d;" FontSize="12"/>
                                            <TextBlock Text="❌ Đóng Tất Cả Widget"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
    </ScrollViewer>
</UserControl>
