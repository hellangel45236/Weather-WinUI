<UserControl
    x:Class="WeatherApp.Views.Tabs.WidgetStudioTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WeatherApp.ViewModels"
    xmlns:models="using:WeatherApp.Models"
    mc:Ignorable="d">

    <ScrollViewer x:Name="WidgetScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="0,0,16,24">
            <!-- ==================== HEADER TIÊU ĐỀ STUDIO ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#2038BDF8">
                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf2d0;" Foreground="#38BDF8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioHeader, Mode=OneWay}" FontSize="16.5" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioSub, Mode=OneWay}" FontSize="11.5" Opacity="0.68" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2038BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioBadge, Mode=OneWay}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== BỘ SƯU TẬP 4 KIỂU DÁNG WIDGET TRỰC QUAN ==================== -->
            <Grid x:Name="GalleryGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <!-- 1. BRYAN C DYNAMIC CARD -->
                <Border x:Name="CardWidgetBryanC" Grid.Row="0" Grid.Column="0"
                        PointerPressed="CardWidgetBryanC_PointerPressed"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="16"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioBryanCTitle, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <Border x:Name="BadgeWidgetBryanC" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioSelected, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>

                        <!-- Mockup Box -->
                        <Border Height="148" CornerRadius="14" BorderBrush="#30FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F20F172A" Offset="0"/>
                                    <GradientStop Color="#F21E293B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Padding="14,10">
                                <!-- Background Art Elements -->
                                <Canvas IsHitTestVisible="False" Opacity="0.4">
                                    <Ellipse Width="110" Height="110" Canvas.Left="190" Canvas.Top="-35" Stroke="#30FFFFFF" StrokeThickness="16" Fill="#0DFFFFFF"/>
                                    <Ellipse Width="60" Height="60" Canvas.Left="225" Canvas.Top="0" Fill="#20FFFFFF"/>
                                </Canvas>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="13"/>
                                            <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="34" FontWeight="Bold" Foreground="White" Margin="0,-2,0,0"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="11" Opacity="0.85" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudio4DayForecast, Mode=OneWay}" FontSize="9.5" Opacity="0.6" Foreground="White" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Border VerticalAlignment="Bottom" Background="#3A000000" CornerRadius="8" Padding="6,4">
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <TextBlock Grid.Column="0" Text="T2 • 28°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="T3 • 29°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="T4 • 27°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="T5 • 30°" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioBryanCDesc, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- 2. GLASS CARD (THẺ KÍNH MỜ ACRYLIC) -->
                <Border x:Name="CardWidgetGlassCard" Grid.Row="0" Grid.Column="1"
                        PointerPressed="CardWidgetGlassCard_PointerPressed"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioGlassTitle, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <Border x:Name="BadgeWidgetGlassCard" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioSelected, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>

                        <!-- Mockup Box -->
                        <Border Height="148" CornerRadius="14" Background="#351E293B" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="14,10">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#2038BDF8">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf6c4;" Foreground="#38BDF8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.ConditionText, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                    <Border Grid.Column="0" Background="#20FFFFFF" CornerRadius="6" Padding="4,3">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.HumidityText, Mode=OneWay}" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#20FFFFFF" CornerRadius="6" Padding="4,3">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.WindText, Mode=OneWay}" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#20FFFFFF" CornerRadius="6" Padding="4,3">
                                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioAqiGood, Mode=OneWay}" FontSize="9.5" Foreground="#10B981" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioGlassDesc, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- 3. COMPACT BAR (THANH NGANG) -->
                <Border x:Name="CardWidgetCompact" Grid.Row="1" Grid.Column="0"
                        PointerPressed="CardWidgetCompact_PointerPressed"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioCompactTitle, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <Border x:Name="BadgeWidgetCompact" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioSelected, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>

                        <!-- Mockup Box -->
                        <Border Height="148" CornerRadius="14" Background="#150F172A" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                            <Border Height="48" CornerRadius="12" Background="#600F172A" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf185;" Foreground="#F59E0B" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.CurrentTimeDisplay, Mode=OneWay}" FontSize="11" Opacity="0.7" Foreground="White" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioCompactDesc, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- 4. DYNAMIC ISLAND PILL (VIÊN THUỐC NỔI) -->
                <Border x:Name="CardWidgetMiniIsland" Grid.Row="1" Grid.Column="1"
                        PointerPressed="CardWidgetMiniIsland_PointerPressed"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioIslandTitle, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <Border x:Name="BadgeWidgetMiniIsland" Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioSelected, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>

                        <!-- Mockup Box -->
                        <Border Height="148" CornerRadius="14" Background="#150F172A" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                            <Border Height="44" CornerRadius="22" Background="#E80F172A" BorderBrush="#6038BDF8" BorderThickness="1.5" Padding="14,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf0c2;" Foreground="#38BDF8" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                    <Border Background="#2538BDF8" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.Loc.WidgetStudioIslandDesc, Mode=OneWay}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== BỘ SƯU TẬP WIDGET THEO MÙA & ĐẠI LỄ HỘI (v3.3.0) ==================== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf005;" Foreground="#F59E0B" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="BỘ SƯU TẬP WIDGET 4 MÙA &amp; 4 ĐẠI LỄ HỘI" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="Các kiểu dáng widget chuyên đề độc bản đồng bộ với chủ đề khí quyển và lễ hội truyền thống" FontSize="11.5" Opacity="0.7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#20F59E0B" BorderBrush="#40F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentSeasonalSkin.DisplayName, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                            </Border>
                            <Button Click="PinCurrentSeasonalWidget_Click"
                                    Background="#2538BDF8" BorderBrush="#6038BDF8" BorderThickness="1"
                                    CornerRadius="8" Padding="10,5"
                                    ToolTipService.ToolTip="Ghim ngay Widget mang chủ đề thời vụ / lễ hội đang chọn ra màn hình Desktop">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock Text="Ghim Mùa Này" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Lưới 8 Thẻ Widget Mùa & Lễ Hội (2 Cột x 4 Hàng) -->
                    <Grid x:Name="SeasonalGalleryGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                        
                        <!-- 1. WIDGET TẾT CỔ TRUYỀN (HOÀNG KIM CÁT TƯỜNG) -->
                        <Border x:Name="CardSeasonalTet" Grid.Row="0" Grid.Column="0"
                                Tag="Tet" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#50F59E0B" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🧧" FontSize="13"/>
                                        <TextBlock Text="Tết Cổ Truyền" FontWeight="Bold" FontSize="13.5" Foreground="#FDA4AF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalTet" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#25E11D48" BorderBrush="#50E11D48" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Hoàng Kim" FontSize="10" FontWeight="Bold" Foreground="#FDA4AF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- Mockup Tết -->
                                <Border Height="105" CornerRadius="12" BorderBrush="#60F59E0B" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F02A0914" Offset="0"/>
                                            <GradientStop Color="#F03F0E1E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Padding="14,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Chúc Mừng Năm Mới • Vạn Sự Như Ý" FontSize="10" FontWeight="SemiBold" Foreground="#FDE047"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf06b;" Foreground="#F59E0B" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="Tet" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#20F59E0B" BorderBrush="#50F59E0B" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#F59E0B"/>
                                        <TextBlock Text="📌 Ghim Widget Tết Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 2. WIDGET TẾT TRUNG THU (DẠ NGUYỆT ĐOÀN VIÊN) -->
                        <Border x:Name="CardSeasonalMidAutumn" Grid.Row="0" Grid.Column="1"
                                Tag="MidAutumn" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#50FDE047" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🥮" FontSize="13"/>
                                        <TextBlock Text="Tết Trung Thu" FontWeight="Bold" FontSize="13.5" Foreground="#FDE047"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalMidAutumn" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#256366F1" BorderBrush="#506366F1" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Dạ Nguyệt" FontSize="10" FontWeight="Bold" Foreground="#C7D2FE"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- Mockup Trung Thu -->
                                <Border Height="105" CornerRadius="12" BorderBrush="#60FDE047" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0110E2A" Offset="0"/>
                                            <GradientStop Color="#F01E174A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Padding="14,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Đêm Hội Trăng Rằm • Đoàn Viên Cát Lành" FontSize="10" FontWeight="SemiBold" Foreground="#FDE047"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.TemperatureText, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{x:Bind ViewModel.CurrentWeather.LocationName, Mode=OneWay}" FontSize="10.5" Opacity="0.8" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf186;" Foreground="#FDE047" FontSize="26" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <!-- Nút Ghim Thẻ Mùa -->
                                <Button Tag="MidAutumn" Click="PinSeasonalWidget_Click" HorizontalAlignment="Stretch" Padding="8,4" CornerRadius="8" Background="#20FDE047" BorderBrush="#50FDE047" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource FontAwesomeSolid}" Glyph="&#xf08d;" FontSize="10" Foreground="#FDE047"/>
                                        <TextBlock Text="📌 Ghim Widget Trung Thu Ra Desktop" FontSize="11" FontWeight="SemiBold" Foreground="#FDE047"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 3. WIDGET GIÁNG SINH & NĂM MỚI (NOEL WONDER) -->
                        <Border x:Name="CardSeasonalChristmas" Grid.Row="1" Grid.Column="0"
                                Tag="Christmas" PointerPressed="SeasonalWidgetCard_PointerPressed"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#5022C55E" BorderThickness="1.5" CornerRadius="16" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🎄" FontSize="13"/>
                                        <TextBlock Text="Giáng Sinh &amp; Năm Mới" FontWeight="Bold" FontSize="13.5" Foreground="#86EFAC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalChristmas" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#25DC2626" BorderBrush="#50DC2626" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Noel Frozen" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- Mockup Giáng Sinh -->
                                <Border Height="105" CornerRadius="12" BorderBrush="#6038BDF8" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
