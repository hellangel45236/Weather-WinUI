                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🎃" FontSize="13"/>
                                        <TextBlock Text="Lễ Hội Halloween" FontWeight="Bold" FontSize="13.5" Foreground="#FDBA74"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="BadgeSeasonalHalloween" Background="#3510B981" BorderBrush="#6010B981" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="ĐANG CHỌN" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <Border Background="#25F97316" BorderBrush="#50F97316" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock Text="Midnight" FontSize="10" FontWeight="Bold" Foreground="#FDBA74"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- Mockup Halloween -->
